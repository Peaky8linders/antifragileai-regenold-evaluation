@prefix : <https://w3id.org/codexai#> .
@prefix codexai: <https://w3id.org/codexai#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix vair: <https://w3id.org/vair#> .
@prefix eu-aiact: <https://w3id.org/dpv/legal/eu/aiact#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix tech: <https://w3id.org/dpv/tech#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix mitre-atlas: <https://atlas.mitre.org/techniques/> .
# NOTE: latticeflow: prefix declaration was here in v1.0 of the
# LatticeFlow ATLAS Article 15 integration but went unused in any
# triple — the controls were emitted under the codexai: prefix as
# codexai:LF_C_1_X individuals. Removed in the round-3 cleanup.

# =============================================================================
# CodexAI Compliance Implementation Ontology
#
# Extends:
#   - AIRO (AI Risk Ontology) — https://w3id.org/airo
#   - VAIR (Vocabulary of AI Risks) — https://w3id.org/vair
#   - W3C DPV EU-AIAct Extension — https://w3id.org/dpv/legal/eu/aiact
#
# Purpose:
#   The implementation layer that AIRO/VAIR/DPV-AIAct don't provide.
#   These ontologies model WHAT the regulation says.
#   CodexAI models HOW to comply: obligations, controls, evidence,
#   gaps, migration tasks, and their dependencies.
#
# License: Apache 2.0
# =============================================================================

<https://w3id.org/codexai> rdf:type owl:Ontology ;
    owl:versionIRI <https://w3id.org/codexai/1.0> ;
    owl:imports <https://w3id.org/airo> ;
    dct:title "CodexAI Compliance Implementation Ontology"@en ;
    dct:description """
        An ontology for operationalizing EU AI Act compliance.
        Extends AIRO (AI Risk Ontology), VAIR (Vocabulary of AI Risks),
        and the W3C DPV EU-AIAct extension with implementation concepts:
        obligations, controls, evidence chains, compliance gaps,
        migration tasks, and assessment dimensions.

        While AIRO/VAIR model AI risks and the DPV extension models
        regulatory concepts, CodexAI models the engineering implementation
        path from non-compliant to compliant.
    """@en ;
    dct:creator "CodexAI / Legit AI" ;
    dct:created "2026-03-29"^^xsd:date ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <http://data.europa.eu/eli/reg/2024/1689/oj> ;
    vann:preferredNamespacePrefix "codexai" ;
    vann:preferredNamespaceUri "https://w3id.org/codexai#" ;
    rdfs:label "CodexAI Compliance Implementation Ontology"@en ;
    rdfs:seeAlso <https://w3id.org/airo> ,
                 <https://w3id.org/vair> ,
                 <https://w3id.org/dpv/legal/eu/aiact> ;
    owl:versionInfo "1.0"@en .


# =============================================================================
# CLASSES — Compliance Implementation Layer
# These classes DO NOT duplicate AIRO/VAIR/DPV-AIAct.
# They extend them with operational compliance concepts.
# =============================================================================

# --- Regulatory Structure ---

codexai:Article rdf:type owl:Class ;
    rdfs:label "Article"@en ;
    rdfs:comment """A numbered article in EU Regulation 2024/1689.
        Articles impose obligations on actors in the AI value chain.
        This is the normative source that AIRO/VAIR reference but don't
        model as first-class entities with obligation decomposition."""@en ;
    skos:prefLabel "Article"@en .

codexai:Chapter rdf:type owl:Class ;
    rdfs:label "Chapter"@en ;
    rdfs:comment "A chapter grouping related articles in the AI Act."@en ;
    skos:prefLabel "Chapter"@en .

codexai:Annex rdf:type owl:Class ;
    rdfs:label "Annex"@en ;
    rdfs:comment """An annex to the regulation (I through XIII).
        Annex III lists high-risk AI system use cases (modeled by VAIR domains).
        Annex IV specifies technical documentation requirements.
        Annex XII defines post-market monitoring content."""@en ;
    skos:prefLabel "Annex"@en .

codexai:Recital rdf:type owl:Class ;
    rdfs:label "Recital"@en ;
    rdfs:comment "Interpretive guidance for articles."@en ;
    skos:prefLabel "Recital"@en .

# --- Obligation Layer (NEW — not in AIRO/VAIR/DPV) ---

codexai:Obligation rdf:type owl:Class ;
    rdfs:label "Obligation"@en ;
    rdfs:comment """A specific legal requirement imposed by an article.
        An article may impose multiple obligations with different scopes.
        This is the granularity level needed for compliance engineering —
        AIRO models risks, but not the individual obligations that must
        be satisfied to manage those risks."""@en ;
    skos:prefLabel "Obligation"@en .

codexai:Control rdf:type owl:Class ;
    rdfs:subClassOf airo:RiskControl ;
    rdfs:label "Control"@en ;
    rdfs:comment """A technical or organizational measure that satisfies an obligation.
        Extends airo:RiskControl with obligation-level traceability.
        Example: 'Implement human-in-the-loop gate before automated decisions'
        satisfies obligation under Art. 14."""@en ;
    skos:prefLabel "Control"@en .

codexai:EvidenceType rdf:type owl:Class ;
    rdfs:label "Evidence Type"@en ;
    rdfs:comment """A category of evidence that demonstrates a control is implemented.
        Examples: test report, audit log, architecture diagram,
        bias evaluation result, data lineage record."""@en ;
    skos:prefLabel "Evidence Type"@en .

codexai:Evidence rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Evidence"@en ;
    rdfs:comment """A specific piece of compliance evidence produced by or about
        an AI system. Linked to the obligation it supports, the system
        it covers, and the tamper-evident hash chain from CodexAI.
        Extends prov:Entity for W3C PROV-O provenance compatibility."""@en ;
    skos:prefLabel "Evidence"@en .

codexai:ComplianceActivity rdf:type owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Compliance Activity"@en ;
    rdfs:comment """A recorded compliance activity from the CodexAI evidence chain.
        Extends prov:Activity for W3C PROV-O provenance compatibility.
        Every EvidenceEntry is serialized as an instance of this class
        (or one of its subclasses) when exported via PROV-O runtime emission."""@en ;
    skos:prefLabel "Compliance Activity"@en .

codexai:LLMDecision rdf:type owl:Class ;
    rdfs:subClassOf codexai:ComplianceActivity ;
    rdfs:label "LLM Decision"@en ;
    rdfs:comment """An Article 14 decision intercept — the moment a governed
        AI system evaluated a prompt and returned approve, block, or escalate.
        Links to the prompt entity it used and the outcome it generated."""@en ;
    skos:prefLabel "LLM Decision"@en .

codexai:DecisionOverride rdf:type owl:Class ;
    rdfs:subClassOf codexai:ComplianceActivity ;
    rdfs:label "Decision Override"@en ;
    rdfs:comment """A human override of an earlier LLM decision.
        Informed by the original decision via prov:wasInformedBy.
        Establishes the Article 14 human-in-the-loop audit trail."""@en ;
    skos:prefLabel "Decision Override"@en .

# --- Assessment Layer (extends CodexAI kb.py into ontology) ---

codexai:ComplianceDimension rdf:type owl:Class ;
    rdfs:label "Compliance Dimension"@en ;
    rdfs:comment """A measurable aspect of compliance maturity.
        Maps to CodexAI's 15 assessment dimensions.
        Each dimension measures conformity with one or more obligations."""@en ;
    skos:prefLabel "Compliance Dimension"@en .

codexai:AssessmentQuestion rdf:type owl:Class ;
    rdfs:label "Assessment Question"@en ;
    rdfs:comment """A specific question used to evaluate maturity within
        a compliance dimension. Maps to CodexAI's 75 assessment questions."""@en ;
    skos:prefLabel "Assessment Question"@en .

# --- Gap & Remediation Layer (NEW — operational compliance) ---

codexai:ComplianceGap rdf:type owl:Class ;
    rdfs:label "Compliance Gap"@en ;
    rdfs:comment """An identified deficiency where an obligation is not met.
        Has effort estimate, priority, and dependency relationships
        to other gaps. This is the operational output of gap analysis."""@en ;
    skos:prefLabel "Compliance Gap"@en .

codexai:MigrationTask rdf:type owl:Class ;
    rdfs:label "Migration Task"@en ;
    rdfs:comment """An engineering task that addresses a compliance gap.
        Part of a phased roadmap with dependency ordering.
        Carries agent-executable I/O contracts for automation."""@en ;
    skos:prefLabel "Migration Task"@en .

# --- Conformity & Enforcement (extends DPV-AIAct) ---

codexai:Deadline rdf:type owl:Class ;
    rdfs:label "Enforcement Deadline"@en ;
    rdfs:comment """A regulatory deadline for compliance per Art. 113."""@en ;
    skos:prefLabel "Enforcement Deadline"@en .

codexai:Penalty rdf:type owl:Class ;
    rdfs:label "Penalty"@en ;
    rdfs:comment """A penalty provision for non-compliance per Art. 99."""@en ;
    skos:prefLabel "Penalty"@en .


# =============================================================================
# OBJECT PROPERTIES — Compliance Relationships
# =============================================================================

# --- Article → Obligation relationships ---

codexai:imposes rdf:type owl:ObjectProperty ;
    rdfs:label "imposes"@en ;
    rdfs:comment "An article imposes one or more obligations."@en ;
    rdfs:domain codexai:Article ;
    rdfs:range codexai:Obligation .

codexai:crossReferences rdf:type owl:ObjectProperty ;
    rdfs:label "cross-references"@en ;
    rdfs:comment "An article references another article."@en ;
    rdfs:domain codexai:Article ;
    rdfs:range codexai:Article .

codexai:belongsToChapter rdf:type owl:ObjectProperty ;
    rdfs:label "belongs to chapter"@en ;
    rdfs:domain codexai:Article ;
    rdfs:range codexai:Chapter .

codexai:detailedIn rdf:type owl:ObjectProperty ;
    rdfs:label "detailed in"@en ;
    rdfs:comment "Requirements detailed in an annex."@en ;
    rdfs:domain codexai:Article ;
    rdfs:range codexai:Annex .

# --- Obligation relationships ---

codexai:requiresControl rdf:type owl:ObjectProperty ;
    rdfs:label "requires control"@en ;
    rdfs:domain codexai:Obligation ;
    rdfs:range codexai:Control .

codexai:appliesToRiskTier rdf:type owl:ObjectProperty ;
    rdfs:label "applies to risk tier"@en ;
    rdfs:comment "Links to eu-aiact risk level concepts."@en ;
    rdfs:domain codexai:Obligation .

codexai:scopedToRole rdf:type owl:ObjectProperty ;
    rdfs:label "scoped to role"@en ;
    rdfs:comment """Links to eu-aiact/airo role concepts:
        eu-aiact:AIProvider, eu-aiact:AIDeployer, etc."""@en ;
    rdfs:domain codexai:Obligation .

codexai:dependsOn rdf:type owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:comment """One obligation depends on another being satisfied first.
        Example: Art. 10 data governance depends on Art. 9 risk management."""@en ;
    rdfs:domain codexai:Obligation ;
    rdfs:range codexai:Obligation .

# --- Control and Evidence relationships ---

codexai:evidencedBy rdf:type owl:ObjectProperty ;
    rdfs:label "evidenced by"@en ;
    rdfs:domain codexai:Control ;
    rdfs:range codexai:EvidenceType .

codexai:supportsObligation rdf:type owl:ObjectProperty ;
    rdfs:label "supports obligation"@en ;
    rdfs:domain codexai:Evidence ;
    rdfs:range codexai:Obligation .

codexai:satisfiesControl rdf:type owl:ObjectProperty ;
    rdfs:label "satisfies control"@en ;
    rdfs:domain codexai:Evidence ;
    rdfs:range codexai:Control .

codexai:producedBy rdf:type owl:ObjectProperty ;
    rdfs:label "produced by"@en ;
    rdfs:comment "Links to airo:AISystem."@en ;
    rdfs:domain codexai:Evidence ;
    rdfs:range airo:AISystem .

# --- Assessment relationships ---

codexai:measures rdf:type owl:ObjectProperty ;
    rdfs:label "measures"@en ;
    rdfs:domain codexai:ComplianceDimension ;
    rdfs:range codexai:Obligation .

codexai:evaluates rdf:type owl:ObjectProperty ;
    rdfs:label "evaluates"@en ;
    rdfs:domain codexai:AssessmentQuestion ;
    rdfs:range codexai:ComplianceDimension .

# --- Gap and Task relationships ---

codexai:identifiesGapFor rdf:type owl:ObjectProperty ;
    rdfs:label "identifies gap for"@en ;
    rdfs:domain codexai:ComplianceGap ;
    rdfs:range codexai:Obligation .

codexai:addressedBy rdf:type owl:ObjectProperty ;
    rdfs:label "addressed by"@en ;
    rdfs:domain codexai:ComplianceGap ;
    rdfs:range codexai:MigrationTask .

codexai:blocks rdf:type owl:ObjectProperty ;
    rdfs:label "blocks"@en ;
    rdfs:comment "One task must be completed before another can start."@en ;
    rdfs:domain codexai:MigrationTask ;
    rdfs:range codexai:MigrationTask .

codexai:satisfies rdf:type owl:ObjectProperty ;
    rdfs:label "satisfies"@en ;
    rdfs:domain codexai:MigrationTask ;
    rdfs:range codexai:Obligation .

# --- System relationships (linking to AIRO) ---

codexai:classifiedAs rdf:type owl:ObjectProperty ;
    rdfs:label "classified as"@en ;
    rdfs:domain airo:AISystem .

codexai:operatesInDomain rdf:type owl:ObjectProperty ;
    rdfs:label "operates in domain"@en ;
    rdfs:comment "Links airo:AISystem to airo:Domain (Annex III sectors)."@en ;
    rdfs:domain airo:AISystem ;
    rdfs:range airo:Domain .

# --- Enforcement relationships ---

codexai:enforcedBy rdf:type owl:ObjectProperty ;
    rdfs:label "enforced by"@en ;
    rdfs:domain codexai:Obligation ;
    rdfs:range codexai:Deadline .

codexai:penalizedUnder rdf:type owl:ObjectProperty ;
    rdfs:label "penalized under"@en ;
    rdfs:domain codexai:Obligation ;
    rdfs:range codexai:Penalty .

# --- Standard conformity (linking to AIRO) ---

codexai:referencesStandard rdf:type owl:ObjectProperty ;
    rdfs:label "references standard"@en ;
    rdfs:comment "Links to airo:Standard."@en ;
    rdfs:domain codexai:Control ;
    rdfs:range airo:Standard .

codexai:presumesConformityWith rdf:type owl:ObjectProperty ;
    rdfs:label "presumes conformity with"@en ;
    rdfs:domain airo:Standard ;
    rdfs:range codexai:Obligation .


# =============================================================================
# DATATYPE PROPERTIES
# =============================================================================

codexai:articleNumber rdf:type owl:DatatypeProperty ;
    rdfs:label "article number"@en ;
    rdfs:domain codexai:Article ;
    rdfs:range xsd:string .

codexai:articleTitle rdf:type owl:DatatypeProperty ;
    rdfs:label "article title"@en ;
    rdfs:domain codexai:Article ;
    rdfs:range xsd:string .

codexai:obligationText rdf:type owl:DatatypeProperty ;
    rdfs:label "obligation text"@en ;
    rdfs:domain codexai:Obligation ;
    rdfs:range xsd:string .

codexai:bindingLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "binding level"@en ;
    rdfs:comment "mandatory, conditional, or recommended"@en ;
    rdfs:domain codexai:Obligation ;
    rdfs:range xsd:string .

codexai:dimensionName rdf:type owl:DatatypeProperty ;
    rdfs:label "dimension name"@en ;
    rdfs:domain codexai:ComplianceDimension ;
    rdfs:range xsd:string .

codexai:dimensionWeight rdf:type owl:DatatypeProperty ;
    rdfs:label "dimension weight"@en ;
    rdfs:domain codexai:ComplianceDimension ;
    rdfs:range xsd:float .

codexai:questionText rdf:type owl:DatatypeProperty ;
    rdfs:label "question text"@en ;
    rdfs:domain codexai:AssessmentQuestion ;
    rdfs:range xsd:string .

codexai:effortEstimate rdf:type owl:DatatypeProperty ;
    rdfs:label "effort estimate"@en ;
    rdfs:domain codexai:ComplianceGap ;
    rdfs:range xsd:string .

codexai:priority rdf:type owl:DatatypeProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "critical, high, medium, or low"@en ;
    rdfs:domain codexai:ComplianceGap ;
    rdfs:range xsd:string .

codexai:taskPhase rdf:type owl:DatatypeProperty ;
    rdfs:label "task phase"@en ;
    rdfs:domain codexai:MigrationTask ;
    rdfs:range xsd:integer .

codexai:taskDescription rdf:type owl:DatatypeProperty ;
    rdfs:label "task description"@en ;
    rdfs:domain codexai:MigrationTask ;
    rdfs:range xsd:string .

codexai:evidenceHash rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence hash"@en ;
    rdfs:comment "SHA-256 hash for tamper-evident chain."@en ;
    rdfs:domain codexai:Evidence ;
    rdfs:range xsd:string .

codexai:createdAt rdf:type owl:DatatypeProperty ;
    rdfs:label "created at"@en ;
    rdfs:domain codexai:Evidence ;
    rdfs:range xsd:dateTime .

codexai:correlationId rdf:type owl:DatatypeProperty ;
    rdfs:label "correlation ID"@en ;
    rdfs:domain codexai:Evidence ;
    rdfs:range xsd:string .

codexai:enforcementDate rdf:type owl:DatatypeProperty ;
    rdfs:label "enforcement date"@en ;
    rdfs:domain codexai:Deadline ;
    rdfs:range xsd:date .

codexai:maxFineEuros rdf:type owl:DatatypeProperty ;
    rdfs:label "max fine euros"@en ;
    rdfs:domain codexai:Penalty ;
    rdfs:range xsd:integer .

codexai:maxFinePercentage rdf:type owl:DatatypeProperty ;
    rdfs:label "max fine percentage"@en ;
    rdfs:comment "Of worldwide annual turnover."@en ;
    rdfs:domain codexai:Penalty ;
    rdfs:range xsd:float .


# =============================================================================
# Agentic-AI Compound-Risk Taxonomy (paper §10.4)
#
# Source: AI Agents Under EU Law (Working Paper, 7 April 2026), §10.4
# lines 2227-2245. The paper observes no current EU instrument provides
# a risk taxonomy for compound AI systems — Recital 116 only mandates
# one for GPAI systemic risk; ISO/IEC 42005 + 23894 manage organisational
# risk to the organisation, not Article 9's external-rights scope.
# CodexAI is the canonical implementation.
#
# Classes:
#   - codexai:CompoundRiskType     ⊆ airo:RiskConcept   (4 axes)
#   - codexai:ThreatCategory       ⊆ airo:Threat        (10 entries)
#   - codexai:AgentArchetype       ⊆ airo:AISystem      (7 entries)
#   - codexai:OperatorRole         ⊆ eu-aiact:AIRole    (9 entries)
#
# Properties:
#   - codexai:mitigatesRisk       Article    → CompoundRiskType
#   - codexai:exhibitsThreat      CompoundRiskType → ThreatCategory
#   - codexai:archetypeCarries    AgentArchetype  → CompoundRiskType
#   - codexai:appliesToRole       Article    → OperatorRole
#   - codexai:flipsProviderUnder  OperatorRole → Article
# =============================================================================

codexai:CompoundRiskType rdf:type owl:Class ;
    rdfs:label "Compound Risk Type"@en ;
    rdfs:subClassOf airo:RiskConcept ;
    rdfs:comment """
        One axis of the four-axis agentic-AI compound-risk taxonomy
        (cascading / emergent / attribution / temporal).

        Source: AI Agents Under EU Law (Working Paper, 7 April 2026),
        §10.4 lines 2227-2245.
    """@en ;
    skos:definition "An axis of compound-AI-system risk that captures cascade, emergence, attribution-mismatch, or temporal-drift dynamics not addressed by single-system risk taxonomies."@en .

codexai:ThreatCategory rdf:type owl:Class ;
    rdfs:label "Threat Category"@en ;
    rdfs:subClassOf airo:Threat ;
    rdfs:comment """
        A threat category cross-walked from the agentic-AI literature.
        Sources: Kim et al. USENIX 2026 (5 categories), Hammond et al.
        multi-agent failure modes (3), OWASP Top-10 Agentic, AEPD
        rule-of-2 / lethal trifecta (Spanish DPA, 18 Feb 2026).
    """@en ;
    skos:definition "A named threat class against which a compound AI system must be defended."@en .

codexai:AgentArchetype rdf:type owl:Class ;
    rdfs:label "Agent Archetype"@en ;
    rdfs:subClassOf airo:AISystem ;
    rdfs:comment """
        An agent architecture archetype: single-agent, orchestrator
        with sub-agents, multi-agent swarm, GPAI with tools, RAG-
        grounded agent, dynamic-tool-discovery agent, or continuously-
        learning system.
    """@en ;
    skos:definition "A canonical shape of agentic AI system architecture used to predict the typical compound-risk profile."@en .

codexai:OperatorRole rdf:type owl:Class ;
    rdfs:label "Operator Role"@en ;
    rdfs:subClassOf eu-aiact:AIRole ;
    rdfs:comment """
        An EU AI Act operator role under Art. 3 + Chapter V + Art. 22 +
        Art. 74 + MSR Reg. (EU) 2019/1020 Art. 4. Includes the six NLF
        roles (provider, deployer, importer, distributor, product
        manufacturer, authorised representative), the GPAI provider,
        the GPAI provider with systemic risk, and the
        extraterritorial-non-EU modifier reached by Art. 2(1)(c).
    """@en ;
    skos:definition "An EU AI Act operator role that determines which articles a party owes."@en .

# ─── Properties ──────────────────────────────────────────────────────

codexai:mitigatesRisk rdf:type owl:ObjectProperty ;
    rdfs:label "mitigates compound risk"@en ;
    rdfs:comment "Connects an AI Act article to the compound-risk axis it mitigates."@en ;
    rdfs:domain codexai:Article ;
    rdfs:range codexai:CompoundRiskType ;
    rdfs:subPropertyOf airo:mitigatesRiskConcept .

codexai:exhibitsThreat rdf:type owl:ObjectProperty ;
    rdfs:label "exhibits threat"@en ;
    rdfs:comment "Connects a compound-risk axis to a threat category in the cross-walk."@en ;
    rdfs:domain codexai:CompoundRiskType ;
    rdfs:range codexai:ThreatCategory .

codexai:archetypeCarries rdf:type owl:ObjectProperty ;
    rdfs:label "archetype carries risk"@en ;
    rdfs:comment "Connects an agent archetype to the compound-risk axis it typically carries."@en ;
    rdfs:domain codexai:AgentArchetype ;
    rdfs:range codexai:CompoundRiskType .

codexai:appliesToRole rdf:type owl:ObjectProperty ;
    rdfs:label "applies to operator role"@en ;
    rdfs:comment "Connects an AI Act article to the operator role(s) that owe it."@en ;
    rdfs:domain codexai:Article ;
    rdfs:range codexai:OperatorRole .

codexai:flipsProviderUnder rdf:type owl:ObjectProperty ;
    rdfs:label "flips to provider under article"@en ;
    rdfs:comment "Connects an operator role to the article(s) under which the role flips into provider status (Art. 25 substantial modification, own-name, intended-purpose change, >1/3 GPAI compute)."@en ;
    rdfs:domain codexai:OperatorRole ;
    rdfs:range codexai:Article .

# ─── Compound-risk axis individuals (paper §10.4) ────────────────────

codexai:cascading rdf:type codexai:CompoundRiskType ;
    rdfs:label "Cascading Risk"@en ;
    skos:definition "Error or bias in one agent's output propagates through orchestrated sub-agents, contaminating downstream actions."@en ;
    skos:note "Paper §10.4 lines 2227-2229" .

codexai:emergent rdf:type codexai:CompoundRiskType ;
    rdfs:label "Emergent Risk"@en ;
    skos:definition "Individually safe agents produce unsafe collective behaviour through interaction effects — miscoordination, conflict, collusion."@en ;
    skos:note "Paper §10.4 lines 2229-2230; Hammond et al.; Darius et al." .

codexai:attribution rdf:type codexai:CompoundRiskType ;
    rdfs:label "Attribution Risk"@en ;
    skos:definition "The multi-provider value chain obscures responsibility in ways the New Legislative Framework's role taxonomy was not designed to handle."@en ;
    skos:note "Paper §10.4 lines 2230-2232; footnote 33." .

codexai:temporal rdf:type codexai:CompoundRiskType ;
    rdfs:label "Temporal Risk (Runtime Drift)"@en ;
    skos:definition "Long-running agent processes accumulate state modifications that are individually minor but collectively constitute a shift outside the conformity-assessed envelope."@en ;
    skos:note "Paper §10.4 lines 2232-2233; §6.4; Art. 3(23) substantial modification." .

# ─── Operator-role individuals (the 9 canonical roles) ───────────────
# Definitions abbreviated; full definitions in app/data/role_obligations.py.

codexai:provider rdf:type codexai:OperatorRole ;
    rdfs:label "Provider"@en ;
    skos:definition "Develops or commissions an AI system and places it on the market or puts it into service under its own name (Art. 3(3))."@en .

codexai:deployer rdf:type codexai:OperatorRole ;
    rdfs:label "Deployer"@en ;
    skos:definition "Uses an AI system under its authority (not for personal non-professional activity) (Art. 3(4))."@en .

codexai:importer rdf:type codexai:OperatorRole ;
    rdfs:label "Importer"@en ;
    skos:definition "Places on the EU market an AI system bearing the name of a non-EU provider (Art. 3(7))."@en .

codexai:distributor rdf:type codexai:OperatorRole ;
    rdfs:label "Distributor"@en ;
    skos:definition "Makes an AI system available on the EU market without affecting its properties (Art. 3(8))."@en .

codexai:productManufacturer rdf:type codexai:OperatorRole ;
    rdfs:label "Product Manufacturer"@en ;
    skos:definition "Integrates an AI system into a product placed on the market under the manufacturer's name; treated as provider (Art. 25(1))."@en .

codexai:authorizedRepresentative rdf:type codexai:OperatorRole ;
    rdfs:label "Authorized Representative"@en ;
    skos:definition "Appointed by a non-EU provider as their authorized representative in the EU under written mandate (Art. 22)."@en .

codexai:gpaiProvider rdf:type codexai:OperatorRole ;
    rdfs:label "GPAI Model Provider"@en ;
    skos:definition "Provider of a general-purpose AI model placed on the market — Chapter V Art. 53 obligations."@en .

codexai:gpaiSystemicProvider rdf:type codexai:OperatorRole ;
    rdfs:label "GPAI Provider with Systemic Risk"@en ;
    skos:definition "GPAI model meeting the Art. 51(2) quantitative criterion or AI-Office designation; carries Art. 55 + Art. 56 additional obligations."@en .

codexai:extraterritorialNonEu rdf:type codexai:OperatorRole ;
    rdfs:label "Extraterritorial (Non-EU) Entity"@en ;
    skos:definition "Non-EU entity reached by Art. 2(1)(c) — must designate a 'responsible person' established in the EU per MSR Art. 4 / AI Act Art. 74."@en ;
    skos:note "Most US AI agent providers have not yet addressed this (paper lines 1071-1072)." .

# =============================================================================
# MITRE ATLAS — Adversarial Threat Landscape for AI Systems
# =============================================================================
#
# Models a hardening campaign (a recorded antifragile-ai security run) and
# the per-attempt outcomes mapped onto MITRE ATLAS techniques. Used by
# /api/v1/security-scan/campaigns/{id}/atlas-export to produce a benchmarking-
# friendly RDF/Turtle or JSON-LD view of the campaign for downstream triple
# stores and security-research consumers.
#
# Source vocabulary:
#   - MITRE ATLAS — https://atlas.mitre.org/ (mitre-atlas: prefix)
#   - Curated subset vendored at app/data/atlas_techniques.py

codexai:SecurityCampaign rdf:type owl:Class ;
    rdfs:subClassOf airo:RiskAssessment ;
    rdfs:label "Security Campaign"@en ;
    skos:definition "A recorded antifragile-ai hardening campaign — a sequence of MITRE ATLAS attack attempts against an AI system, with per-attempt outcomes and an aggregate Wilson-score resilience metric."@en .

codexai:AttackAttempt rdf:type owl:Class ;
    rdfs:subClassOf airo:Risk ;
    rdfs:label "Attack Attempt"@en ;
    skos:definition "A single execution of an ATLAS technique against the campaign target. Carries a reference to the technique (codexai:carriesTechnique) and the outcome (codexai:hasOutcome)."@en .

codexai:AtlasTechnique rdf:type owl:Class ;
    rdfs:subClassOf airo:Threat ;
    rdfs:label "MITRE ATLAS Technique"@en ;
    skos:definition "A technique from the MITRE ATLAS taxonomy. Identified by AML.T#### with optional sub-technique. Inline-emitted in the export so consumers do not need to fetch from atlas.mitre.org."@en .

codexai:UnmappedTechnique rdf:type codexai:AtlasTechnique ;
    rdfs:label "Unmapped attack technique"@en ;
    skos:definition "Fallback used when a registry-emitted technique string does not resolve to a curated AML.T#### entry. The original label is preserved on the AttackAttempt via codexai:unmappedTechniqueLabel — never silently dropped (antifragility hygiene rule #1)."@en .

codexai:AttackOutcome rdf:type owl:Class ;
    rdfs:label "Attack Outcome"@en ;
    skos:definition "Canonical outcome of an attack attempt. Closed enumeration: success / blocked / error / timeout / pending / running."@en .

codexai:AttackOutcome_Success rdf:type codexai:AttackOutcome ;
    rdfs:label "Success"@en ;
    codexai:outcomeKind "success" ;
    skos:definition "Attack succeeded — the system is vulnerable along this dimension."@en .

codexai:AttackOutcome_Blocked rdf:type codexai:AttackOutcome ;
    rdfs:label "Blocked"@en ;
    codexai:outcomeKind "blocked" ;
    skos:definition "Defense intercepted the attack — capacity-building stressor per Jin & Lee."@en .

codexai:AttackOutcome_Error rdf:type codexai:AttackOutcome ;
    rdfs:label "Error"@en ;
    codexai:outcomeKind "error" ;
    skos:definition "Attack execution failed for non-defensive reasons (network, target down, executor crash). Investigate before treating as evidence."@en .

codexai:AttackOutcome_Timeout rdf:type codexai:AttackOutcome ;
    rdfs:label "Timeout"@en ;
    codexai:outcomeKind "timeout" ;
    skos:definition "Attack did not complete within the executor's deadline; ambiguous between blocked + slow-error."@en .

codexai:AttackOutcome_Pending rdf:type codexai:AttackOutcome ;
    rdfs:label "Pending"@en ;
    codexai:outcomeKind "pending" ;
    skos:definition "Attack scheduled but not yet started."@en .

codexai:AttackOutcome_Running rdf:type codexai:AttackOutcome ;
    rdfs:label "Running"@en ;
    codexai:outcomeKind "running" ;
    skos:definition "Attack in flight at snapshot time."@en .

codexai:carriesTechnique rdf:type owl:ObjectProperty ;
    rdfs:label "carries technique"@en ;
    rdfs:domain codexai:AttackAttempt ;
    rdfs:range codexai:AtlasTechnique ;
    skos:definition "Links an attempt to the MITRE ATLAS technique it executes."@en .

codexai:hasOutcome rdf:type owl:ObjectProperty ;
    rdfs:label "has outcome"@en ;
    rdfs:domain codexai:AttackAttempt ;
    rdfs:range codexai:AttackOutcome ;
    skos:definition "Links an attempt to the canonical outcome individual."@en .

codexai:campaign rdf:type owl:ObjectProperty ;
    rdfs:label "campaign"@en ;
    rdfs:domain codexai:AttackAttempt ;
    rdfs:range codexai:SecurityCampaign ;
    skos:definition "Back-reference from an attempt to the parent campaign."@en .

codexai:atlasId rdf:type owl:DatatypeProperty ;
    rdfs:label "ATLAS ID"@en ;
    rdfs:domain codexai:AtlasTechnique ;
    rdfs:range xsd:string ;
    skos:definition "Canonical AML.T#### identifier (with optional .### sub-technique suffix)."@en .

codexai:atlasTactic rdf:type owl:DatatypeProperty ;
    rdfs:label "ATLAS tactic"@en ;
    rdfs:domain codexai:AtlasTechnique ;
    rdfs:range xsd:string ;
    skos:definition "ATLAS kill-chain tactic the technique participates in (e.g. Initial Access, Defense Evasion)."@en .

codexai:outcomeKind rdf:type owl:DatatypeProperty ;
    rdfs:label "outcome kind"@en ;
    rdfs:domain codexai:AttackOutcome ;
    rdfs:range xsd:string .

codexai:resilienceScore rdf:type owl:DatatypeProperty ;
    rdfs:label "resilience score"@en ;
    rdfs:domain codexai:SecurityCampaign ;
    rdfs:range xsd:decimal .

codexai:resilienceCiLower rdf:type owl:DatatypeProperty ;
    rdfs:label "resilience CI lower"@en ;
    rdfs:domain codexai:SecurityCampaign ;
    rdfs:range xsd:decimal .

codexai:resilienceCiUpper rdf:type owl:DatatypeProperty ;
    rdfs:label "resilience CI upper"@en ;
    rdfs:domain codexai:SecurityCampaign ;
    rdfs:range xsd:decimal .


# =============================================================================
# LatticeFlow ATLAS — EU AI Act Article 15 Control Decomposition
# =============================================================================
#
# Models the 8-control decomposition of Article 15 (Accuracy, Robustness,
# Cybersecurity) used by LatticeFlow Atlas + the specter-oss compliance
# toolkit. The risk anchor is R.1; controls are C.1.1 through C.1.8.
# Auditors and Notified Body inspectors familiar with the LatticeFlow
# framework can drill from a CodexAI Compliance Gap Report row to the
# matching LatticeFlow control by control_id without an additional
# crosswalk lookup.
#
# Source vocabulary:
#   - LatticeFlow ATLAS — https://atlas.latticeflow.ai/framework/eu_ai_act_article_15
#   - Risk/control structure follows LatticeFlow's R.<n> / C.<n>.<m> convention
#   - Verbatim citations from the public-domain Official Journal of the EU
#     (L 2024/1689, EUR-Lex art_15)
#   - Source-of-truth catalog vendored at app/data/article_15_controls.py
#
# This block is mirrored by the Pydantic Article15Control catalog so a
# downstream RDF consumer (TrustGraph, an external Notified Body's triple
# store) sees the same 8 controls the in-app Compliance Gap Report shows.

codexai:LatticeFlowControl rdf:type owl:Class ;
    rdfs:subClassOf airo:RiskControl ;
    rdfs:label "LatticeFlow ATLAS Control"@en ;
    skos:definition "A control row from the LatticeFlow ATLAS decomposition of an EU AI Act article. Identified by C.<risk_index>.<control_index>. Carries an article paragraph anchor (codexai:articleParagraph) so paragraph-citing auditors can resolve to a control."@en .

codexai:LatticeFlowRisk rdf:type owl:Class ;
    rdfs:subClassOf airo:Risk ;
    rdfs:label "LatticeFlow ATLAS Risk"@en ;
    skos:definition "The risk anchor at the top of a LatticeFlow decomposition (e.g. R.1 = non-compliance with Article 15). One risk root per article."@en .

codexai:hasLatticeFlowControl rdf:type owl:ObjectProperty ;
    rdfs:label "has LatticeFlow control"@en ;
    rdfs:domain codexai:Article ;
    rdfs:range codexai:LatticeFlowControl ;
    skos:definition "Links an Article individual to one of its LatticeFlow ATLAS controls."@en .

codexai:operationalises rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf airo:hasControl ;
    rdfs:label "operationalises"@en ;
    rdfs:domain codexai:LatticeFlowControl ;
    rdfs:range codexai:Obligation ;
    skos:definition "Links a control to the obligation it operationalises. A single obligation may be operationalised by multiple controls (paragraph 15(1) splits into Accuracy / Robustness / Cybersecurity / Consistent Performance)."@en .

codexai:articleParagraph rdf:type owl:DatatypeProperty ;
    rdfs:label "article paragraph"@en ;
    rdfs:domain codexai:LatticeFlowControl ;
    rdfs:range xsd:string ;
    skos:definition "Paragraph anchor in publication form (e.g. '15(3)') the control most directly operationalises."@en .

codexai:latticeFlowControlId rdf:type owl:DatatypeProperty ;
    rdfs:label "LatticeFlow control ID"@en ;
    rdfs:domain codexai:LatticeFlowControl ;
    rdfs:range xsd:string ;
    skos:definition "Canonical C.<n>.<m> identifier."@en .

# --- Risk individual (R.1 — Article 15) ---

codexai:LF_R_1 rdf:type codexai:LatticeFlowRisk ;
    rdfs:label "R.1 — Non-compliance with EU AI Act Article 15"@en ;
    skos:definition "Failure to meet regulatory requirements for accuracy, robustness, and cybersecurity of high-risk AI systems."@en .

# --- Control individuals (C.1.1 through C.1.8) ---

codexai:LF_C_1_1 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.1" ;
    codexai:articleParagraph "15(1)" ;
    rdfs:label "C.1.1 Accuracy"@en ;
    skos:definition "Ensure an appropriate level of accuracy for the high-risk AI system across its intended purpose."@en .

codexai:LF_C_1_2 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.2" ;
    codexai:articleParagraph "15(1)" ;
    rdfs:label "C.1.2 Robustness"@en ;
    skos:definition "Ensure an appropriate level of robustness against errors, faults, and reasonably foreseeable misuse."@en .

codexai:LF_C_1_3 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.3" ;
    codexai:articleParagraph "15(1)" ;
    rdfs:label "C.1.3 Cybersecurity"@en ;
    skos:definition "Ensure an appropriate level of cybersecurity for the high-risk AI system, proportionate to the risks."@en .

codexai:LF_C_1_4 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.4" ;
    codexai:articleParagraph "15(1)" ;
    rdfs:label "C.1.4 Consistent Performance"@en ;
    skos:definition "Ensure consistent accuracy, robustness, and cybersecurity throughout the AI system's lifecycle."@en .

codexai:LF_C_1_5 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.5" ;
    codexai:articleParagraph "15(2)" ;
    rdfs:label "C.1.5 Accuracy Transparency"@en ;
    skos:definition "Declare the levels of accuracy and the relevant accuracy metrics in the instructions for use."@en .

codexai:LF_C_1_6 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.6" ;
    codexai:articleParagraph "15(4)" ;
    rdfs:label "C.1.6 Resiliency"@en ;
    skos:definition "Ensure resilience to errors, faults, or inconsistencies within the system or environment, with redundancy where needed."@en .

codexai:LF_C_1_7 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.7" ;
    codexai:articleParagraph "15(4)" ;
    rdfs:label "C.1.7 Biased Feedback Loops"@en ;
    skos:definition "Eliminate or reduce the risk that biased outputs influence inputs to future operations."@en .

codexai:LF_C_1_8 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.1.8" ;
    codexai:articleParagraph "15(5)" ;
    rdfs:label "C.1.8 Malicious Actors"@en ;
    skos:definition "Resist attempts by unauthorised third parties to alter the system's use, outputs, or performance by exploiting vulnerabilities."@en .


# =============================================================================
# LatticeFlow ATLAS - EU AI Act Articles 9, 10, 11, 13, 14 (Phase 2)
# =============================================================================
#
# Phase 2 (2026-05-10) extends the LatticeFlow ATLAS-style decomposition
# from Article 15 to Articles 9, 10, 11, 13, 14. Each article gets its
# own R.<N> risk anchor and a sequence of C.<N>.<M> control individuals.
#
# As of 2026-05-10 LatticeFlow Atlas only publishes the Art. 15 framework
# at https://atlas.latticeflow.ai/framework/eu_ai_act_article_15; the
# additional decompositions below are regulator-faithful fallbacks
# derived from the verbatim EU AI Act paragraph structure (EUR-Lex
# L 2024/1689) and the platform's existing KB dimensions.
#
# Source-of-truth catalogs vendored at:
#   - app/data/article_09_controls.py - R.9 + 7 controls
#   - app/data/article_10_controls.py - R.10 + 8 controls
#   - app/data/article_11_controls.py - R.11 + 6 controls
#   - app/data/article_13_controls.py - R.13 + 7 controls
#   - app/data/article_14_controls.py - R.14 + 7 controls
#
# When LatticeFlow Atlas publishes an Art. 9 / 10 / 11 / 13 / 14
# framework, this block should be reviewed against the upstream source
# and the LAST_SYNCED date in the matching Pydantic catalog bumped
# accordingly.

# --- R.9 risk anchor (Article 9) ---

codexai:LF_R_9 rdf:type codexai:LatticeFlowRisk ;
    rdfs:label "R.9 - Non-compliance with EU AI Act Article 9"@en ;
    skos:definition "Failure to establish, implement, document, and maintain a risk management system across the high-risk AI system lifecycle."@en .

# --- Article 9 control individuals ---

codexai:LF_C_9_1 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.9.1" ;
    codexai:articleParagraph "9(1)" ;
    rdfs:label "C.9.1 Risk Management System Establishment"@en ;
    skos:definition "Establish, implement, document, and maintain a risk management system for the high-risk AI system across its lifecycle."@en .

codexai:LF_C_9_2 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.9.2" ;
    codexai:articleParagraph "9(2)" ;
    rdfs:label "C.9.2 Iterative Lifecycle Process"@en ;
    skos:definition "Run the risk management process as a continuous, iterative cycle throughout the AI system's lifecycle, with regular and systematic review and updating."@en .

codexai:LF_C_9_3 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.9.3" ;
    codexai:articleParagraph "9(2)(a)" ;
    rdfs:label "C.9.3 Foreseeable Risk Identification"@en ;
    skos:definition "Identify and analyse the known and reasonably foreseeable risks the high-risk AI system can pose to health, safety, or fundamental rights when used for its intended purpose."@en .

codexai:LF_C_9_4 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.9.4" ;
    codexai:articleParagraph "9(2)(b)" ;
    rdfs:label "C.9.4 Foreseeable Misuse Risk Estimation"@en ;
    skos:definition "Estimate and evaluate risks emerging from intended use AND from reasonably foreseeable misuse of the high-risk AI system."@en .

codexai:LF_C_9_5 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.9.5" ;
    codexai:articleParagraph "9(4)" ;
    rdfs:label "C.9.5 Risk Management Measures Coordination"@en ;
    skos:definition "Apply risk management measures so that the combined effect of mitigations across requirements minimises risk while remaining balanced."@en .

codexai:LF_C_9_6 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.9.6" ;
    codexai:articleParagraph "9(5)" ;
    rdfs:label "C.9.6 Targeted Testing for Risk Management"@en ;
    skos:definition "Test the high-risk AI system for the most appropriate and targeted risk management measures, ensuring consistent performance for its intended purpose."@en .

codexai:LF_C_9_7 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.9.7" ;
    codexai:articleParagraph "9(6)" ;
    rdfs:label "C.9.7 Residual Risk Acceptability and Communication"@en ;
    skos:definition "Judge per-hazard residual risks and the overall residual risk acceptable, and communicate them to the deployer."@en .


# --- R.10 risk anchor (Article 10) ---

codexai:LF_R_10 rdf:type codexai:LatticeFlowRisk ;
    rdfs:label "R.10 - Non-compliance with EU AI Act Article 10"@en ;
    skos:definition "Failure to apply data governance and management practices to training, validation, and testing data sets - including bias examination, mitigation, and special-categories handling."@en .

# --- Article 10 control individuals ---

codexai:LF_C_10_1 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.1" ;
    codexai:articleParagraph "10(2)" ;
    rdfs:label "C.10.1 Data Governance Practices"@en ;
    skos:definition "Apply data governance and management practices appropriate for the intended purpose to training, validation, and testing data sets."@en .

codexai:LF_C_10_2 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.2" ;
    codexai:articleParagraph "10(2)(b)" ;
    rdfs:label "C.10.2 Data Provenance and Origin"@en ;
    skos:definition "Document the origin of data and, in the case of personal data, the original purpose of data collection."@en .

codexai:LF_C_10_3 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.3" ;
    codexai:articleParagraph "10(2)(c)" ;
    rdfs:label "C.10.3 Data Preparation Operations"@en ;
    skos:definition "Document data preparation operations such as annotation, labelling, cleaning, updating, enrichment, and aggregation."@en .

codexai:LF_C_10_4 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.4" ;
    codexai:articleParagraph "10(2)(f)" ;
    rdfs:label "C.10.4 Bias Examination"@en ;
    skos:definition "Examine training, validation, and testing data sets for biases likely to affect health, safety, or fundamental rights, or lead to discrimination."@en .

codexai:LF_C_10_5 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.5" ;
    codexai:articleParagraph "10(2)(g)" ;
    rdfs:label "C.10.5 Bias Mitigation Measures"@en ;
    skos:definition "Identify and apply appropriate measures to detect, prevent, and mitigate the biases identified per Article 10(2)(f)."@en .

codexai:LF_C_10_6 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.6" ;
    codexai:articleParagraph "10(2)(h)" ;
    rdfs:label "C.10.6 Data Gaps and Shortcomings"@en ;
    skos:definition "Identify relevant data gaps or shortcomings that prevent compliance and document how to address them."@en .

codexai:LF_C_10_7 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.7" ;
    codexai:articleParagraph "10(3)" ;
    rdfs:label "C.10.7 Dataset Relevance and Representativeness"@en ;
    skos:definition "Ensure training, validation, and testing data sets are relevant, sufficiently representative, and to the best extent possible free of errors and complete in view of the intended purpose, with appropriate statistical properties for the persons or groups on whom the system is to be used."@en .

codexai:LF_C_10_8 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.10.8" ;
    codexai:articleParagraph "10(5)" ;
    rdfs:label "C.10.8 Special Categories of Personal Data"@en ;
    skos:definition "Where strictly necessary for bias detection and correction, process special categories of personal data only with technical limitations on re-use, state-of-the-art security and privacy-preserving measures, including pseudonymisation."@en .


# --- R.11 risk anchor (Article 11) ---

codexai:LF_R_11 rdf:type codexai:LatticeFlowRisk ;
    rdfs:label "R.11 - Non-compliance with EU AI Act Article 11"@en ;
    skos:definition "Failure to draft and maintain technical documentation containing the Annex IV elements, accessible to national competent authorities and notified bodies."@en .

# --- Article 11 control individuals ---

codexai:LF_C_11_1 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.11.1" ;
    codexai:articleParagraph "11(1)" ;
    rdfs:label "C.11.1 Pre-Market Documentation Drafting"@en ;
    skos:definition "Draw up technical documentation BEFORE the high-risk AI system is placed on the market or put into service."@en .

codexai:LF_C_11_2 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.11.2" ;
    codexai:articleParagraph "11(1)" ;
    rdfs:label "C.11.2 Documentation Up-to-Date Maintenance"@en ;
    skos:definition "Keep the technical documentation up to date over the AI system's lifetime, reflecting design changes, training updates, and deployment configuration changes."@en .

codexai:LF_C_11_3 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.11.3" ;
    codexai:articleParagraph "11(1)" ;
    rdfs:label "C.11.3 Annex IV Minimum Content"@en ;
    skos:definition "Ensure the technical documentation contains at minimum the elements set out in Annex IV — system description, design specs, dev process, monitoring + control mechanisms."@en .

codexai:LF_C_11_4 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.11.4" ;
    codexai:articleParagraph "11(1)" ;
    rdfs:label "C.11.4 SME Simplified Documentation Form"@en ;
    skos:definition "Allow SMEs (including start-ups) to provide the elements of Annex IV in a simplified form using the Commission's template."@en .

codexai:LF_C_11_5 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.11.5" ;
    codexai:articleParagraph "11(2)" ;
    rdfs:label "C.11.5 Regulator Access Upon Request"@en ;
    skos:definition "Make the technical documentation available to national competent authorities and notified bodies in a clear and comprehensive form to assess compliance."@en .

codexai:LF_C_11_6 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.11.6" ;
    codexai:articleParagraph "11(3)" ;
    rdfs:label "C.11.6 Documentation Retention (10 years post-market)"@en ;
    skos:definition "Retain the technical documentation for 10 years after the high-risk AI system has been placed on the market or put into service, available to national competent authorities. (Art. 18 retention obligation, anchored against Art. 11.)"@en .


# --- R.13 risk anchor (Article 13) ---

codexai:LF_R_13 rdf:type codexai:LatticeFlowRisk ;
    rdfs:label "R.13 - Non-compliance with EU AI Act Article 13"@en ;
    skos:definition "Failure to provide deployers with sufficient transparency, instructions for use, and disclosures of identity, capabilities, limitations, and oversight measures."@en .

# --- Article 13 control individuals ---

codexai:LF_C_13_1 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.13.1" ;
    codexai:articleParagraph "13(1)" ;
    rdfs:label "C.13.1 Sufficient Operational Transparency"@en ;
    skos:definition "Design the high-risk AI system's operation to be sufficiently transparent that deployers can interpret the system's output and use it appropriately."@en .

codexai:LF_C_13_2 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.13.2" ;
    codexai:articleParagraph "13(2)" ;
    rdfs:label "C.13.2 Instructions for Use Provided"@en ;
    skos:definition "Accompany the high-risk AI system with instructions for use in an appropriate digital format that is concise, complete, correct, clear, relevant, accessible, and comprehensible to deployers."@en .

codexai:LF_C_13_3 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.13.3" ;
    codexai:articleParagraph "13(3)(a)" ;
    rdfs:label "C.13.3 Provider Identity and Contact"@en ;
    skos:definition "Disclose the identity and contact details of the provider and, where applicable, the authorised representative."@en .

codexai:LF_C_13_4 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.13.4" ;
    codexai:articleParagraph "13(3)(b)" ;
    rdfs:label "C.13.4 Capabilities, Limitations, Performance"@en ;
    skos:definition "Document the AI system's intended purpose, level of accuracy + robustness + cybersecurity, foreseeable circumstances that may lead to risks, and performance with respect to specific persons or groups."@en .

codexai:LF_C_13_5 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.13.5" ;
    codexai:articleParagraph "13(3)(c)" ;
    rdfs:label "C.13.5 Pre-Determined Changes Disclosed"@en ;
    skos:definition "Document changes to the high-risk AI system and its performance that have been pre-determined by the provider at the moment of the initial conformity assessment."@en .

codexai:LF_C_13_6 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.13.6" ;
    codexai:articleParagraph "13(3)(d)" ;
    rdfs:label "C.13.6 Human-Oversight Measures Documented"@en ;
    skos:definition "Describe the human-oversight measures, including technical measures put in place to facilitate the interpretation of outputs by deployers (Art. 14)."@en .

codexai:LF_C_13_7 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.13.7" ;
    codexai:articleParagraph "13(3)(e)" ;
    rdfs:label "C.13.7 Computational and Hardware Resources"@en ;
    skos:definition "Document the computational and hardware resources needed, the expected lifetime of the high-risk AI system, and any necessary maintenance and care measures."@en .


# --- R.14 risk anchor (Article 14) ---

codexai:LF_R_14 rdf:type codexai:LatticeFlowRisk ;
    rdfs:label "R.14 - Non-compliance with EU AI Act Article 14"@en ;
    skos:definition "Failure to design the high-risk AI system for effective human oversight, including measures enabling overseers to understand limits, avoid automation bias, interpret outputs, override decisions, and intervene or stop."@en .

# --- Article 14 control individuals ---

codexai:LF_C_14_1 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.14.1" ;
    codexai:articleParagraph "14(1)" ;
    rdfs:label "C.14.1 Effective Human Oversight Design"@en ;
    skos:definition "Design and develop the high-risk AI system in such a way that it can be effectively overseen by natural persons during the period in which it is in use."@en .

codexai:LF_C_14_2 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.14.2" ;
    codexai:articleParagraph "14(4)(a)" ;
    rdfs:label "C.14.2 Capabilities and Limitations Awareness"@en ;
    skos:definition "Enable assigned natural persons to properly understand the relevant capabilities and limitations of the high-risk AI system and duly monitor its operation, including detecting and addressing anomalies, dysfunctions, and unexpected performance."@en .

codexai:LF_C_14_3 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.14.3" ;
    codexai:articleParagraph "14(4)(b)" ;
    rdfs:label "C.14.3 Automation-Bias Safeguards"@en ;
    skos:definition "Help assigned overseers remain aware of the possible tendency of automatically relying or over-relying on the output produced by a high-risk AI system, particularly in systems used to provide information or recommendations for decisions to be taken by natural persons."@en .

codexai:LF_C_14_4 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.14.4" ;
    codexai:articleParagraph "14(4)(c)" ;
    rdfs:label "C.14.4 Correct Output Interpretation"@en ;
    skos:definition "Enable assigned overseers to correctly interpret the high-risk AI system's output, taking into account the available interpretation tools and methods."@en .

codexai:LF_C_14_5 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.14.5" ;
    codexai:articleParagraph "14(4)(d)" ;
    rdfs:label "C.14.5 Disregard / Override AI Output"@en ;
    skos:definition "Enable assigned overseers to decide, in any particular situation, not to use the high-risk AI system or to otherwise disregard, override, or reverse its output."@en .

codexai:LF_C_14_6 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.14.6" ;
    codexai:articleParagraph "14(4)(e)" ;
    rdfs:label "C.14.6 Intervene / Interrupt / Stop"@en ;
    skos:definition "Enable assigned overseers to intervene in the operation of the high-risk AI system or interrupt the system through a 'stop' button or a similar procedure that allows the system to come to a halt in a safe state."@en .

codexai:LF_C_14_7 rdf:type codexai:LatticeFlowControl ;
    codexai:latticeFlowControlId "C.14.7" ;
    codexai:articleParagraph "14(5)" ;
    rdfs:label "C.14.7 Biometric Two-Person Verification"@en ;
    skos:definition "For high-risk AI systems referred to in Annex III(1)(a) — remote biometric identification — ensure no action or decision is taken by the deployer on the basis of the identification unless the identification has been separately verified and confirmed by at least two natural persons with the necessary competence, training, and authority."@en .

