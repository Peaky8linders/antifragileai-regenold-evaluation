  SET n += {eid: "art_10__para_2__point_e", citation: "Art. 10(2)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_10__para_2__point_e", chunk_type: "point", level: "point", text: "an assessment of the availability, quantity and suitability of the data sets that are needed", article: 10, paragraph: 2, point: "e", chapter: 3, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 10(2)(e)"};
