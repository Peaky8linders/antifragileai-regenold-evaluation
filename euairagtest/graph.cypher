  SET n += {eid: "art_17__para_1__point_h", citation: "Art. 17(1)(h)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_17__para_1__point_h", chunk_type: "point", level: "point", text: "the setting-up, implementation and maintenance of a post-market monitoring system, in accordance with Article 72", article: 17, paragraph: 1, point: "h", chapter: 3, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 17(1)(h)"};
