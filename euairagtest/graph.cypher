  SET n += {eid: "art_99__para_6", citation: "Art. 99(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_6", chunk_type: "paragraph", level: "para", text: "In the case of SMEs, including start-ups, each fine referred to in this Article shall be up to the percentages or amount referred to in paragraphs 3, 4 and 5, whichever thereof is lower.", article: 99, paragraph: 6, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(6)"};
MERGE (n:Provision {id: "art_99__para_7"})
  SET n += {eid: "art_99__para_7", citation: "Art. 99(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7", chunk_type: "paragraph", level: "para", text: "When deciding whether to impose an administrative fine and when deciding on the amount of the administrative fine in each individual case, all relevant circumstances of the specific situation shall be taken into account and, as appropriate, regard shall be given to the following:\n(a) the nature, gravity and duration of the infringement and of its consequences, taking into account the purpose of the AI system, as well as, where appropriate, the number of affected persons and the level of damage suffered by them;\n(b) whether administrative fines have already been applied by other market surveillance authorities to the same operator for the same infringement;\n(c) whether administrative fines have already been applied by other authorities to the same operator for infringements of other Union or national law, when such infringements result from the same activity or omission constituting a relevant infringement of this Regulation;\n(d) the size, the annual turnover and market share of the operator committing the infringement;\n(e) any other aggravating or mitigating factor applicable to the circumstances of the case, such as financial benefits gained, or losses avoided, directly or indirectly, from the infringement;\n(f) the degree of cooperation with the national competent authorities, in order to remedy the infringement and mitigate the possible adverse effects of the infringement;\n(g) the degree of responsibility of the operator taking into account the technical and organisational measures implemented by it;\n(h) the manner in which the infringement became known to the national competent authorities, in particular whether, and if so to what extent, the operator notified the infringement;\n(i) the intentional or negligent character of the infringement;\n(j) any action taken by the operator to mitigate the harm suffered by the affected persons.", article: 99, paragraph: 7, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)"};
MERGE (n:Provision {id: "art_99__para_7__point_a"})
  SET n += {eid: "art_99__para_7__point_a", citation: "Art. 99(7)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_a", chunk_type: "point", level: "point", text: "the nature, gravity and duration of the infringement and of its consequences, taking into account the purpose of the AI system, as well as, where appropriate, the number of affected persons and the level of damage suffered by them", article: 99, paragraph: 7, point: "a", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(a)"};
MERGE (n:Provision {id: "art_99__para_7__point_b"})
  SET n += {eid: "art_99__para_7__point_b", citation: "Art. 99(7)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_b", chunk_type: "point", level: "point", text: "whether administrative fines have already been applied by other market surveillance authorities to the same operator for the same infringement", article: 99, paragraph: 7, point: "b", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(b)"};
MERGE (n:Provision {id: "art_99__para_7__point_c"})
  SET n += {eid: "art_99__para_7__point_c", citation: "Art. 99(7)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_c", chunk_type: "point", level: "point", text: "whether administrative fines have already been applied by other authorities to the same operator for infringements of other Union or national law, when such infringements result from the same activity or omission constituting a relevant infringement of this Regulation", article: 99, paragraph: 7, point: "c", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(c)"};
MERGE (n:Provision {id: "art_99__para_7__point_d"})
  SET n += {eid: "art_99__para_7__point_d", citation: "Art. 99(7)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_d", chunk_type: "point", level: "point", text: "the size, the annual turnover and market share of the operator committing the infringement", article: 99, paragraph: 7, point: "d", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(d)"};
MERGE (n:Provision {id: "art_99__para_7__point_e"})
  SET n += {eid: "art_99__para_7__point_e", citation: "Art. 99(7)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_e", chunk_type: "point", level: "point", text: "any other aggravating or mitigating factor applicable to the circumstances of the case, such as financial benefits gained, or losses avoided, directly or indirectly, from the infringement", article: 99, paragraph: 7, point: "e", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(e)"};
MERGE (n:Provision {id: "art_99__para_7__point_f"})
  SET n += {eid: "art_99__para_7__point_f", citation: "Art. 99(7)(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_f", chunk_type: "point", level: "point", text: "the degree of cooperation with the national competent authorities, in order to remedy the infringement and mitigate the possible adverse effects of the infringement", article: 99, paragraph: 7, point: "f", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(f)"};
MERGE (n:Provision {id: "art_99__para_7__point_g"})
  SET n += {eid: "art_99__para_7__point_g", citation: "Art. 99(7)(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_g", chunk_type: "point", level: "point", text: "the degree of responsibility of the operator taking into account the technical and organisational measures implemented by it", article: 99, paragraph: 7, point: "g", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(g)"};
MERGE (n:Provision {id: "art_99__para_7__point_h"})
  SET n += {eid: "art_99__para_7__point_h", citation: "Art. 99(7)(h)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_h", chunk_type: "point", level: "point", text: "the manner in which the infringement became known to the national competent authorities, in particular whether, and if so to what extent, the operator notified the infringement", article: 99, paragraph: 7, point: "h", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(h)"};
MERGE (n:Provision {id: "art_99__para_7__point_i"})
  SET n += {eid: "art_99__para_7__point_i", citation: "Art. 99(7)(i)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_i", chunk_type: "point", level: "point", text: "the intentional or negligent character of the infringement", article: 99, paragraph: 7, point: "i", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(i)"};
MERGE (n:Provision {id: "art_99__para_7__point_j"})
  SET n += {eid: "art_99__para_7__point_j", citation: "Art. 99(7)(j)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_7__point_j", chunk_type: "point", level: "point", text: "any action taken by the operator to mitigate the harm suffered by the affected persons", article: 99, paragraph: 7, point: "j", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(7)(j)"};
MERGE (n:Provision {id: "art_99__para_8"})
  SET n += {eid: "art_99__para_8", citation: "Art. 99(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_8", chunk_type: "paragraph", level: "para", text: "Each Member State shall lay down rules on to what extent administrative fines may be imposed on public authorities and bodies established in that Member State.", article: 99, paragraph: 8, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(8)"};
MERGE (n:Provision {id: "art_99__para_9"})
  SET n += {eid: "art_99__para_9", citation: "Art. 99(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_9", chunk_type: "paragraph", level: "para", text: "Depending on the legal system of the Member States, the rules on administrative fines may be applied in such a manner that the fines are imposed by competent national courts or by other bodies, as applicable in those Member States. The application of such rules in those Member States shall have an equivalent effect.", article: 99, paragraph: 9, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(9)"};
MERGE (n:Provision {id: "art_99__para_10"})
  SET n += {eid: "art_99__para_10", citation: "Art. 99(10)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_10", chunk_type: "paragraph", level: "para", text: "The exercise of powers under this Article shall be subject to appropriate procedural safeguards in accordance with Union and national law, including effective judicial remedies and due process.", article: 99, paragraph: 10, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(10)"};
MERGE (n:Provision {id: "art_99__para_11"})
  SET n += {eid: "art_99__para_11", citation: "Art. 99(11)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_11", chunk_type: "paragraph", level: "para", text: "Member States shall, on an annual basis, report to the Commission about the administrative fines they have issued during that year, in accordance with this Article, and about any related litigation or judicial proceedings.", article: 99, paragraph: 11, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(11)"};
MERGE (n:Provision {id: "art_100"})
  SET n += {eid: "art_100", citation: "Art. 100", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100", chunk_type: "article_full", level: "art", text: "Article 100 — Administrative fines on Union institutions, bodies, offices and agencies\n\n1. The European Data Protection Supervisor may impose administrative fines on Union institutions, bodies, offices and agencies falling within the scope of this Regulation. When deciding whether to impose an administrative fine and when deciding on the amount of the administrative fine in each individual case, all relevant circumstances of the specific situation shall be taken into account and due regard shall be given to the following:\n(a) the nature, gravity and duration of the infringement and of its consequences, taking into account the purpose of the AI system concerned, as well as, where appropriate, the number of affected persons and the level of damage suffered by them;\n(b) the degree of responsibility of the Union institution, body, office or agency, taking into account technical and organisational measures implemented by them;\n(c) any action taken by the Union institution, body, office or agency to mitigate the damage suffered by affected persons;\n(d) the degree of cooperation with the European Data Protection Supervisor in order to remedy the infringement and mitigate the possible adverse effects of the infringement, including compliance with any of the measures previously ordered by the European Data Protection Supervisor against the Union institution, body, office or agency concerned with regard to the same subject matter;\n(e) any similar previous infringements by the Union institution, body, office or agency;\n(f) the manner in which the infringement became known to the European Data Protection Supervisor, in particular whether, and if so to what extent, the Union institution, body, office or agency notified the infringement;\n(g) the annual budget of the Union institution, body, office or agency.\n\n2. Non-compliance with the prohibition of the AI practices referred to in Article 5 shall be subject to administrative fines of up to EUR 1500000.\n\n3. The non-compliance of the AI system with any requirements or obligations under this Regulation, other than those laid down in Article 5, shall be subject to administrative fines of up to EUR 750000.\n\n4. Before taking decisions pursuant to this Article, the European Data Protection Supervisor shall give the Union institution, body, office or agency which is the subject of the proceedings conducted by the European Data Protection Supervisor the opportunity of being heard on the matter regarding the possible infringement. The European Data Protection Supervisor shall base his or her decisions only on elements and circumstances on which the parties concerned have been able to comment. Complainants, if any, shall be associated closely with the proceedings.\n\n5. The rights of defence of the parties concerned shall be fully respected in the proceedings. They shall be entitled to have access to the European Data Protection Supervisor’s file, subject to the legitimate interest of individuals or undertakings in the protection of their personal data or business secrets.\n\n6. Funds collected by imposition of fines in this Article shall contribute to the general budget of the Union. The fines shall not affect the effective operation of the Union institution, body, office or agency fined.\n\n7. The European Data Protection Supervisor shall, on an annual basis, notify the Commission of the administrative fines it has imposed pursuant to this Article and of any litigation or judicial proceedings it has initiated.", article: 100, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100"};
MERGE (n:Provision {id: "art_100__para_1"})
  SET n += {eid: "art_100__para_1", citation: "Art. 100(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1", chunk_type: "paragraph", level: "para", text: "The European Data Protection Supervisor may impose administrative fines on Union institutions, bodies, offices and agencies falling within the scope of this Regulation. When deciding whether to impose an administrative fine and when deciding on the amount of the administrative fine in each individual case, all relevant circumstances of the specific situation shall be taken into account and due regard shall be given to the following:\n(a) the nature, gravity and duration of the infringement and of its consequences, taking into account the purpose of the AI system concerned, as well as, where appropriate, the number of affected persons and the level of damage suffered by them;\n(b) the degree of responsibility of the Union institution, body, office or agency, taking into account technical and organisational measures implemented by them;\n(c) any action taken by the Union institution, body, office or agency to mitigate the damage suffered by affected persons;\n(d) the degree of cooperation with the European Data Protection Supervisor in order to remedy the infringement and mitigate the possible adverse effects of the infringement, including compliance with any of the measures previously ordered by the European Data Protection Supervisor against the Union institution, body, office or agency concerned with regard to the same subject matter;\n(e) any similar previous infringements by the Union institution, body, office or agency;\n(f) the manner in which the infringement became known to the European Data Protection Supervisor, in particular whether, and if so to what extent, the Union institution, body, office or agency notified the infringement;\n(g) the annual budget of the Union institution, body, office or agency.", article: 100, paragraph: 1, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)"};
MERGE (n:Provision {id: "art_100__para_1__point_a"})
  SET n += {eid: "art_100__para_1__point_a", citation: "Art. 100(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1__point_a", chunk_type: "point", level: "point", text: "the nature, gravity and duration of the infringement and of its consequences, taking into account the purpose of the AI system concerned, as well as, where appropriate, the number of affected persons and the level of damage suffered by them", article: 100, paragraph: 1, point: "a", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)(a)"};
MERGE (n:Provision {id: "art_100__para_1__point_b"})
  SET n += {eid: "art_100__para_1__point_b", citation: "Art. 100(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1__point_b", chunk_type: "point", level: "point", text: "the degree of responsibility of the Union institution, body, office or agency, taking into account technical and organisational measures implemented by them", article: 100, paragraph: 1, point: "b", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)(b)"};
MERGE (n:Provision {id: "art_100__para_1__point_c"})
  SET n += {eid: "art_100__para_1__point_c", citation: "Art. 100(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1__point_c", chunk_type: "point", level: "point", text: "any action taken by the Union institution, body, office or agency to mitigate the damage suffered by affected persons", article: 100, paragraph: 1, point: "c", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)(c)"};
MERGE (n:Provision {id: "art_100__para_1__point_d"})
  SET n += {eid: "art_100__para_1__point_d", citation: "Art. 100(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1__point_d", chunk_type: "point", level: "point", text: "the degree of cooperation with the European Data Protection Supervisor in order to remedy the infringement and mitigate the possible adverse effects of the infringement, including compliance with any of the measures previously ordered by the European Data Protection Supervisor against the Union institution, body, office or agency concerned with regard to the same subject matter", article: 100, paragraph: 1, point: "d", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)(d)"};
MERGE (n:Provision {id: "art_100__para_1__point_e"})
  SET n += {eid: "art_100__para_1__point_e", citation: "Art. 100(1)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1__point_e", chunk_type: "point", level: "point", text: "any similar previous infringements by the Union institution, body, office or agency", article: 100, paragraph: 1, point: "e", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)(e)"};
MERGE (n:Provision {id: "art_100__para_1__point_f"})
  SET n += {eid: "art_100__para_1__point_f", citation: "Art. 100(1)(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1__point_f", chunk_type: "point", level: "point", text: "the manner in which the infringement became known to the European Data Protection Supervisor, in particular whether, and if so to what extent, the Union institution, body, office or agency notified the infringement", article: 100, paragraph: 1, point: "f", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)(f)"};
MERGE (n:Provision {id: "art_100__para_1__point_g"})
  SET n += {eid: "art_100__para_1__point_g", citation: "Art. 100(1)(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_1__point_g", chunk_type: "point", level: "point", text: "the annual budget of the Union institution, body, office or agency", article: 100, paragraph: 1, point: "g", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(1)(g)"};
MERGE (n:Provision {id: "art_100__para_2"})
  SET n += {eid: "art_100__para_2", citation: "Art. 100(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_2", chunk_type: "paragraph", level: "para", text: "Non-compliance with the prohibition of the AI practices referred to in Article 5 shall be subject to administrative fines of up to EUR 1500000.", article: 100, paragraph: 2, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(2)"};
MERGE (n:Provision {id: "art_100__para_3"})
  SET n += {eid: "art_100__para_3", citation: "Art. 100(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_3", chunk_type: "paragraph", level: "para", text: "The non-compliance of the AI system with any requirements or obligations under this Regulation, other than those laid down in Article 5, shall be subject to administrative fines of up to EUR 750000.", article: 100, paragraph: 3, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(3)"};
MERGE (n:Provision {id: "art_100__para_4"})
  SET n += {eid: "art_100__para_4", citation: "Art. 100(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_4", chunk_type: "paragraph", level: "para", text: "Before taking decisions pursuant to this Article, the European Data Protection Supervisor shall give the Union institution, body, office or agency which is the subject of the proceedings conducted by the European Data Protection Supervisor the opportunity of being heard on the matter regarding the possible infringement. The European Data Protection Supervisor shall base his or her decisions only on elements and circumstances on which the parties concerned have been able to comment. Complainants, if any, shall be associated closely with the proceedings.", article: 100, paragraph: 4, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(4)"};
MERGE (n:Provision {id: "art_100__para_5"})
  SET n += {eid: "art_100__para_5", citation: "Art. 100(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_5", chunk_type: "paragraph", level: "para", text: "The rights of defence of the parties concerned shall be fully respected in the proceedings. They shall be entitled to have access to the European Data Protection Supervisor’s file, subject to the legitimate interest of individuals or undertakings in the protection of their personal data or business secrets.", article: 100, paragraph: 5, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(5)"};
MERGE (n:Provision {id: "art_100__para_6"})
  SET n += {eid: "art_100__para_6", citation: "Art. 100(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_6", chunk_type: "paragraph", level: "para", text: "Funds collected by imposition of fines in this Article shall contribute to the general budget of the Union. The fines shall not affect the effective operation of the Union institution, body, office or agency fined.", article: 100, paragraph: 6, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(6)"};
MERGE (n:Provision {id: "art_100__para_7"})
  SET n += {eid: "art_100__para_7", citation: "Art. 100(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_100__para_7", chunk_type: "paragraph", level: "para", text: "The European Data Protection Supervisor shall, on an annual basis, notify the Commission of the administrative fines it has imposed pursuant to this Article and of any litigation or judicial proceedings it has initiated.", article: 100, paragraph: 7, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 100(7)"};
MERGE (n:Provision {id: "art_101"})
  SET n += {eid: "art_101", citation: "Art. 101", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101", chunk_type: "article_full", level: "art", text: "Article 101 — Fines for providers of general-purpose AI models\n\n1. The Commission may impose on providers of general-purpose AI models fines not exceeding 3 % of their annual total worldwide turnover in the preceding financial year or EUR 15000000, whichever is higher., when the Commission finds that the provider intentionally or negligently:\n(a) infringed the relevant provisions of this Regulation;\n(b) failed to comply with a request for a document or for information pursuant to Article 91, or supplied incorrect, incomplete or misleading information;\n(c) failed to comply with a measure requested under Article 93;\n(d) failed to make available to the Commission access to the general-purpose AI model or general-purpose AI model with systemic risk with a view to conducting an evaluation pursuant to Article 92.\nIn fixing the amount of the fine or periodic penalty payment, regard shall be had to the nature, gravity and duration of the infringement, taking due account of the principles of proportionality and appropriateness. The Commission shall also into account commitments made in accordance with Article 93(3) or made in relevant codes of practice in accordance with Article 56.\n\n2. Before adopting the decision pursuant to paragraph 1, the Commission shall communicate its preliminary findings to the provider of the general-purpose AI model and give it an opportunity to be heard.\n\n3. Fines imposed in accordance with this Article shall be effective, proportionate and dissuasive.\n\n4. Information on fines imposed under this Article shall also be communicated to the Board as appropriate.\n\n5. The Court of Justice of the European Union shall have unlimited jurisdiction to review decisions of the Commission fixing a fine under this Article. It may cancel, reduce or increase the fine imposed.\n\n6. The Commission shall adopt implementing acts containing detailed arrangements and procedural safeguards for proceedings in view of the possible adoption of decisions pursuant to paragraph 1 of this Article. Those implementing acts shall be adopted in accordance with the examination procedure referred to in Article 98(2).", article: 101, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101"};
MERGE (n:Provision {id: "art_101__para_1"})
  SET n += {eid: "art_101__para_1", citation: "Art. 101(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_1", chunk_type: "paragraph", level: "para", text: "The Commission may impose on providers of general-purpose AI models fines not exceeding 3 % of their annual total worldwide turnover in the preceding financial year or EUR 15000000, whichever is higher., when the Commission finds that the provider intentionally or negligently:\n(a) infringed the relevant provisions of this Regulation;\n(b) failed to comply with a request for a document or for information pursuant to Article 91, or supplied incorrect, incomplete or misleading information;\n(c) failed to comply with a measure requested under Article 93;\n(d) failed to make available to the Commission access to the general-purpose AI model or general-purpose AI model with systemic risk with a view to conducting an evaluation pursuant to Article 92.\nIn fixing the amount of the fine or periodic penalty payment, regard shall be had to the nature, gravity and duration of the infringement, taking due account of the principles of proportionality and appropriateness. The Commission shall also into account commitments made in accordance with Article 93(3) or made in relevant codes of practice in accordance with Article 56.", article: 101, paragraph: 1, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(1)"};
MERGE (n:Provision {id: "art_101__para_1__point_a"})
  SET n += {eid: "art_101__para_1__point_a", citation: "Art. 101(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_1__point_a", chunk_type: "point", level: "point", text: "infringed the relevant provisions of this Regulation", article: 101, paragraph: 1, point: "a", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(1)(a)"};
MERGE (n:Provision {id: "art_101__para_1__point_b"})
  SET n += {eid: "art_101__para_1__point_b", citation: "Art. 101(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_1__point_b", chunk_type: "point", level: "point", text: "failed to comply with a request for a document or for information pursuant to Article 91, or supplied incorrect, incomplete or misleading information", article: 101, paragraph: 1, point: "b", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(1)(b)"};
MERGE (n:Provision {id: "art_101__para_1__point_c"})
  SET n += {eid: "art_101__para_1__point_c", citation: "Art. 101(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_1__point_c", chunk_type: "point", level: "point", text: "failed to comply with a measure requested under Article 93", article: 101, paragraph: 1, point: "c", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(1)(c)"};
MERGE (n:Provision {id: "art_101__para_1__point_d"})
  SET n += {eid: "art_101__para_1__point_d", citation: "Art. 101(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_1__point_d", chunk_type: "point", level: "point", text: "failed to make available to the Commission access to the general-purpose AI model or general-purpose AI model with systemic risk with a view to conducting an evaluation pursuant to Article 92.\nIn fixing the amount of the fine or periodic penalty payment, regard shall be had to the nature, gravity and duration of the infringement, taking due account of the principles of proportionality and appropriateness. The Commission shall also into account commitments made in accordance with Article 93(3) or made in relevant codes of practice in accordance with Article 56", article: 101, paragraph: 1, point: "d", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(1)(d)"};
MERGE (n:Provision {id: "art_101__para_2"})
  SET n += {eid: "art_101__para_2", citation: "Art. 101(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_2", chunk_type: "paragraph", level: "para", text: "Before adopting the decision pursuant to paragraph 1, the Commission shall communicate its preliminary findings to the provider of the general-purpose AI model and give it an opportunity to be heard.", article: 101, paragraph: 2, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(2)"};
MERGE (n:Provision {id: "art_101__para_3"})
  SET n += {eid: "art_101__para_3", citation: "Art. 101(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_3", chunk_type: "paragraph", level: "para", text: "Fines imposed in accordance with this Article shall be effective, proportionate and dissuasive.", article: 101, paragraph: 3, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(3)"};
MERGE (n:Provision {id: "art_101__para_4"})
  SET n += {eid: "art_101__para_4", citation: "Art. 101(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_4", chunk_type: "paragraph", level: "para", text: "Information on fines imposed under this Article shall also be communicated to the Board as appropriate.", article: 101, paragraph: 4, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(4)"};
MERGE (n:Provision {id: "art_101__para_5"})
  SET n += {eid: "art_101__para_5", citation: "Art. 101(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_5", chunk_type: "paragraph", level: "para", text: "The Court of Justice of the European Union shall have unlimited jurisdiction to review decisions of the Commission fixing a fine under this Article. It may cancel, reduce or increase the fine imposed.", article: 101, paragraph: 5, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(5)"};
MERGE (n:Provision {id: "art_101__para_6"})
  SET n += {eid: "art_101__para_6", citation: "Art. 101(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_101__para_6", chunk_type: "paragraph", level: "para", text: "The Commission shall adopt implementing acts containing detailed arrangements and procedural safeguards for proceedings in view of the possible adoption of decisions pursuant to paragraph 1 of this Article. Those implementing acts shall be adopted in accordance with the examination procedure referred to in Article 98(2).", article: 101, paragraph: 6, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 101(6)"};
MERGE (n:Provision {id: "art_102"})
  SET n += {eid: "art_102", citation: "Art. 102", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_102", chunk_type: "article_full", level: "art", text: "Article 102 — Amendment to Regulation (EC) No 300/2008\n\nIn Article 4(3) of Regulation (EC) No 300/2008, the following subparagraph is added:“When adopting detailed measures related to technical specifications and procedures for approval and use of security equipment concerning Artificial Intelligence systems within the meaning of Regulation (EU) 2024/1689 of the European Parliament and of the Council, the requirements set out in Chapter III, Section 2, of that Regulation shall be taken into account.", article: 102, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 102"};
MERGE (n:Provision {id: "art_103"})
  SET n += {eid: "art_103", citation: "Art. 103", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_103", chunk_type: "article_full", level: "art", text: "Article 103 — Amendment to Regulation (EU) No 167/2013\n\nIn Article 17(5) of Regulation (EU) No 167/2013, the following subparagraph is added:“When adopting delegated acts pursuant to the first subparagraph concerning artificial intelligence systems which are safety components within the meaning of Regulation (EU) 2024/1689 of the European Parliament and of the Council, the requirements set out in Chapter III, Section 2, of that Regulation shall be taken into account.", article: 103, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 103"};
MERGE (n:Provision {id: "art_104"})
  SET n += {eid: "art_104", citation: "Art. 104", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_104", chunk_type: "article_full", level: "art", text: "Article 104 — Amendment to Regulation (EU) No 168/2013\n\nIn Article 22(5) of Regulation (EU) No 168/2013, the following subparagraph is added:“When adopting delegated acts pursuant to the first subparagraph concerning Artificial Intelligence systems which are safety components within the meaning of Regulation (EU) 2024/1689 of the European Parliament and of the Council, the requirements set out in Chapter III, Section 2, of that Regulation shall be taken into account.", article: 104, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 104"};
MERGE (n:Provision {id: "art_105"})
  SET n += {eid: "art_105", citation: "Art. 105", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_105", chunk_type: "article_full", level: "art", text: "Article 105 — Amendment to Directive 2014/90/EU\n\nIn Article 8 of Directive 2014/90/EU, the following paragraph is added:“5. For Artificial Intelligence systems which are safety components within the meaning of Regulation (EU) 2024/1689 of the European Parliament and of the Council, when carrying out its activities pursuant to paragraph 1 and when adopting technical specifications and testing standards in accordance with paragraphs 2 and 3, the Commission shall take into account the requirements set out in Chapter III, Section 2, of that Regulation.", article: 105, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 105"};
MERGE (n:Provision {id: "art_106"})
  SET n += {eid: "art_106", citation: "Art. 106", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_106", chunk_type: "article_full", level: "art", text: "Article 106 — Amendment to Directive (EU) 2016/797\n\nIn Article 5 of Directive (EU) 2016/797, the following paragraph is added:“12. When adopting delegated acts pursuant to paragraph 1 and implementing acts pursuant to paragraph 11 concerning Artificial Intelligence systems which are safety components within the meaning of Regulation (EU) 2024/1689 of the European Parliament and of the Council, the requirements set out in Chapter III, Section 2, of that Regulation shall be taken into account.", article: 106, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 106"};
MERGE (n:Provision {id: "art_107"})
  SET n += {eid: "art_107", citation: "Art. 107", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_107", chunk_type: "article_full", level: "art", text: "Article 107 — Amendment to Regulation (EU) 2018/858\n\nIn Article 5 of Regulation (EU) 2018/858 the following paragraph is added:“4. When adopting delegated acts pursuant to paragraph 3 concerning Artificial Intelligence systems which are safety components within the meaning of Regulation (EU) 2024/1689 of the European Parliament and of the Council, the requirements set out in Chapter III, Section 2, of that Regulation shall be taken into account.", article: 107, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 107"};
MERGE (n:Provision {id: "art_108"})
  SET n += {eid: "art_108", citation: "Art. 108", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_108", chunk_type: "article_full", level: "art", text: "Article 108 — Amendments to Regulation (EU) 2018/1139\n\nRegulation (EU) 2018/1139 is amended as follows:\n(1) in Article 17, the following paragraph is added:\n(2) in Article 19, the following paragraph is added:\n(3) in Article 43, the following paragraph is added:\n(4) in Article 47, the following paragraph is added:\n(5) in Article 57, the following subparagraph is added:\n(6) in Article 58, the following paragraph is added:", article: 108, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 108"};
MERGE (n:Provision {id: "art_109"})
  SET n += {eid: "art_109", citation: "Art. 109", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_109", chunk_type: "article_full", level: "art", text: "Article 109 — Amendment to Regulation (EU) 2019/2144\n\nIn Article 11 of Regulation (EU) 2019/2144, the following paragraph is added:“3. When adopting the implementing acts pursuant to paragraph 2, concerning artificial intelligence systems which are safety components within the meaning of Regulation (EU) 2024/1689 of the European Parliament and of the Council, the requirements set out in Chapter III, Section 2, of that Regulation shall be taken into account.", article: 109, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 109"};
MERGE (n:Provision {id: "art_110"})
  SET n += {eid: "art_110", citation: "Art. 110", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_110", chunk_type: "article_full", level: "art", text: "Article 110 — Amendment to Directive (EU) 2020/1828\n\nIn Annex I to Directive (EU) 2020/1828 of the European Parliament and of the Council, the following point is added:\nRegulation (EU) 2024/1689 of the European Parliament and of the Council of 13 June 2024 laying down harmonised rules on artificial intelligence and amending Regulations (EC) No 300/2008, (EU) No 167/2013, (EU) No 168/2013, (EU) 2018/858, (EU) 2018/1139 and (EU) 2019/2144 and Directives 2014/90/EU, (EU) 2016/797 and (EU) 2020/1828 (Artificial Intelligence Act) (OJ L, 2024/1689, 12.7.2024, ELI: http://data.europa.eu/eli/reg/2024/1689/oj).”.", article: 110, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 110"};
MERGE (n:Provision {id: "art_111"})
  SET n += {eid: "art_111", citation: "Art. 111", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_111", chunk_type: "article_full", level: "art", text: "Article 111 — AI systems already placed on the market or put into service and general-purpose AI models already placed on the marked\n\n1. Without prejudice to the application of Article 5 as referred to in Article 113(3), point (a), AI systems which are components of the large-scale IT systems established by the legal acts listed in Annex X that have been placed on the market or put into service before 2 August 2027 shall be brought into compliance with this Regulation by 31 December 2030. The requirements laid down in this Regulation shall be taken into account in the evaluation of each large-scale IT system established by the legal acts listed in Annex X to be undertaken as provided for in those legal acts and where those legal acts are replaced or amended.\n\n2. Without prejudice to the application of Article 5 as referred to in Article 113(3), point (a), this Regulation shall apply to operators of high-risk AI systems, other than the systems referred to in paragraph 1 of this Article, that have been placed on the market or put into service before 2 August 2026, only if, as from that date, those systems are subject to significant changes in their designs. In any case, the providers and deployers of high-risk AI systems intended to be used by public authorities shall take the necessary steps to comply with the requirements and obligations of this Regulation by 2 August 2030.\n\n3. Providers of general-purpose AI models that have been placed on the market before 2 August 2025 shall take the necessary steps in order to comply with the obligations laid down in this Regulation by 2 August 2027.", article: 111, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", transitional: true, name: "Art. 111"};
MERGE (n:Provision {id: "art_111__para_1"})
  SET n += {eid: "art_111__para_1", citation: "Art. 111(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_111__para_1", chunk_type: "paragraph", level: "para", text: "Without prejudice to the application of Article 5 as referred to in Article 113(3), point (a), AI systems which are components of the large-scale IT systems established by the legal acts listed in Annex X that have been placed on the market or put into service before 2 August 2027 shall be brought into compliance with this Regulation by 31 December 2030. The requirements laid down in this Regulation shall be taken into account in the evaluation of each large-scale IT system established by the legal acts listed in Annex X to be undertaken as provided for in those legal acts and where those legal acts are replaced or amended.", article: 111, paragraph: 1, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", transitional: true, name: "Art. 111(1)"};
MERGE (n:Provision {id: "art_111__para_1__point_a"})
  SET n += {eid: "art_111__para_1__point_a", citation: "Art. 111(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_111__para_1__point_a", chunk_type: "point", level: "point", text: ", AI systems which are components of the large-scale IT systems established by the legal acts listed in Annex X that have been placed on the market or put into service before 2 August 2027 shall be brought into compliance with this Regulation by 31 December 2030. The requirements laid down in this Regulation shall be taken into account in the evaluation of each large-scale IT system established by the legal acts listed in Annex X to be undertaken as provided for in those legal acts and where those legal acts are replaced or amended", article: 111, paragraph: 1, point: "a", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 111(1)(a)"};
MERGE (n:Provision {id: "art_111__para_2"})
  SET n += {eid: "art_111__para_2", citation: "Art. 111(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_111__para_2", chunk_type: "paragraph", level: "para", text: "Without prejudice to the application of Article 5 as referred to in Article 113(3), point (a), this Regulation shall apply to operators of high-risk AI systems, other than the systems referred to in paragraph 1 of this Article, that have been placed on the market or put into service before 2 August 2026, only if, as from that date, those systems are subject to significant changes in their designs. In any case, the providers and deployers of high-risk AI systems intended to be used by public authorities shall take the necessary steps to comply with the requirements and obligations of this Regulation by 2 August 2030.", article: 111, paragraph: 2, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", transitional: true, name: "Art. 111(2)"};
MERGE (n:Provision {id: "art_111__para_2__point_a"})
  SET n += {eid: "art_111__para_2__point_a", citation: "Art. 111(2)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_111__para_2__point_a", chunk_type: "point", level: "point", text: ", this Regulation shall apply to operators of high-risk AI systems, other than the systems referred to in paragraph 1 of this Article, that have been placed on the market or put into service before 2 August 2026, only if, as from that date, those systems are subject to significant changes in their designs. In any case, the providers and deployers of high-risk AI systems intended to be used by public authorities shall take the necessary steps to comply with the requirements and obligations of this Regulation by 2 August 2030", article: 111, paragraph: 2, point: "a", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 111(2)(a)"};
MERGE (n:Provision {id: "art_111__para_3"})
  SET n += {eid: "art_111__para_3", citation: "Art. 111(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_111__para_3", chunk_type: "paragraph", level: "para", text: "Providers of general-purpose AI models that have been placed on the market before 2 August 2025 shall take the necessary steps in order to comply with the obligations laid down in this Regulation by 2 August 2027.", article: 111, paragraph: 3, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", transitional: true, name: "Art. 111(3)"};
MERGE (n:Provision {id: "art_112"})
  SET n += {eid: "art_112", citation: "Art. 112", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112", chunk_type: "article_full", level: "art", text: "Article 112 — Evaluation and review\n\n1. The Commission shall assess the need for amendment of the list set out in Annex III and of the list of prohibited AI practices laid down in Article 5, once a year following the entry into force of this Regulation, and until the end of the period of the delegation of power laid down in Article 97. The Commission shall submit the findings of that assessment to the European Parliament and the Council.\n\n2. By 2 August 2028 and every four years thereafter, the Commission shall evaluate and report to the European Parliament and to the Council on the following:\n(a) the need for amendments extending existing area headings or adding new area headings in Annex III;\n(b) amendments to the list of AI systems requiring additional transparency measures in Article 50;\n(c) amendments enhancing the effectiveness of the supervision and governance system.\n\n3. By 2 August 2029 and every four years thereafter, the Commission shall submit a report on the evaluation and review of this Regulation to the European Parliament and to the Council. The report shall include an assessment with regard to the structure of enforcement and the possible need for a Union agency to resolve any identified shortcomings. On the basis of the findings, that report shall, where appropriate, be accompanied by a proposal for amendment of this Regulation. The reports shall be made public.\n\n4. The reports referred to in paragraph 2 shall pay specific attention to the following:\n(a) the status of the financial, technical and human resources of the national competent authorities in order to effectively perform the tasks assigned to them under this Regulation;\n(b) the state of penalties, in particular administrative fines as referred to in Article 99(1), applied by Member States for infringements of this Regulation;\n(c) adopted harmonised standards and common specifications developed to support this Regulation;\n(d) the number of undertakings that enter the market after the entry into application of this Regulation, and how many of them are SMEs.\n\n5. By 2 August 2028, the Commission shall evaluate the functioning of the AI Office, whether the AI Office has been given sufficient powers and competences to fulfil its tasks, and whether it would be relevant and needed for the proper implementation and enforcement of this Regulation to upgrade the AI Office and its enforcement competences and to increase its resources. The Commission shall submit a report on its evaluation to the European Parliament and to the Council.\n\n6. By 2 August 2028 and every four years thereafter, the Commission shall submit a report on the review of the progress on the development of standardisation deliverables on the energy-efficient development of general-purpose AI models, and asses the need for further measures or actions, including binding measures or actions. The report shall be submitted to the European Parliament and to the Council, and it shall be made public.\n\n7. By 2 August 2028 and every three years thereafter, the Commission shall evaluate the impact and effectiveness of voluntary codes of conduct to foster the application of the requirements set out in Chapter III, Section 2 for AI systems other than high-risk AI systems and possibly other additional requirements for AI systems other than high-risk AI systems, including as regards environmental sustainability.\n\n8. For the purposes of paragraphs 1 to 7, the Board, the Member States and national competent authorities shall provide the Commission with information upon its request and without undue delay.\n\n9. In carrying out the evaluations and reviews referred to in paragraphs 1 to 7, the Commission shall take into account the positions and findings of the Board, of the European Parliament, of the Council, and of other relevant bodies or sources.\n\n10. The Commission shall, if necessary, submit appropriate proposals to amend this Regulation, in particular taking into account developments in technology, the effect of AI systems on health and safety, and on fundamental rights, and in light of the state of progress in the information society.\n\n11. To guide the evaluations and reviews referred to in paragraphs 1 to 7 of this Article, the AI Office shall undertake to develop an objective and participative methodology for the evaluation of risk levels based on the criteria outlined in the relevant Articles and the inclusion of new systems in:\n(a) the list set out in Annex III, including the extension of existing area headings or the addition of new area headings in that Annex;\n(b) the list of prohibited practices set out in Article 5; and\n(c) the list of AI systems requiring additional transparency measures pursuant to Article 50.\n\n12. Any amendment to this Regulation pursuant to paragraph 10, or relevant delegated or implementing acts, which concerns sectoral Union harmonisation legislation listed in Section B of Annex I shall take into account the regulatory specificities of each sector, and the existing governance, conformity assessment and enforcement mechanisms and authorities established therein.\n\n13. By 2 August 2031, the Commission shall carry out an assessment of the enforcement of this Regulation and shall report on it to the European Parliament, the Council and the European Economic and Social Committee, taking into account the first years of application of this Regulation. On the basis of the findings, that report shall, where appropriate, be accompanied by a proposal for amendment of this Regulation with regard to the structure of enforcement and the need for a Union agency to resolve any identified shortcomings.", article: 112, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112"};
MERGE (n:Provision {id: "art_112__para_1"})
  SET n += {eid: "art_112__para_1", citation: "Art. 112(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall assess the need for amendment of the list set out in Annex III and of the list of prohibited AI practices laid down in Article 5, once a year following the entry into force of this Regulation, and until the end of the period of the delegation of power laid down in Article 97. The Commission shall submit the findings of that assessment to the European Parliament and the Council.", article: 112, paragraph: 1, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(1)"};
MERGE (n:Provision {id: "art_112__para_2"})
  SET n += {eid: "art_112__para_2", citation: "Art. 112(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_2", chunk_type: "paragraph", level: "para", text: "By 2 August 2028 and every four years thereafter, the Commission shall evaluate and report to the European Parliament and to the Council on the following:\n(a) the need for amendments extending existing area headings or adding new area headings in Annex III;\n(b) amendments to the list of AI systems requiring additional transparency measures in Article 50;\n(c) amendments enhancing the effectiveness of the supervision and governance system.", article: 112, paragraph: 2, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(2)"};
MERGE (n:Provision {id: "art_112__para_2__point_a"})
  SET n += {eid: "art_112__para_2__point_a", citation: "Art. 112(2)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_2__point_a", chunk_type: "point", level: "point", text: "the need for amendments extending existing area headings or adding new area headings in Annex III", article: 112, paragraph: 2, point: "a", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(2)(a)"};
MERGE (n:Provision {id: "art_112__para_2__point_b"})
  SET n += {eid: "art_112__para_2__point_b", citation: "Art. 112(2)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_2__point_b", chunk_type: "point", level: "point", text: "amendments to the list of AI systems requiring additional transparency measures in Article 50", article: 112, paragraph: 2, point: "b", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(2)(b)"};
MERGE (n:Provision {id: "art_112__para_2__point_c"})
  SET n += {eid: "art_112__para_2__point_c", citation: "Art. 112(2)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_2__point_c", chunk_type: "point", level: "point", text: "amendments enhancing the effectiveness of the supervision and governance system", article: 112, paragraph: 2, point: "c", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(2)(c)"};
MERGE (n:Provision {id: "art_112__para_3"})
  SET n += {eid: "art_112__para_3", citation: "Art. 112(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_3", chunk_type: "paragraph", level: "para", text: "By 2 August 2029 and every four years thereafter, the Commission shall submit a report on the evaluation and review of this Regulation to the European Parliament and to the Council. The report shall include an assessment with regard to the structure of enforcement and the possible need for a Union agency to resolve any identified shortcomings. On the basis of the findings, that report shall, where appropriate, be accompanied by a proposal for amendment of this Regulation. The reports shall be made public.", article: 112, paragraph: 3, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(3)"};
MERGE (n:Provision {id: "art_112__para_4"})
  SET n += {eid: "art_112__para_4", citation: "Art. 112(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_4", chunk_type: "paragraph", level: "para", text: "The reports referred to in paragraph 2 shall pay specific attention to the following:\n(a) the status of the financial, technical and human resources of the national competent authorities in order to effectively perform the tasks assigned to them under this Regulation;\n(b) the state of penalties, in particular administrative fines as referred to in Article 99(1), applied by Member States for infringements of this Regulation;\n(c) adopted harmonised standards and common specifications developed to support this Regulation;\n(d) the number of undertakings that enter the market after the entry into application of this Regulation, and how many of them are SMEs.", article: 112, paragraph: 4, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(4)"};
MERGE (n:Provision {id: "art_112__para_4__point_a"})
  SET n += {eid: "art_112__para_4__point_a", citation: "Art. 112(4)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_4__point_a", chunk_type: "point", level: "point", text: "the status of the financial, technical and human resources of the national competent authorities in order to effectively perform the tasks assigned to them under this Regulation", article: 112, paragraph: 4, point: "a", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(4)(a)"};
MERGE (n:Provision {id: "art_112__para_4__point_b"})
  SET n += {eid: "art_112__para_4__point_b", citation: "Art. 112(4)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_4__point_b", chunk_type: "point", level: "point", text: "the state of penalties, in particular administrative fines as referred to in Article 99(1), applied by Member States for infringements of this Regulation", article: 112, paragraph: 4, point: "b", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(4)(b)"};
MERGE (n:Provision {id: "art_112__para_4__point_c"})
  SET n += {eid: "art_112__para_4__point_c", citation: "Art. 112(4)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_4__point_c", chunk_type: "point", level: "point", text: "adopted harmonised standards and common specifications developed to support this Regulation", article: 112, paragraph: 4, point: "c", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(4)(c)"};
MERGE (n:Provision {id: "art_112__para_4__point_d"})
  SET n += {eid: "art_112__para_4__point_d", citation: "Art. 112(4)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_4__point_d", chunk_type: "point", level: "point", text: "the number of undertakings that enter the market after the entry into application of this Regulation, and how many of them are SMEs", article: 112, paragraph: 4, point: "d", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(4)(d)"};
MERGE (n:Provision {id: "art_112__para_5"})
  SET n += {eid: "art_112__para_5", citation: "Art. 112(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_5", chunk_type: "paragraph", level: "para", text: "By 2 August 2028, the Commission shall evaluate the functioning of the AI Office, whether the AI Office has been given sufficient powers and competences to fulfil its tasks, and whether it would be relevant and needed for the proper implementation and enforcement of this Regulation to upgrade the AI Office and its enforcement competences and to increase its resources. The Commission shall submit a report on its evaluation to the European Parliament and to the Council.", article: 112, paragraph: 5, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(5)"};
MERGE (n:Provision {id: "art_112__para_6"})
  SET n += {eid: "art_112__para_6", citation: "Art. 112(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_6", chunk_type: "paragraph", level: "para", text: "By 2 August 2028 and every four years thereafter, the Commission shall submit a report on the review of the progress on the development of standardisation deliverables on the energy-efficient development of general-purpose AI models, and asses the need for further measures or actions, including binding measures or actions. The report shall be submitted to the European Parliament and to the Council, and it shall be made public.", article: 112, paragraph: 6, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(6)"};
MERGE (n:Provision {id: "art_112__para_7"})
  SET n += {eid: "art_112__para_7", citation: "Art. 112(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_7", chunk_type: "paragraph", level: "para", text: "By 2 August 2028 and every three years thereafter, the Commission shall evaluate the impact and effectiveness of voluntary codes of conduct to foster the application of the requirements set out in Chapter III, Section 2 for AI systems other than high-risk AI systems and possibly other additional requirements for AI systems other than high-risk AI systems, including as regards environmental sustainability.", article: 112, paragraph: 7, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(7)"};
MERGE (n:Provision {id: "art_112__para_8"})
  SET n += {eid: "art_112__para_8", citation: "Art. 112(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_8", chunk_type: "paragraph", level: "para", text: "For the purposes of paragraphs 1 to 7, the Board, the Member States and national competent authorities shall provide the Commission with information upon its request and without undue delay.", article: 112, paragraph: 8, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(8)"};
MERGE (n:Provision {id: "art_112__para_9"})
  SET n += {eid: "art_112__para_9", citation: "Art. 112(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_9", chunk_type: "paragraph", level: "para", text: "In carrying out the evaluations and reviews referred to in paragraphs 1 to 7, the Commission shall take into account the positions and findings of the Board, of the European Parliament, of the Council, and of other relevant bodies or sources.", article: 112, paragraph: 9, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(9)"};
MERGE (n:Provision {id: "art_112__para_10"})
  SET n += {eid: "art_112__para_10", citation: "Art. 112(10)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_10", chunk_type: "paragraph", level: "para", text: "The Commission shall, if necessary, submit appropriate proposals to amend this Regulation, in particular taking into account developments in technology, the effect of AI systems on health and safety, and on fundamental rights, and in light of the state of progress in the information society.", article: 112, paragraph: 10, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(10)"};
MERGE (n:Provision {id: "art_112__para_11"})
  SET n += {eid: "art_112__para_11", citation: "Art. 112(11)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_11", chunk_type: "paragraph", level: "para", text: "To guide the evaluations and reviews referred to in paragraphs 1 to 7 of this Article, the AI Office shall undertake to develop an objective and participative methodology for the evaluation of risk levels based on the criteria outlined in the relevant Articles and the inclusion of new systems in:\n(a) the list set out in Annex III, including the extension of existing area headings or the addition of new area headings in that Annex;\n(b) the list of prohibited practices set out in Article 5; and\n(c) the list of AI systems requiring additional transparency measures pursuant to Article 50.", article: 112, paragraph: 11, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(11)"};
MERGE (n:Provision {id: "art_112__para_11__point_a"})
  SET n += {eid: "art_112__para_11__point_a", citation: "Art. 112(11)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_11__point_a", chunk_type: "point", level: "point", text: "the list set out in Annex III, including the extension of existing area headings or the addition of new area headings in that Annex", article: 112, paragraph: 11, point: "a", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(11)(a)"};
MERGE (n:Provision {id: "art_112__para_11__point_b"})
  SET n += {eid: "art_112__para_11__point_b", citation: "Art. 112(11)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_11__point_b", chunk_type: "point", level: "point", text: "the list of prohibited practices set out in Article 5; and", article: 112, paragraph: 11, point: "b", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(11)(b)"};
MERGE (n:Provision {id: "art_112__para_11__point_c"})
  SET n += {eid: "art_112__para_11__point_c", citation: "Art. 112(11)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_11__point_c", chunk_type: "point", level: "point", text: "the list of AI systems requiring additional transparency measures pursuant to Article 50", article: 112, paragraph: 11, point: "c", chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(11)(c)"};
MERGE (n:Provision {id: "art_112__para_12"})
  SET n += {eid: "art_112__para_12", citation: "Art. 112(12)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_12", chunk_type: "paragraph", level: "para", text: "Any amendment to this Regulation pursuant to paragraph 10, or relevant delegated or implementing acts, which concerns sectoral Union harmonisation legislation listed in Section B of Annex I shall take into account the regulatory specificities of each sector, and the existing governance, conformity assessment and enforcement mechanisms and authorities established therein.", article: 112, paragraph: 12, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(12)"};
MERGE (n:Provision {id: "art_112__para_13"})
  SET n += {eid: "art_112__para_13", citation: "Art. 112(13)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_112__para_13", chunk_type: "paragraph", level: "para", text: "By 2 August 2031, the Commission shall carry out an assessment of the enforcement of this Regulation and shall report on it to the European Parliament, the Council and the European Economic and Social Committee, taking into account the first years of application of this Regulation. On the basis of the findings, that report shall, where appropriate, be accompanied by a proposal for amendment of this Regulation with regard to the structure of enforcement and the need for a Union agency to resolve any identified shortcomings.", article: 112, paragraph: 13, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 112(13)"};
MERGE (n:Provision {id: "art_113"})
  SET n += {eid: "art_113", citation: "Art. 113", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_113", chunk_type: "article_full", level: "art", text: "Article 113 — Entry into force and application\n\nThis Regulation shall enter into force on the twentieth day following that of its publication in the Official Journal of the European Union.\n\nIt shall apply from 2 August 2026.\n\nHowever:\n(a) Chapters I and II shall apply from 2 February 2025;\n(b) Chapter III Section 4, Chapter V, Chapter VII and Chapter XII and Article 78 shall apply from 2 August 2025, with the exception of Article 101;\n(c) Article 6(1) and the corresponding obligations in this Regulation shall apply from 2 August 2027.", article: 113, chapter: 13, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 113"};
MERGE (n:AnnexPoint {id: "annex_I__point_s1"})
  SET n += {eid: "annex_I__point_s1", citation: "Annex I(s1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_I__point_s1", chunk_type: "annex_item", level: "point", text: "Annex I — List of Union harmonisation legislation\nSection A. List of Union harmonisation legislation based on the New Legislative Framework\n\n1. Directive 2006/42/EC of the European Parliament and of the Council of 17 May 2006 on machinery, and amending Directive 95/16/EC (OJ L 157, 9.6.2006, p. 24); 2. Directive 2009/48/EC of the European Parliament and of the Council of 18 June 2009 on the safety of toys (OJ L 170, 30.6.2009, p. 1); 3. Directive 2013/53/EU of the European Parliament and of the Council of 20 November 2013 on recreational craft and personal watercraft and repealing Directive 94/25/EC (OJ L 354, 28.12.2013, p. 90); 4. Directive 2014/33/EU of the European Parliament and of the Council of 26 February 2014 on the harmonisation of the laws of the Member States relating to lifts and safety components for lifts (OJ L 96, 29.3.2014, p. 251); 5. Directive 2014/34/EU of the European Parliament and of the Council of 26 February 2014 on the harmonisation of the laws of the Member States relating to equipment and protective systems intended for use in potentially explosive atmospheres (OJ L 96, 29.3.2014, p. 309); 6. Directive 2014/53/EU of the European Parliament and of the Council of 16 April 2014 on the harmonisation of the laws of the Member States relating to the making available on the market of radio equipment and repealing Directive 1999/5/EC (OJ L 153, 22.5.2014, p. 62); 7. Directive 2014/68/EU of the European Parliament and of the Council of 15 May 2014 on the harmonisation of the laws of the Member States relating to the making available on the market of pressure equipment (OJ L 189, 27.6.2014, p. 164); 8. Regulation (EU) 2016/424 of the European Parliament and of the Council of 9 March 2016 on cableway installations and repealing Directive 2000/9/EC (OJ L 81, 31.3.2016, p. 1); 9. Regulation (EU) 2016/425 of the European Parliament and of the Council of 9 March 2016 on personal protective equipment and repealing Council Directive 89/686/EEC (OJ L 81, 31.3.2016, p. 51); 10. Regulation (EU) 2016/426 of the European Parliament and of the Council of 9 March 2016 on appliances burning gaseous fuels and repealing Directive 2009/142/EC (OJ L 81, 31.3.2016, p. 99); 11. Regulation (EU) 2017/745 of the European Parliament and of the Council of 5 April 2017 on medical devices, amending Directive 2001/83/EC, Regulation (EC) No 178/2002 and Regulation (EC) No 1223/2009 and repealing Council Directives 90/385/EEC and 93/42/EEC (OJ L 117, 5.5.2017, p. 1); 12. Regulation (EU) 2017/746 of the European Parliament and of the Council of 5 April 2017 on in vitro diagnostic medical devices and repealing Directive 98/79/EC and Commission Decision 2010/227/EU (OJ L 117, 5.5.2017, p. 176).", point: "s1", annex: "I", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex I(s1)"};
MERGE (n:AnnexPoint {id: "annex_I__point_s2"})
  SET n += {eid: "annex_I__point_s2", citation: "Annex I(s2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_I__point_s2", chunk_type: "annex_item", level: "point", text: "Annex I — List of Union harmonisation legislation\nSection B. List of other Union harmonisation legislation\n\n13. Regulation (EC) No 300/2008 of the European Parliament and of the Council of 11 March 2008 on common rules in the field of civil aviation security and repealing Regulation (EC) No 2320/2002 (OJ L 97, 9.4.2008, p. 72); 14. Regulation (EU) No 168/2013 of the European Parliament and of the Council of 15 January 2013 on the approval and market surveillance of two- or three-wheel vehicles and quadricycles (OJ L 60, 2.3.2013, p. 52); 15. Regulation (EU) No 167/2013 of the European Parliament and of the Council of 5 February 2013 on the approval and market surveillance of agricultural and forestry vehicles (OJ L 60, 2.3.2013, p. 1); 16. Directive 2014/90/EU of the European Parliament and of the Council of 23 July 2014 on marine equipment and repealing Council Directive 96/98/EC (OJ L 257, 28.8.2014, p. 146); 17. Directive (EU) 2016/797 of the European Parliament and of the Council of 11 May 2016 on the interoperability of the rail system within the European Union (OJ L 138, 26.5.2016, p. 44); 18. Regulation (EU) 2018/858 of the European Parliament and of the Council of 30 May 2018 on the approval and market surveillance of motor vehicles and their trailers, and of systems, components and separate technical units intended for such vehicles, amending Regulations (EC) No 715/2007 and (EC) No 595/2009 and repealing Directive 2007/46/EC (OJ L 151, 14.6.2018, p. 1); 19. Regulation (EU) 2019/2144 of the European Parliament and of the Council of 27 November 2019 on type-approval requirements for motor vehicles and their trailers, and systems, components and separate technical units intended for such vehicles, as regards their general safety and the protection of vehicle occupants and vulnerable road users, amending Regulation (EU) 2018/858 of the European Parliament and of the Council and repealing Regulations (EC) No 78/2009, (EC) No 79/2009 and (EC) No 661/2009 of the European Parliament and of the Council and Commission Regulations (EC) No 631/2009, (EU) No 406/2010, (EU) No 672/2010, (EU) No 1003/2010, (EU) No 1005/2010, (EU) No 1008/2010, (EU) No 1009/2010, (EU) No 19/2011, (EU) No 109/2011, (EU) No 458/2011, (EU) No 65/2012, (EU) No 130/2012, (EU) No 347/2012, (EU) No 351/2012, (EU) No 1230/2012 and (EU) 2015/166 (OJ L 325, 16.12.2019, p. 1); 20. Regulation (EU) 2018/1139 of the European Parliament and of the Council of 4 July 2018 on common rules in the field of civil aviation and establishing a European Union Aviation Safety Agency, and amending Regulations (EC) No 2111/2005, (EC) No 1008/2008, (EU) No 996/2010, (EU) No 376/2014 and Directives 2014/30/EU and 2014/53/EU of the European Parliament and of the Council, and repealing Regulations (EC) No 552/2004 and (EC) No 216/2008 of the European Parliament and of the Council and Council Regulation (EEC) No 3922/91 (OJ L 212, 22.8.2018, p. 1), in so far as the design, production and placing on the market of aircrafts referred to in Article 2(1), points (a) and (b) thereof, where it concerns unmanned aircraft and their engines, propellers, parts and equipment to control them remotely, are concerned.", point: "s2", annex: "I", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex I(s2)"};
MERGE (n:AnnexPoint {id: "annex_II__point_s1"})
  SET n += {eid: "annex_II__point_s1", citation: "Annex II(s1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_II__point_s1", chunk_type: "annex_item", level: "point", text: "Annex II — List of criminal offences referred to in Article 5(1), first subparagraph, point (h)(iii)\nList of criminal offences referred to in Article 5(1), first subparagraph, point (h)(iii)\n\nCriminal offences referred to in Article 5(1), first subparagraph, point (h)(iii):terrorism,trafficking in human beings,sexual exploitation of children, and child pornography,illicit trafficking in narcotic drugs or psychotropic substances,illicit trafficking in weapons, munitions or explosives,murder, grievous bodily injury,illicit trade in human organs or tissue,illicit trafficking in nuclear or radioactive materials,kidnapping, illegal restraint or hostage-taking,crimes within the jurisdiction of the International Criminal Court,unlawful seizure of aircraft or ships,rape,environmental crime,organised or armed robbery,sabotage,participation in a criminal organisation involved in one or more of the offences listed above.", point: "s1", annex: "II", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex II(s1)"};
MERGE (n:AnnexPoint {id: "annex_III__point_1"})
  SET n += {eid: "annex_III__point_1", citation: "Annex III point 1", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_1", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 1: Biometrics, in so far as their use is permitted under relevant Union or national law:\n\n1. Biometrics, in so far as their use is permitted under relevant Union or national law:(a) remote biometric identification systems.This shall not include AI systems intended to be used for biometric verification the sole purpose of which is to confirm that a specific natural person is the person he or she claims to be;(b) AI systems intended to be used for biometric categorisation, according to sensitive or protected attributes or characteristics based on the inference of those attributes or characteristics;(c) AI systems intended to be used for emotion recognition.", annex: "III", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 1"};
MERGE (n:AnnexPoint {id: "annex_III__point_1__point_a"})
  SET n += {eid: "annex_III__point_1__point_a", citation: "Annex III point 1(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_1__point_a", chunk_type: "annex_subpoint", level: "point", text: "remote biometric identification systems.This shall not include AI systems intended to be used for biometric verification the sole purpose of which is to confirm that a specific natural person is the person he or she claims to be", point: "a", annex: "III", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 1(a)"};
MERGE (n:AnnexPoint {id: "annex_III__point_1__point_b"})
  SET n += {eid: "annex_III__point_1__point_b", citation: "Annex III point 1(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_1__point_b", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used for biometric categorisation, according to sensitive or protected attributes or characteristics based on the inference of those attributes or characteristics", point: "b", annex: "III", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 1(b)"};
MERGE (n:AnnexPoint {id: "annex_III__point_1__point_c"})
  SET n += {eid: "annex_III__point_1__point_c", citation: "Annex III point 1(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_1__point_c", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used for emotion recognition", point: "c", annex: "III", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 1(c)"};
MERGE (n:AnnexPoint {id: "annex_III__point_2"})
  SET n += {eid: "annex_III__point_2", citation: "Annex III point 2", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_2", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 2: Critical infrastructure: AI systems intended to be used as safety components in the management and operation of critical digital infrastructure, road traffic, or in the supply of water, gas, heating or electricity.\n\n2. Critical infrastructure: AI systems intended to be used as safety components in the management and operation of critical digital infrastructure, road traffic, or in the supply of water, gas, heating or electricity.", annex: "III", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 2"};
MERGE (n:AnnexPoint {id: "annex_III__point_3"})
  SET n += {eid: "annex_III__point_3", citation: "Annex III point 3", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_3", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 3: Education and vocational training:\n\n3. Education and vocational training:(a) AI systems intended to be used to determine access or admission or to assign natural persons to educational and vocational training institutions at all levels;(b) AI systems intended to be used to evaluate learning outcomes, including when those outcomes are used to steer the learning process of natural persons in educational and vocational training institutions at all levels;(c) AI systems intended to be used for the purpose of assessing the appropriate level of education that an individual will receive or will be able to access, in the context of or within educational and vocational training institutions at all levels;(d) AI systems intended to be used for monitoring and detecting prohibited behaviour of students during tests in the context of or within educational and vocational training institutions at all levels.", annex: "III", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 3"};
MERGE (n:AnnexPoint {id: "annex_III__point_3__point_a"})
  SET n += {eid: "annex_III__point_3__point_a", citation: "Annex III point 3(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_3__point_a", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used to determine access or admission or to assign natural persons to educational and vocational training institutions at all levels", point: "a", annex: "III", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 3(a)"};
MERGE (n:AnnexPoint {id: "annex_III__point_3__point_b"})
  SET n += {eid: "annex_III__point_3__point_b", citation: "Annex III point 3(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_3__point_b", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used to evaluate learning outcomes, including when those outcomes are used to steer the learning process of natural persons in educational and vocational training institutions at all levels", point: "b", annex: "III", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 3(b)"};
MERGE (n:AnnexPoint {id: "annex_III__point_3__point_c"})
  SET n += {eid: "annex_III__point_3__point_c", citation: "Annex III point 3(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_3__point_c", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used for the purpose of assessing the appropriate level of education that an individual will receive or will be able to access, in the context of or within educational and vocational training institutions at all levels", point: "c", annex: "III", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 3(c)"};
MERGE (n:AnnexPoint {id: "annex_III__point_3__point_d"})
  SET n += {eid: "annex_III__point_3__point_d", citation: "Annex III point 3(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_3__point_d", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used for monitoring and detecting prohibited behaviour of students during tests in the context of or within educational and vocational training institutions at all levels", point: "d", annex: "III", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 3(d)"};
MERGE (n:AnnexPoint {id: "annex_III__point_4"})
  SET n += {eid: "annex_III__point_4", citation: "Annex III point 4", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_4", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 4: Employment, workers’ management and access to self-employment:\n\n4. Employment, workers’ management and access to self-employment:(a) AI systems intended to be used for the recruitment or selection of natural persons, in particular to place targeted job advertisements, to analyse and filter job applications, and to evaluate candidates;(b) AI systems intended to be used to make decisions affecting terms of work-related relationships, the promotion or termination of work-related contractual relationships, to allocate tasks based on individual behaviour or personal traits or characteristics or to monitor and evaluate the performance and behaviour of persons in such relationships.", annex: "III", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 4"};
MERGE (n:AnnexPoint {id: "annex_III__point_4__point_a"})
  SET n += {eid: "annex_III__point_4__point_a", citation: "Annex III point 4(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_4__point_a", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used for the recruitment or selection of natural persons, in particular to place targeted job advertisements, to analyse and filter job applications, and to evaluate candidates", point: "a", annex: "III", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 4(a)"};
MERGE (n:AnnexPoint {id: "annex_III__point_4__point_b"})
  SET n += {eid: "annex_III__point_4__point_b", citation: "Annex III point 4(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_4__point_b", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used to make decisions affecting terms of work-related relationships, the promotion or termination of work-related contractual relationships, to allocate tasks based on individual behaviour or personal traits or characteristics or to monitor and evaluate the performance and behaviour of persons in such relationships", point: "b", annex: "III", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 4(b)"};
MERGE (n:AnnexPoint {id: "annex_III__point_5"})
  SET n += {eid: "annex_III__point_5", citation: "Annex III point 5", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_5", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 5: Access to and enjoyment of essential private services and essential public services and benefits:\n\n5. Access to and enjoyment of essential private services and essential public services and benefits:(a) AI systems intended to be used by public authorities or on behalf of public authorities to evaluate the eligibility of natural persons for essential public assistance benefits and services, including healthcare services, as well as to grant, reduce, revoke, or reclaim such benefits and services;(b) AI systems intended to be used to evaluate the creditworthiness of natural persons or establish their credit score, with the exception of AI systems used for the purpose of detecting financial fraud;(c) AI systems intended to be used for risk assessment and pricing in relation to natural persons in the case of life and health insurance;(d) AI systems intended to evaluate and classify emergency calls by natural persons or to be used to dispatch, or to establish priority in the dispatching of, emergency first response services, including by police, firefighters and medical aid, as well as of emergency healthcare patient triage systems.", annex: "III", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 5"};
MERGE (n:AnnexPoint {id: "annex_III__point_5__point_a"})
  SET n += {eid: "annex_III__point_5__point_a", citation: "Annex III point 5(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_5__point_a", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by public authorities or on behalf of public authorities to evaluate the eligibility of natural persons for essential public assistance benefits and services, including healthcare services, as well as to grant, reduce, revoke, or reclaim such benefits and services", point: "a", annex: "III", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 5(a)"};
MERGE (n:AnnexPoint {id: "annex_III__point_5__point_b"})
  SET n += {eid: "annex_III__point_5__point_b", citation: "Annex III point 5(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_5__point_b", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used to evaluate the creditworthiness of natural persons or establish their credit score, with the exception of AI systems used for the purpose of detecting financial fraud", point: "b", annex: "III", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 5(b)"};
MERGE (n:AnnexPoint {id: "annex_III__point_5__point_c"})
  SET n += {eid: "annex_III__point_5__point_c", citation: "Annex III point 5(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_5__point_c", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used for risk assessment and pricing in relation to natural persons in the case of life and health insurance", point: "c", annex: "III", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 5(c)"};
MERGE (n:AnnexPoint {id: "annex_III__point_5__point_d"})
  SET n += {eid: "annex_III__point_5__point_d", citation: "Annex III point 5(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_5__point_d", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to evaluate and classify emergency calls by natural persons or to be used to dispatch, or to establish priority in the dispatching of, emergency first response services, including by police, firefighters and medical aid, as well as of emergency healthcare patient triage systems", point: "d", annex: "III", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 5(d)"};
MERGE (n:AnnexPoint {id: "annex_III__point_6"})
  SET n += {eid: "annex_III__point_6", citation: "Annex III point 6", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_6", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 6: Law enforcement, in so far as their use is permitted under relevant Union or national law:\n\n6. Law enforcement, in so far as their use is permitted under relevant Union or national law:(a) AI systems intended to be used by or on behalf of law enforcement authorities, or by Union institutions, bodies, offices or agencies in support of law enforcement authorities or on their behalf to assess the risk of a natural person becoming the victim of criminal offences;(b) AI systems intended to be used by or on behalf of law enforcement authorities or by Union institutions, bodies, offices or agencies in support of law enforcement authorities as polygraphs or similar tools;(c) AI systems intended to be used by or on behalf of law enforcement authorities, or by Union institutions, bodies, offices or agencies, in support of law enforcement authorities to evaluate the reliability of evidence in the course of the investigation or prosecution of criminal offences;(d) AI systems intended to be used by law enforcement authorities or on their behalf or by Union institutions, bodies, offices or agencies in support of law enforcement authorities for assessing the risk of a natural person offending or re-offending not solely on the basis of the profiling of natural persons as referred to in Article 3(4) of Directive (EU) 2016/680, or to assess personality traits and characteristics or past criminal behaviour of natural persons or groups;(e) AI systems intended to be used by or on behalf of law enforcement authorities or by Union institutions, bodies, offices or agencies in support of law enforcement authorities for the profiling of natural persons as referred to in Article 3(4) of Directive (EU) 2016/680 in the course of the detection, investigation or prosecution of criminal offences.", annex: "III", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 6"};
MERGE (n:AnnexPoint {id: "annex_III__point_6__point_a"})
  SET n += {eid: "annex_III__point_6__point_a", citation: "Annex III point 6(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_6__point_a", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of law enforcement authorities, or by Union institutions, bodies, offices or agencies in support of law enforcement authorities or on their behalf to assess the risk of a natural person becoming the victim of criminal offences", point: "a", annex: "III", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 6(a)"};
MERGE (n:AnnexPoint {id: "annex_III__point_6__point_b"})
  SET n += {eid: "annex_III__point_6__point_b", citation: "Annex III point 6(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_6__point_b", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of law enforcement authorities or by Union institutions, bodies, offices or agencies in support of law enforcement authorities as polygraphs or similar tools", point: "b", annex: "III", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 6(b)"};
MERGE (n:AnnexPoint {id: "annex_III__point_6__point_c"})
  SET n += {eid: "annex_III__point_6__point_c", citation: "Annex III point 6(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_6__point_c", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of law enforcement authorities, or by Union institutions, bodies, offices or agencies, in support of law enforcement authorities to evaluate the reliability of evidence in the course of the investigation or prosecution of criminal offences", point: "c", annex: "III", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 6(c)"};
MERGE (n:AnnexPoint {id: "annex_III__point_6__point_d"})
  SET n += {eid: "annex_III__point_6__point_d", citation: "Annex III point 6(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_6__point_d", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by law enforcement authorities or on their behalf or by Union institutions, bodies, offices or agencies in support of law enforcement authorities for assessing the risk of a natural person offending or re-offending not solely on the basis of the profiling of natural persons as referred to in Article 3(4) of Directive (EU) 2016/680, or to assess personality traits and characteristics or past criminal behaviour of natural persons or groups", point: "d", annex: "III", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 6(d)"};
MERGE (n:AnnexPoint {id: "annex_III__point_6__point_e"})
  SET n += {eid: "annex_III__point_6__point_e", citation: "Annex III point 6(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_6__point_e", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of law enforcement authorities or by Union institutions, bodies, offices or agencies in support of law enforcement authorities for the profiling of natural persons as referred to in Article 3(4) of Directive (EU) 2016/680 in the course of the detection, investigation or prosecution of criminal offences", point: "e", annex: "III", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 6(e)"};
MERGE (n:AnnexPoint {id: "annex_III__point_7"})
  SET n += {eid: "annex_III__point_7", citation: "Annex III point 7", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_7", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 7: Migration, asylum and border control management, in so far as their use is permitted under relevant Union or national law:\n\n7. Migration, asylum and border control management, in so far as their use is permitted under relevant Union or national law:(a) AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies as polygraphs or similar tools;(b) AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies to assess a risk, including a security risk, a risk of irregular migration, or a health risk, posed by a natural person who intends to enter or who has entered into the territory of a Member State;(c) AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies to assist competent public authorities for the examination of applications for asylum, visa or residence permits and for associated complaints with regard to the eligibility of the natural persons applying for a status, including related assessments of the reliability of evidence;(d) AI systems intended to be used by or on behalf of competent public authorities, or by Union institutions, bodies, offices or agencies, in the context of migration, asylum or border control management, for the purpose of detecting, recognising or identifying natural persons, with the exception of the verification of travel documents.", annex: "III", annex_point: 7, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 7"};
MERGE (n:AnnexPoint {id: "annex_III__point_7__point_a"})
  SET n += {eid: "annex_III__point_7__point_a", citation: "Annex III point 7(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_7__point_a", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies as polygraphs or similar tools", point: "a", annex: "III", annex_point: 7, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 7(a)"};
MERGE (n:AnnexPoint {id: "annex_III__point_7__point_b"})
  SET n += {eid: "annex_III__point_7__point_b", citation: "Annex III point 7(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_7__point_b", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies to assess a risk, including a security risk, a risk of irregular migration, or a health risk, posed by a natural person who intends to enter or who has entered into the territory of a Member State", point: "b", annex: "III", annex_point: 7, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 7(b)"};
MERGE (n:AnnexPoint {id: "annex_III__point_7__point_c"})
  SET n += {eid: "annex_III__point_7__point_c", citation: "Annex III point 7(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_7__point_c", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies to assist competent public authorities for the examination of applications for asylum, visa or residence permits and for associated complaints with regard to the eligibility of the natural persons applying for a status, including related assessments of the reliability of evidence", point: "c", annex: "III", annex_point: 7, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 7(c)"};
MERGE (n:AnnexPoint {id: "annex_III__point_7__point_d"})
  SET n += {eid: "annex_III__point_7__point_d", citation: "Annex III point 7(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_7__point_d", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by or on behalf of competent public authorities, or by Union institutions, bodies, offices or agencies, in the context of migration, asylum or border control management, for the purpose of detecting, recognising or identifying natural persons, with the exception of the verification of travel documents", point: "d", annex: "III", annex_point: 7, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 7(d)"};
MERGE (n:AnnexPoint {id: "annex_III__point_8"})
  SET n += {eid: "annex_III__point_8", citation: "Annex III point 8", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_8", chunk_type: "annex_item", level: "point", text: "Annex III — High-risk AI systems referred to in Article 6(2)\nPoint 8: Administration of justice and democratic processes:\n\n8. Administration of justice and democratic processes:(a) AI systems intended to be used by a judicial authority or on their behalf to assist a judicial authority in researching and interpreting facts and the law and in applying the law to a concrete set of facts, or to be used in a similar way in alternative dispute resolution;(b) AI systems intended to be used for influencing the outcome of an election or referendum or the voting behaviour of natural persons in the exercise of their vote in elections or referenda. This does not include AI systems to the output of which natural persons are not directly exposed, such as tools used to organise, optimise or structure political campaigns from an administrative or logistical point of view.", annex: "III", annex_point: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 8"};
MERGE (n:AnnexPoint {id: "annex_III__point_8__point_a"})
  SET n += {eid: "annex_III__point_8__point_a", citation: "Annex III point 8(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_8__point_a", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used by a judicial authority or on their behalf to assist a judicial authority in researching and interpreting facts and the law and in applying the law to a concrete set of facts, or to be used in a similar way in alternative dispute resolution", point: "a", annex: "III", annex_point: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 8(a)"};
MERGE (n:AnnexPoint {id: "annex_III__point_8__point_b"})
  SET n += {eid: "annex_III__point_8__point_b", citation: "Annex III point 8(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_III__point_8__point_b", chunk_type: "annex_subpoint", level: "point", text: "AI systems intended to be used for influencing the outcome of an election or referendum or the voting behaviour of natural persons in the exercise of their vote in elections or referenda. This does not include AI systems to the output of which natural persons are not directly exposed, such as tools used to organise, optimise or structure political campaigns from an administrative or logistical point of view", point: "b", annex: "III", annex_point: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex III point 8(b)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1"})
  SET n += {eid: "annex_IV__point_1", citation: "Annex IV point 1", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 1: A general description of the AI system including:\n\n1. A general description of the AI system including:(a) its intended purpose, the name of the provider and the version of the system reflecting its relation to previous versions;(b) how the AI system interacts with, or can be used to interact with, hardware or software, including with other AI systems, that are not part of the AI system itself, where applicable;(c) the versions of relevant software or firmware, and any requirements related to version updates;(d) the description of all the forms in which the AI system is placed on the market or put into service, such as software packages embedded into hardware, downloads, or APIs;(e) the description of the hardware on which the AI system is intended to run;(f) where the AI system is a component of products, photographs or illustrations showing external features, the marking and internal layout of those products;(g) a basic description of the user-interface provided to the deployer;(h) instructions for use for the deployer, and a basic description of the user-interface provided to the deployer, where applicable;", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_a"})
  SET n += {eid: "annex_IV__point_1__point_a", citation: "Annex IV point 1(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_a", chunk_type: "annex_subpoint", level: "point", text: "its intended purpose, the name of the provider and the version of the system reflecting its relation to previous versions", point: "a", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(a)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_b"})
  SET n += {eid: "annex_IV__point_1__point_b", citation: "Annex IV point 1(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_b", chunk_type: "annex_subpoint", level: "point", text: "how the AI system interacts with, or can be used to interact with, hardware or software, including with other AI systems, that are not part of the AI system itself, where applicable", point: "b", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(b)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_c"})
  SET n += {eid: "annex_IV__point_1__point_c", citation: "Annex IV point 1(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_c", chunk_type: "annex_subpoint", level: "point", text: "the versions of relevant software or firmware, and any requirements related to version updates", point: "c", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(c)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_d"})
  SET n += {eid: "annex_IV__point_1__point_d", citation: "Annex IV point 1(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_d", chunk_type: "annex_subpoint", level: "point", text: "the description of all the forms in which the AI system is placed on the market or put into service, such as software packages embedded into hardware, downloads, or APIs", point: "d", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(d)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_e"})
  SET n += {eid: "annex_IV__point_1__point_e", citation: "Annex IV point 1(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_e", chunk_type: "annex_subpoint", level: "point", text: "the description of the hardware on which the AI system is intended to run", point: "e", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(e)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_f"})
  SET n += {eid: "annex_IV__point_1__point_f", citation: "Annex IV point 1(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_f", chunk_type: "annex_subpoint", level: "point", text: "where the AI system is a component of products, photographs or illustrations showing external features, the marking and internal layout of those products", point: "f", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(f)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_g"})
  SET n += {eid: "annex_IV__point_1__point_g", citation: "Annex IV point 1(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_g", chunk_type: "annex_subpoint", level: "point", text: "a basic description of the user-interface provided to the deployer", point: "g", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(g)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_1__point_h"})
  SET n += {eid: "annex_IV__point_1__point_h", citation: "Annex IV point 1(h)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_1__point_h", chunk_type: "annex_subpoint", level: "point", text: "instructions for use for the deployer, and a basic description of the user-interface provided to the deployer, where applicable", point: "h", annex: "IV", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 1(h)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2"})
  SET n += {eid: "annex_IV__point_2", citation: "Annex IV point 2", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 2: A detailed description of the elements of the AI system and of the process for its development, including:\n\n2. A detailed description of the elements of the AI system and of the process for its development, including:(a) the methods and steps performed for the development of the AI system, including, where relevant, recourse to pre-trained systems or tools provided by third parties and how those were used, integrated or modified by the provider;(b) the design specifications of the system, namely the general logic of the AI system and of the algorithms; the key design choices including the rationale and assumptions made, including with regard to persons or groups of persons in respect of who, the system is intended to be used; the main classification choices; what the system is designed to optimise for, and the relevance of the different parameters; the description of the expected output and output quality of the system; the decisions about any possible trade-off made regarding the technical solutions adopted to comply with the requirements set out in Chapter III, Section 2;(c) the description of the system architecture explaining how software components build on or feed into each other and integrate into the overall processing; the computational resources used to develop, train, test and validate the AI system;(d) where relevant, the data requirements in terms of datasheets describing the training methodologies and techniques and the training data sets used, including a general description of these data sets, information about their provenance, scope and main characteristics; how the data was obtained and selected; labelling procedures (e.g. for supervised learning), data cleaning methodologies (e.g. outliers detection);(e) assessment of the human oversight measures needed in accordance with Article 14, including an assessment of the technical measures needed to facilitate the interpretation of the outputs of AI systems by the deployers, in accordance with Article 13(3), point (d);(f) where applicable, a detailed description of pre-determined changes to the AI system and its performance, together with all the relevant information related to the technical solutions adopted to ensure continuous compliance of the AI system with the relevant requirements set out in Chapter III, Section 2;(g) the validation and testing procedures used, including information about the validation and testing data used and their main characteristics; metrics used to measure accuracy, robustness and compliance with other relevant requirements set out in Chapter III, Section 2, as well as potentially discriminatory impacts; test logs and all test reports dated and signed by the responsible persons, including with regard to pre-determined changes as referred to under point (f);(h) cybersecurity measures put in place;", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_a"})
  SET n += {eid: "annex_IV__point_2__point_a", citation: "Annex IV point 2(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_a", chunk_type: "annex_subpoint", level: "point", text: "the methods and steps performed for the development of the AI system, including, where relevant, recourse to pre-trained systems or tools provided by third parties and how those were used, integrated or modified by the provider", point: "a", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(a)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_b"})
  SET n += {eid: "annex_IV__point_2__point_b", citation: "Annex IV point 2(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_b", chunk_type: "annex_subpoint", level: "point", text: "the design specifications of the system, namely the general logic of the AI system and of the algorithms; the key design choices including the rationale and assumptions made, including with regard to persons or groups of persons in respect of who, the system is intended to be used; the main classification choices; what the system is designed to optimise for, and the relevance of the different parameters; the description of the expected output and output quality of the system; the decisions about any possible trade-off made regarding the technical solutions adopted to comply with the requirements set out in Chapter III, Section 2", point: "b", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(b)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_c"})
  SET n += {eid: "annex_IV__point_2__point_c", citation: "Annex IV point 2(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_c", chunk_type: "annex_subpoint", level: "point", text: "the description of the system architecture explaining how software components build on or feed into each other and integrate into the overall processing; the computational resources used to develop, train, test and validate the AI system", point: "c", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(c)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_d"})
  SET n += {eid: "annex_IV__point_2__point_d", citation: "Annex IV point 2(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_d", chunk_type: "annex_subpoint", level: "point", text: "where relevant, the data requirements in terms of datasheets describing the training methodologies and techniques and the training data sets used, including a general description of these data sets, information about their provenance, scope and main characteristics; how the data was obtained and selected; labelling procedures (e.g. for supervised learning), data cleaning methodologies (e.g. outliers detection)", point: "d", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(d)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_e"})
  SET n += {eid: "annex_IV__point_2__point_e", citation: "Annex IV point 2(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_e", chunk_type: "annex_subpoint", level: "point", text: "assessment of the human oversight measures needed in accordance with Article 14, including an assessment of the technical measures needed to facilitate the interpretation of the outputs of AI systems by the deployers, in accordance with Article 13(3), point (d)", point: "e", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(e)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_f"})
  SET n += {eid: "annex_IV__point_2__point_f", citation: "Annex IV point 2(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_f", chunk_type: "annex_subpoint", level: "point", text: "where applicable, a detailed description of pre-determined changes to the AI system and its performance, together with all the relevant information related to the technical solutions adopted to ensure continuous compliance of the AI system with the relevant requirements set out in Chapter III, Section 2", point: "f", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(f)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_g"})
  SET n += {eid: "annex_IV__point_2__point_g", citation: "Annex IV point 2(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_g", chunk_type: "annex_subpoint", level: "point", text: "the validation and testing procedures used, including information about the validation and testing data used and their main characteristics; metrics used to measure accuracy, robustness and compliance with other relevant requirements set out in Chapter III, Section 2, as well as potentially discriminatory impacts; test logs and all test reports dated and signed by the responsible persons, including with regard to pre-determined changes as referred to under point (f)", point: "g", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(g)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_2__point_h"})
  SET n += {eid: "annex_IV__point_2__point_h", citation: "Annex IV point 2(h)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_2__point_h", chunk_type: "annex_subpoint", level: "point", text: "cybersecurity measures put in place", point: "h", annex: "IV", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 2(h)"};
MERGE (n:AnnexPoint {id: "annex_IV__point_3"})
  SET n += {eid: "annex_IV__point_3", citation: "Annex IV point 3", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_3", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 3: Detailed information about the monitoring, functioning and control of the AI system, in particular with regard to: its capabilities and limitations in performance, including the degrees of accuracy for specific persons or groups of persons on which the system is intended to be used and the overall expected level of accuracy in relation to its intended purpose; the foreseeable unintended outcomes and sources of risks to health and safety, fundamental rights and discrimination in view of the intended purpose of the AI system; the human oversight measures needed in accordance with Article 14, including the technical measures put in place to facilitate the interpretation of the outputs of AI systems by the deployers; specifications on input data, as appropriate;\n\n3. Detailed information about the monitoring, functioning and control of the AI system, in particular with regard to: its capabilities and limitations in performance, including the degrees of accuracy for specific persons or groups of persons on which the system is intended to be used and the overall expected level of accuracy in relation to its intended purpose; the foreseeable unintended outcomes and sources of risks to health and safety, fundamental rights and discrimination in view of the intended purpose of the AI system; the human oversight measures needed in accordance with Article 14, including the technical measures put in place to facilitate the interpretation of the outputs of AI systems by the deployers; specifications on input data, as appropriate;", annex: "IV", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 3"};
MERGE (n:AnnexPoint {id: "annex_IV__point_4"})
  SET n += {eid: "annex_IV__point_4", citation: "Annex IV point 4", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_4", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 4: A description of the appropriateness of the performance metrics for the specific AI system;\n\n4. A description of the appropriateness of the performance metrics for the specific AI system;", annex: "IV", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 4"};
MERGE (n:AnnexPoint {id: "annex_IV__point_5"})
  SET n += {eid: "annex_IV__point_5", citation: "Annex IV point 5", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_5", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 5: A detailed description of the risk management system in accordance with Article 9;\n\n5. A detailed description of the risk management system in accordance with Article 9;", annex: "IV", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 5"};
MERGE (n:AnnexPoint {id: "annex_IV__point_6"})
  SET n += {eid: "annex_IV__point_6", citation: "Annex IV point 6", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_6", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 6: A description of relevant changes made by the provider to the system through its lifecycle;\n\n6. A description of relevant changes made by the provider to the system through its lifecycle;", annex: "IV", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 6"};
MERGE (n:AnnexPoint {id: "annex_IV__point_7"})
  SET n += {eid: "annex_IV__point_7", citation: "Annex IV point 7", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_7", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 7: A list of the harmonised standards applied in full or in part the references of which have been published in the Official Journal of the European Union; where no such harmonised standards have been applied, a detailed description of the solutions adopted to meet the requirements set out in Chapter III, Section 2, including a list of other relevant standards and technical specifications applied;\n\n7. A list of the harmonised standards applied in full or in part the references of which have been published in the Official Journal of the European Union; where no such harmonised standards have been applied, a detailed description of the solutions adopted to meet the requirements set out in Chapter III, Section 2, including a list of other relevant standards and technical specifications applied;", annex: "IV", annex_point: 7, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 7"};
MERGE (n:AnnexPoint {id: "annex_IV__point_8"})
  SET n += {eid: "annex_IV__point_8", citation: "Annex IV point 8", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_8", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 8: A copy of the EU declaration of conformity referred to in Article 47;\n\n8. A copy of the EU declaration of conformity referred to in Article 47;", annex: "IV", annex_point: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 8"};
MERGE (n:AnnexPoint {id: "annex_IV__point_9"})
  SET n += {eid: "annex_IV__point_9", citation: "Annex IV point 9", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IV__point_9", chunk_type: "annex_item", level: "point", text: "Annex IV — Technical documentation referred to in Article 11(1)\nPoint 9: A detailed description of the system in place to evaluate the AI system performance in the post-market phase in accordance with Article 72, including the post-market monitoring plan referred to in Article 72(3).\n\n9. A detailed description of the system in place to evaluate the AI system performance in the post-market phase in accordance with Article 72, including the post-market monitoring plan referred to in Article 72(3).", annex: "IV", annex_point: 9, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IV point 9"};
MERGE (n:AnnexPoint {id: "annex_V__point_1"})
  SET n += {eid: "annex_V__point_1", citation: "Annex V point 1", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_1", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 1: AI system name and type and any additional unambiguous reference allowing the identification and traceability of the AI system;\n\n1. AI system name and type and any additional unambiguous reference allowing the identification and traceability of the AI system;", annex: "V", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 1"};
MERGE (n:AnnexPoint {id: "annex_V__point_2"})
  SET n += {eid: "annex_V__point_2", citation: "Annex V point 2", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_2", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 2: The name and address of the provider or, where applicable, of their authorised representative;\n\n2. The name and address of the provider or, where applicable, of their authorised representative;", annex: "V", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 2"};
MERGE (n:AnnexPoint {id: "annex_V__point_3"})
  SET n += {eid: "annex_V__point_3", citation: "Annex V point 3", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_3", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 3: A statement that the EU declaration of conformity referred to in Article 47 is issued under the sole responsibility of the provider;\n\n3. A statement that the EU declaration of conformity referred to in Article 47 is issued under the sole responsibility of the provider;", annex: "V", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 3"};
MERGE (n:AnnexPoint {id: "annex_V__point_4"})
  SET n += {eid: "annex_V__point_4", citation: "Annex V point 4", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_4", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 4: A statement that the AI system is in conformity with this Regulation and, if applicable, with any other relevant Union law that provides for the issuing of the EU declaration of conformity referred to in Article 47;\n\n4. A statement that the AI system is in conformity with this Regulation and, if applicable, with any other relevant Union law that provides for the issuing of the EU declaration of conformity referred to in Article 47;", annex: "V", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 4"};
MERGE (n:AnnexPoint {id: "annex_V__point_5"})
  SET n += {eid: "annex_V__point_5", citation: "Annex V point 5", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_5", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 5: Where an AI system involves the processing of personal data, a statement that that AI system complies with Regulations (EU) 2016/679 and (EU) 2018/1725 and Directive (EU) 2016/680;\n\n5. Where an AI system involves the processing of personal data, a statement that that AI system complies with Regulations (EU) 2016/679 and (EU) 2018/1725 and Directive (EU) 2016/680;", annex: "V", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 5"};
MERGE (n:AnnexPoint {id: "annex_V__point_6"})
  SET n += {eid: "annex_V__point_6", citation: "Annex V point 6", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_6", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 6: References to any relevant harmonised standards used or any other common specification in relation to which conformity is declared;\n\n6. References to any relevant harmonised standards used or any other common specification in relation to which conformity is declared;", annex: "V", annex_point: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 6"};
MERGE (n:AnnexPoint {id: "annex_V__point_7"})
  SET n += {eid: "annex_V__point_7", citation: "Annex V point 7", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_7", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 7: Where applicable, the name and identification number of the notified body, a description of the conformity assessment procedure performed, and identification of the certificate issued;\n\n7. Where applicable, the name and identification number of the notified body, a description of the conformity assessment procedure performed, and identification of the certificate issued;", annex: "V", annex_point: 7, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 7"};
MERGE (n:AnnexPoint {id: "annex_V__point_8"})
  SET n += {eid: "annex_V__point_8", citation: "Annex V point 8", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_V__point_8", chunk_type: "annex_item", level: "point", text: "Annex V — EU declaration of conformity\nPoint 8: The place and date of issue of the declaration, the name and function of the person who signed it, as well as an indication for, or on behalf of whom, that person signed, a signature.\n\n8. The place and date of issue of the declaration, the name and function of the person who signed it, as well as an indication for, or on behalf of whom, that person signed, a signature.", annex: "V", annex_point: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex V point 8"};
MERGE (n:AnnexPoint {id: "annex_VI__point_s1"})
  SET n += {eid: "annex_VI__point_s1", citation: "Annex VI(s1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VI__point_s1", chunk_type: "annex_item", level: "point", text: "Annex VI — Conformity assessment procedure based on internal control\nConformity assessment procedure based on internal control\n\n1. The conformity assessment procedure based on internal control is the conformity assessment procedure based on points 2, 3 and 4.2. The provider verifies that the established quality management system is in compliance with the requirements of Article 17.3. The provider examines the information contained in the technical documentation in order to assess the compliance of the AI system with the relevant essential requirements set out in Chapter III, Section 2.4. The provider also verifies that the design and development process of the AI system and its post-market monitoring as referred to in Article 72 is consistent with the technical documentation.", point: "s1", annex: "VI", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VI(s1)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_1"})
  SET n += {eid: "annex_VII__point_1", citation: "Annex VII point 1", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_1", chunk_type: "annex_item", level: "point", text: "Annex VII — Conformity based on an assessment of the quality management system and an assessment of the technical documentation\n1. Introduction\n\nConformity based on an assessment of the quality management system and an assessment of the technical documentation is the conformity assessment procedure based on points 2 to 5.", annex: "VII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 1"};
MERGE (n:AnnexPoint {id: "annex_VII__point_2"})
  SET n += {eid: "annex_VII__point_2", citation: "Annex VII point 2", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_2", chunk_type: "annex_item", level: "point", text: "Annex VII — Conformity based on an assessment of the quality management system and an assessment of the technical documentation\n2. Overview\n\nThe approved quality management system for the design, development and testing of AI systems pursuant to Article 17 shall be examined in accordance with point 3 and shall be subject to surveillance as specified in point 5. The technical documentation of the AI system shall be examined in accordance with point 4.", annex: "VII", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 2"};
MERGE (n:AnnexPoint {id: "annex_VII__point_3"})
  SET n += {eid: "annex_VII__point_3", citation: "Annex VII point 3", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_3", chunk_type: "annex_item", level: "point", text: "Annex VII — Conformity based on an assessment of the quality management system and an assessment of the technical documentation\n3. Quality management system\n\n3.1. The application of the provider shall include:(a) the name and address of the provider and, if the application is lodged by an authorised representative, also their name and address;(b) the list of AI systems covered under the same quality management system;(c) the technical documentation for each AI system covered under the same quality management system;(d) the documentation concerning the quality management system which shall cover all the aspects listed under Article 17;(e) a description of the procedures in place to ensure that the quality management system remains adequate and effective;(f) a written declaration that the same application has not been lodged with any other notified body. 3.2. The quality management system shall be assessed by the notified body, which shall determine whether it satisfies the requirements referred to in Article 17.The decision shall be notified to the provider or its authorised representative.The notification shall contain the conclusions of the assessment of the quality management system and the reasoned assessment decision. 3.3. The quality management system as approved shall continue to be implemented and maintained by the provider so that it remains adequate and efficient. 3.4. Any intended change to the approved quality management system or the list of AI systems covered by the latter shall be brought to the attention of the notified body by the provider.The proposed changes shall be examined by the notified body, which shall decide whether the modified quality management system continues to satisfy the requirements referred to in point 3.2 or whether a reassessment is necessary.The notified body shall notify the provider of its decision. The notification shall contain the conclusions of the examination of the changes and the reasoned assessment decision.", annex: "VII", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 3"};
MERGE (n:AnnexPoint {id: "annex_VII__point_3__point_a"})
  SET n += {eid: "annex_VII__point_3__point_a", citation: "Annex VII point 3(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_3__point_a", chunk_type: "annex_subpoint", level: "point", text: "the name and address of the provider and, if the application is lodged by an authorised representative, also their name and address", point: "a", annex: "VII", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 3(a)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_3__point_b"})
  SET n += {eid: "annex_VII__point_3__point_b", citation: "Annex VII point 3(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_3__point_b", chunk_type: "annex_subpoint", level: "point", text: "the list of AI systems covered under the same quality management system", point: "b", annex: "VII", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 3(b)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_3__point_c"})
  SET n += {eid: "annex_VII__point_3__point_c", citation: "Annex VII point 3(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_3__point_c", chunk_type: "annex_subpoint", level: "point", text: "the technical documentation for each AI system covered under the same quality management system", point: "c", annex: "VII", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 3(c)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_3__point_d"})
  SET n += {eid: "annex_VII__point_3__point_d", citation: "Annex VII point 3(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_3__point_d", chunk_type: "annex_subpoint", level: "point", text: "the documentation concerning the quality management system which shall cover all the aspects listed under Article 17", point: "d", annex: "VII", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 3(d)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_3__point_e"})
  SET n += {eid: "annex_VII__point_3__point_e", citation: "Annex VII point 3(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_3__point_e", chunk_type: "annex_subpoint", level: "point", text: "a description of the procedures in place to ensure that the quality management system remains adequate and effective", point: "e", annex: "VII", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 3(e)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_3__point_f"})
  SET n += {eid: "annex_VII__point_3__point_f", citation: "Annex VII point 3(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_3__point_f", chunk_type: "annex_subpoint", level: "point", text: "a written declaration that the same application has not been lodged with any other notified body. 3.2. The quality management system shall be assessed by the notified body, which shall determine whether it satisfies the requirements referred to in Article 17.The decision shall be notified to the provider or its authorised representative.The notification shall contain the conclusions of the assessment of the quality management system and the reasoned assessment decision. 3.3. The quality management system as approved shall continue to be implemented and maintained by the provider so that it remains adequate and efficient. 3.4. Any intended change to the approved quality management system or the list of AI systems covered by the latter shall be brought to the attention of the notified body by the provider.The proposed changes shall be examined by the notified body, which shall decide whether the modified quality management system continues to satisfy the requirements referred to in point 3.2 or whether a reassessment is necessary.The notified body shall notify the provider of its decision. The notification shall contain the conclusions of the examination of the changes and the reasoned assessment decision", point: "f", annex: "VII", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 3(f)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_4"})
  SET n += {eid: "annex_VII__point_4", citation: "Annex VII point 4", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_4", chunk_type: "annex_item", level: "point", text: "Annex VII — Conformity based on an assessment of the quality management system and an assessment of the technical documentation\n4. Control of the technical documentation.\n\n4.1. In addition to the application referred to in point 3, an application with a notified body of their choice shall be lodged by the provider for the assessment of the technical documentation relating to the AI system which the provider intends to place on the market or put into service and which is covered by the quality management system referred to under point 3. 4.2. The application shall include:(a) the name and address of the provider;(b) a written declaration that the same application has not been lodged with any other notified body;(c) the technical documentation referred to in Annex IV. 4.3. The technical documentation shall be examined by the notified body. Where relevant, and limited to what is necessary to fulfil its tasks, the notified body shall be granted full access to the training, validation, and testing data sets used, including, where appropriate and subject to security safeguards, through API or other relevant technical means and tools enabling remote access. 4.4. In examining the technical documentation, the notified body may require that the provider supply further evidence or carry out further tests so as to enable a proper assessment of the conformity of the AI system with the requirements set out in Chapter III, Section 2. Where the notified body is not satisfied with the tests carried out by the provider, the notified body shall itself directly carry out adequate tests, as appropriate. 4.5. Where necessary to assess the conformity of the high-risk AI system with the requirements set out in Chapter III, Section 2, after all other reasonable means to verify conformity have been exhausted and have proven to be insufficient, and upon a reasoned request, the notified body shall also be granted access to the training and trained models of the AI system, including its relevant parameters. Such access shall be subject to existing Union law on the protection of intellectual property and trade secrets. 4.6. The decision of the notified body shall be notified to the provider or its authorised representative. The notification shall contain the conclusions of the assessment of the technical documentation and the reasoned assessment decision.Where the AI system is in conformity with the requirements set out in Chapter III, Section 2, the notified body shall issue a Union technical documentation assessment certificate. The certificate shall indicate the name and address of the provider, the conclusions of the examination, the conditions (if any) for its validity and the data necessary for the identification of the AI system.The certificate and its annexes shall contain all relevant information to allow the conformity of the AI system to be evaluated, and to allow for control of the AI system while in use, where applicable.Where the AI system is not in conformity with the requirements set out in Chapter III, Section 2, the notified body shall refuse to issue a Union technical documentation assessment certificate and shall inform the applicant accordingly, giving detailed reasons for its refusal.Where the AI system does not meet the requirement relating to the data used to train it, re-training of the AI system will be needed prior to the application for a new conformity assessment. In this case, the reasoned assessment decision of the notified body refusing to issue the Union technical documentation assessment certificate shall contain specific considerations on the quality data used to train the AI system, in particular on the reasons for non-compliance. 4.7. Any change to the AI system that could affect the compliance of the AI system with the requirements or its intended purpose shall be assessed by the notified body which issued the Union technical documentation assessment certificate. The provider shall inform such notified body of its intention to introduce any of the abovementioned changes, or if it otherwise becomes aware of the occurrence of such changes. The intended changes shall be assessed by the notified body, which shall decide whether those changes require a new conformity assessment in accordance with Article 43(4) or whether they could be addressed by means of a supplement to the Union technical documentation assessment certificate. In the latter case, the notified body shall assess the changes, notify the provider of its decision and, where the changes are approved, issue to the provider a supplement to the Union technical documentation assessment certificate.", annex: "VII", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 4"};
MERGE (n:AnnexPoint {id: "annex_VII__point_4__point_a"})
  SET n += {eid: "annex_VII__point_4__point_a", citation: "Annex VII point 4(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_4__point_a", chunk_type: "annex_subpoint", level: "point", text: "the name and address of the provider", point: "a", annex: "VII", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 4(a)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_4__point_b"})
  SET n += {eid: "annex_VII__point_4__point_b", citation: "Annex VII point 4(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_4__point_b", chunk_type: "annex_subpoint", level: "point", text: "a written declaration that the same application has not been lodged with any other notified body", point: "b", annex: "VII", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 4(b)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_4__point_c"})
  SET n += {eid: "annex_VII__point_4__point_c", citation: "Annex VII point 4(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_4__point_c", chunk_type: "annex_subpoint", level: "point", text: "the technical documentation referred to in Annex IV. 4.3. The technical documentation shall be examined by the notified body. Where relevant, and limited to what is necessary to fulfil its tasks, the notified body shall be granted full access to the training, validation, and testing data sets used, including, where appropriate and subject to security safeguards, through API or other relevant technical means and tools enabling remote access. 4.4. In examining the technical documentation, the notified body may require that the provider supply further evidence or carry out further tests so as to enable a proper assessment of the conformity of the AI system with the requirements set out in Chapter III, Section 2. Where the notified body is not satisfied with the tests carried out by the provider, the notified body shall itself directly carry out adequate tests, as appropriate. 4.5. Where necessary to assess the conformity of the high-risk AI system with the requirements set out in Chapter III, Section 2, after all other reasonable means to verify conformity have been exhausted and have proven to be insufficient, and upon a reasoned request, the notified body shall also be granted access to the training and trained models of the AI system, including its relevant parameters. Such access shall be subject to existing Union law on the protection of intellectual property and trade secrets. 4.6. The decision of the notified body shall be notified to the provider or its authorised representative. The notification shall contain the conclusions of the assessment of the technical documentation and the reasoned assessment decision.Where the AI system is in conformity with the requirements set out in Chapter III, Section 2, the notified body shall issue a Union technical documentation assessment certificate. The certificate shall indicate the name and address of the provider, the conclusions of the examination, the conditions (if any) for its validity and the data necessary for the identification of the AI system.The certificate and its annexes shall contain all relevant information to allow the conformity of the AI system to be evaluated, and to allow for control of the AI system while in use, where applicable.Where the AI system is not in conformity with the requirements set out in Chapter III, Section 2, the notified body shall refuse to issue a Union technical documentation assessment certificate and shall inform the applicant accordingly, giving detailed reasons for its refusal.Where the AI system does not meet the requirement relating to the data used to train it, re-training of the AI system will be needed prior to the application for a new conformity assessment. In this case, the reasoned assessment decision of the notified body refusing to issue the Union technical documentation assessment certificate shall contain specific considerations on the quality data used to train the AI system, in particular on the reasons for non-compliance. 4.7. Any change to the AI system that could affect the compliance of the AI system with the requirements or its intended purpose shall be assessed by the notified body which issued the Union technical documentation assessment certificate. The provider shall inform such notified body of its intention to introduce any of the abovementioned changes, or if it otherwise becomes aware of the occurrence of such changes. The intended changes shall be assessed by the notified body, which shall decide whether those changes require a new conformity assessment in accordance with Article 43(4) or whether they could be addressed by means of a supplement to the Union technical documentation assessment certificate. In the latter case, the notified body shall assess the changes, notify the provider of its decision and, where the changes are approved, issue to the provider a supplement to the Union technical documentation assessment certificate", point: "c", annex: "VII", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 4(c)"};
MERGE (n:AnnexPoint {id: "annex_VII__point_5"})
  SET n += {eid: "annex_VII__point_5", citation: "Annex VII point 5", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VII__point_5", chunk_type: "annex_item", level: "point", text: "Annex VII — Conformity based on an assessment of the quality management system and an assessment of the technical documentation\n5. Surveillance of the approved quality management system.\n\n5.1. The purpose of the surveillance carried out by the notified body referred to in Point 3 is to make sure that the provider duly complies with the terms and conditions of the approved quality management system. 5.2. For assessment purposes, the provider shall allow the notified body to access the premises where the design, development, testing of the AI systems is taking place. The provider shall further share with the notified body all necessary information. 5.3. The notified body shall carry out periodic audits to make sure that the provider maintains and applies the quality management system and shall provide the provider with an audit report. In the context of those audits, the notified body may carry out additional tests of the AI systems for which a Union technical documentation assessment certificate was issued.", annex: "VII", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VII point 5"};
MERGE (n:AnnexPoint {id: "annex_VIII__point_s1"})
  SET n += {eid: "annex_VIII__point_s1", citation: "Annex VIII(s1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VIII__point_s1", chunk_type: "annex_item", level: "point", text: "Annex VIII — Information to be submitted upon the registration of high-risk AI systems in accordance with Article 49\nSection A — Information to be submitted by providers of high-risk AI systems in accordance with Article 49(1)\n\nThe following information shall be provided and thereafter kept up to date with regard to high-risk AI systems to be registered in accordance with Article 49(1): 1. The name, address and contact details of the provider;2. Where submission of information is carried out by another person on behalf of the provider, the name, address and contact details of that person;3. The name, address and contact details of the authorised representative, where applicable;4. The AI system trade name and any additional unambiguous reference allowing the identification and traceability of the AI system;5. A description of the intended purpose of the AI system and of the components and functions supported through this AI system;6. A basic and concise description of the information used by the system (data, inputs) and its operating logic;7. The status of the AI system (on the market, or in service; no longer placed on the market/in service, recalled);8. The type, number and expiry date of the certificate issued by the notified body and the name or identification number of that notified body, where applicable;9. A scanned copy of the certificate referred to in point 8, where applicable;10. Any Member States in which the AI system has been placed on the market, put into service or made available in the Union;11. A copy of the EU declaration of conformity referred to in Article 47;12. Electronic instructions for use; this information shall not be provided for high-risk AI systems in the areas of law enforcement or migration, asylum and border control management referred to in Annex III, points 1, 6 and 7;13. A URL for additional information (optional).", point: "s1", annex: "VIII", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VIII(s1)"};
MERGE (n:AnnexPoint {id: "annex_VIII__point_s2"})
  SET n += {eid: "annex_VIII__point_s2", citation: "Annex VIII(s2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VIII__point_s2", chunk_type: "annex_item", level: "point", text: "Annex VIII — Information to be submitted upon the registration of high-risk AI systems in accordance with Article 49\nSection B — Information to be submitted by providers of high-risk AI systems in accordance with Article 49(2)\n\nThe following information shall be provided and thereafter kept up to date with regard to AI systems to be registered in accordance with Article 49(2): 1. The name, address and contact details of the provider;2. Where submission of information is carried out by another person on behalf of the provider, the name, address and contact details of that person;3. The name, address and contact details of the authorised representative, where applicable;4. The AI system trade name and any additional unambiguous reference allowing the identification and traceability of the AI system;5. A description of the intended purpose of the AI system;6. The condition or conditions under Article 6(3)based on which the AI system is considered to be not-high-risk;7. A short summary of the grounds on which the AI system is considered to be not-high-risk in application of the procedure under Article 6(3);8. The status of the AI system (on the market, or in service; no longer placed on the market/in service, recalled);9. Any Member States in which the AI system has been placed on the market, put into service or made available in the Union.", point: "s2", annex: "VIII", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VIII(s2)"};
MERGE (n:AnnexPoint {id: "annex_VIII__point_s3"})
  SET n += {eid: "annex_VIII__point_s3", citation: "Annex VIII(s3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_VIII__point_s3", chunk_type: "annex_item", level: "point", text: "Annex VIII — Information to be submitted upon the registration of high-risk AI systems in accordance with Article 49\nSection C — Information to be submitted by deployers of high-risk AI systems in accordance with Article 49(3)\n\nThe following information shall be provided and thereafter kept up to date with regard to high-risk AI systems to be registered in accordance with Article 49(3): 1. The name, address and contact details of the deployer;2. The name, address and contact details of the person submitting information on behalf of the deployer;3. The URL of the entry of the AI system in the EU database by its provider;4. A summary of the findings of the fundamental rights impact assessment conducted in accordance with Article 27;5. A summary of the data protection impact assessment carried out in accordance with Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680 as specified in Article 26(8) of this Regulation, where applicable.", point: "s3", annex: "VIII", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex VIII(s3)"};
MERGE (n:AnnexPoint {id: "annex_IX__point_1"})
  SET n += {eid: "annex_IX__point_1", citation: "Annex IX point 1", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IX__point_1", chunk_type: "annex_item", level: "point", text: "Annex IX — Information to be submitted upon the registration of high-risk AI systems listed in Annex III in relation to testing in real world conditions in accordance with Article 60\nPoint 1: A Union-wide unique single identification number of the testing in real world conditions;\n\n1. A Union-wide unique single identification number of the testing in real world conditions;", annex: "IX", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IX point 1"};
MERGE (n:AnnexPoint {id: "annex_IX__point_2"})
  SET n += {eid: "annex_IX__point_2", citation: "Annex IX point 2", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IX__point_2", chunk_type: "annex_item", level: "point", text: "Annex IX — Information to be submitted upon the registration of high-risk AI systems listed in Annex III in relation to testing in real world conditions in accordance with Article 60\nPoint 2: The name and contact details of the provider or prospective provider and of the deployers involved in the testing in real world conditions;\n\n2. The name and contact details of the provider or prospective provider and of the deployers involved in the testing in real world conditions;", annex: "IX", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IX point 2"};
MERGE (n:AnnexPoint {id: "annex_IX__point_3"})
  SET n += {eid: "annex_IX__point_3", citation: "Annex IX point 3", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IX__point_3", chunk_type: "annex_item", level: "point", text: "Annex IX — Information to be submitted upon the registration of high-risk AI systems listed in Annex III in relation to testing in real world conditions in accordance with Article 60\nPoint 3: A brief description of the AI system, its intended purpose, and other information necessary for the identification of the system;\n\n3. A brief description of the AI system, its intended purpose, and other information necessary for the identification of the system;", annex: "IX", annex_point: 3, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IX point 3"};
MERGE (n:AnnexPoint {id: "annex_IX__point_4"})
  SET n += {eid: "annex_IX__point_4", citation: "Annex IX point 4", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IX__point_4", chunk_type: "annex_item", level: "point", text: "Annex IX — Information to be submitted upon the registration of high-risk AI systems listed in Annex III in relation to testing in real world conditions in accordance with Article 60\nPoint 4: A summary of the main characteristics of the plan for testing in real world conditions;\n\n4. A summary of the main characteristics of the plan for testing in real world conditions;", annex: "IX", annex_point: 4, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IX point 4"};
MERGE (n:AnnexPoint {id: "annex_IX__point_5"})
  SET n += {eid: "annex_IX__point_5", citation: "Annex IX point 5", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_IX__point_5", chunk_type: "annex_item", level: "point", text: "Annex IX — Information to be submitted upon the registration of high-risk AI systems listed in Annex III in relation to testing in real world conditions in accordance with Article 60\nPoint 5: Information on the suspension or termination of the testing in real world conditions.\n\n5. Information on the suspension or termination of the testing in real world conditions.", annex: "IX", annex_point: 5, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex IX point 5"};
MERGE (n:AnnexPoint {id: "annex_XI__point_s1"})
  SET n += {eid: "annex_XI__point_s1", citation: "Annex XI(s1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XI__point_s1", chunk_type: "annex_item", level: "point", text: "Annex XI — Technical documentation referred to in Article 53(1), point (a) — technical documentation for providers of general-purpose AI models\nSection 1: Information to be provided by all providers of general-purpose AI models\n\nThe technical documentation referred to in Article 53(1), point (a) shall contain at least the following information as appropriate to the size and risk profile of the model: 1. A general description of the general-purpose AI model including:(a) the tasks that the model is intended to perform and the type and nature of AI systems in which it can be integrated;(b) the acceptable use policies applicable;(c) the date of release and methods of distribution;(d) the architecture and number of parameters;(e) the modality (e.g. text, image) and format of inputs and outputs;(f) the licence.2. A detailed description of the elements of the model referred to in point 1, and relevant information of the process for the development, including the following elements:(a) the technical means (e.g. instructions of use, infrastructure, tools) required for the general-purpose AI model to be integrated in AI systems;(b) the design specifications of the model and training process, including training methodologies and techniques, the key design choices including the rationale and assumptions made; what the model is designed to optimise for and the relevance of the different parameters, as applicable;(c) information on the data used for training, testing and validation, where applicable, including the type and provenance of data and curation methodologies (e.g. cleaning, filtering, etc.), the number of data points, their scope and main characteristics; how the data was obtained and selected as well as all other measures to detect the unsuitability of data sources and methods to detect identifiable biases, where applicable;(d) the computational resources used to train the model (e.g. number of floating point operations), training time, and other relevant details related to the training;(e) known or estimated energy consumption of the model.With regard to point (e), where the energy consumption of the model is unknown, the energy consumption may be based on information about computational resources used.", point: "s1", annex: "XI", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XI(s1)"};
MERGE (n:AnnexPoint {id: "annex_XI__point_s2"})
  SET n += {eid: "annex_XI__point_s2", citation: "Annex XI(s2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XI__point_s2", chunk_type: "annex_item", level: "point", text: "Annex XI — Technical documentation referred to in Article 53(1), point (a) — technical documentation for providers of general-purpose AI models\nSection 2: Additional information to be provided by providers of general-purpose AI models with systemic risk\n\n1. A detailed description of the evaluation strategies, including evaluation results, on the basis of available public evaluation protocols and tools or otherwise of other evaluation methodologies. Evaluation strategies shall include evaluation criteria, metrics and the methodology on the identification of limitations. 2. Where applicable, a detailed description of the measures put in place for the purpose of conducting internal and/or external adversarial testing (e.g. red teaming), model adaptations, including alignment and fine-tuning. 3. Where applicable, a detailed description of the system architecture explaining how software components build or feed into each other and integrate into the overall processing.", point: "s2", annex: "XI", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XI(s2)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1"})
  SET n += {eid: "annex_XII__point_1", citation: "Annex XII point 1", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1", chunk_type: "annex_item", level: "point", text: "Annex XII — Transparency information referred to in Article 53(1), point (b) — technical documentation for providers of general-purpose AI models to downstream providers that integrate the model into their AI system\nPoint 1: A general description of the general-purpose AI model including:\n\n1. A general description of the general-purpose AI model including:(a) the tasks that the model is intended to perform and the type and nature of AI systems into which it can be integrated;(b) the acceptable use policies applicable;(c) the date of release and methods of distribution;(d) how the model interacts, or can be used to interact, with hardware or software that is not part of the model itself, where applicable;(e) the versions of relevant software related to the use of the general-purpose AI model, where applicable;(f) the architecture and number of parameters;(g) the modality (e.g. text, image) and format of inputs and outputs;(h) the licence for the model.", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_a"})
  SET n += {eid: "annex_XII__point_1__point_a", citation: "Annex XII point 1(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_a", chunk_type: "annex_subpoint", level: "point", text: "the tasks that the model is intended to perform and the type and nature of AI systems into which it can be integrated", point: "a", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(a)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_b"})
  SET n += {eid: "annex_XII__point_1__point_b", citation: "Annex XII point 1(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_b", chunk_type: "annex_subpoint", level: "point", text: "the acceptable use policies applicable", point: "b", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(b)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_c"})
  SET n += {eid: "annex_XII__point_1__point_c", citation: "Annex XII point 1(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_c", chunk_type: "annex_subpoint", level: "point", text: "the date of release and methods of distribution", point: "c", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(c)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_d"})
  SET n += {eid: "annex_XII__point_1__point_d", citation: "Annex XII point 1(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_d", chunk_type: "annex_subpoint", level: "point", text: "how the model interacts, or can be used to interact, with hardware or software that is not part of the model itself, where applicable", point: "d", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(d)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_e"})
  SET n += {eid: "annex_XII__point_1__point_e", citation: "Annex XII point 1(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_e", chunk_type: "annex_subpoint", level: "point", text: "the versions of relevant software related to the use of the general-purpose AI model, where applicable", point: "e", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(e)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_f"})
  SET n += {eid: "annex_XII__point_1__point_f", citation: "Annex XII point 1(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_f", chunk_type: "annex_subpoint", level: "point", text: "the architecture and number of parameters", point: "f", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(f)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_g"})
  SET n += {eid: "annex_XII__point_1__point_g", citation: "Annex XII point 1(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_g", chunk_type: "annex_subpoint", level: "point", text: "the modality (e.g. text, image) and format of inputs and outputs", point: "g", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(g)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_1__point_h"})
  SET n += {eid: "annex_XII__point_1__point_h", citation: "Annex XII point 1(h)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_1__point_h", chunk_type: "annex_subpoint", level: "point", text: "the licence for the model", point: "h", annex: "XII", annex_point: 1, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 1(h)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_2"})
  SET n += {eid: "annex_XII__point_2", citation: "Annex XII point 2", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_2", chunk_type: "annex_item", level: "point", text: "Annex XII — Transparency information referred to in Article 53(1), point (b) — technical documentation for providers of general-purpose AI models to downstream providers that integrate the model into their AI system\nPoint 2: A description of the elements of the model and of the process for its development, including:\n\n2. A description of the elements of the model and of the process for its development, including:(a) the technical means (e.g. instructions for use, infrastructure, tools) required for the general-purpose AI model to be integrated into AI systems;(b) the modality (e.g. text, image, etc.) and format of the inputs and outputs and their maximum size (e.g. context window length, etc.);(c) information on the data used for training, testing and validation, where applicable, including the type and provenance of data and curation methodologies.", annex: "XII", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 2"};
MERGE (n:AnnexPoint {id: "annex_XII__point_2__point_a"})
  SET n += {eid: "annex_XII__point_2__point_a", citation: "Annex XII point 2(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_2__point_a", chunk_type: "annex_subpoint", level: "point", text: "the technical means (e.g. instructions for use, infrastructure, tools) required for the general-purpose AI model to be integrated into AI systems", point: "a", annex: "XII", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 2(a)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_2__point_b"})
  SET n += {eid: "annex_XII__point_2__point_b", citation: "Annex XII point 2(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_2__point_b", chunk_type: "annex_subpoint", level: "point", text: "the modality (e.g. text, image, etc.) and format of the inputs and outputs and their maximum size (e.g. context window length, etc.)", point: "b", annex: "XII", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 2(b)"};
MERGE (n:AnnexPoint {id: "annex_XII__point_2__point_c"})
  SET n += {eid: "annex_XII__point_2__point_c", citation: "Annex XII point 2(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XII__point_2__point_c", chunk_type: "annex_subpoint", level: "point", text: "information on the data used for training, testing and validation, where applicable, including the type and provenance of data and curation methodologies", point: "c", annex: "XII", annex_point: 2, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XII point 2(c)"};
MERGE (n:AnnexPoint {id: "annex_XIII__point_s1"})
  SET n += {eid: "annex_XIII__point_s1", citation: "Annex XIII(s1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#annex_XIII__point_s1", chunk_type: "annex_item", level: "point", text: "Annex XIII — Criteria for the designation of general-purpose AI models with systemic risk referred to in Article 51\nCriteria for the designation of general-purpose AI models with systemic risk referred to in Article 51\n\nFor the purpose of determining that a general-purpose AI model has capabilities or an impact equivalent to those set out in Article 51(1), point (a), the Commission shall take into account the following criteria:(a) the number of parameters of the model;(b) the quality or size of the data set, for example measured through tokens;(c) the amount of computation used for training the model, measured in floating point operations or indicated by a combination of other variables such as estimated cost of training, estimated time required for the training, or estimated energy consumption for the training;(d) the input and output modalities of the model, such as text to text (large language models), text to image, multi-modality, and the state of the art thresholds for determining high-impact capabilities for each modality, and the specific type of inputs and outputs (e.g. biological sequences);(e) the benchmarks and evaluations of capabilities of the model, including considering the number of tasks without additional training, adaptability to learn new, distinct tasks, its level of autonomy and scalability, the tools it has access to;(f) whether it has a high impact on the internal market due to its reach, which shall be presumed when it has been made available to at least 10000 registered business users established in the Union;(g) the number of registered end-users.", point: "s1", annex: "XIII", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Annex XIII(s1)"};
