  SET n += {eid: "art_13__para_3__point_f__sub_iii", citation: "Art. 13(3)(f)(iii)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_13__para_3__point_f__sub_iii", chunk_type: "subpoint", level: "sub", text: "any known or foreseeable circumstance, related to the use of the high-risk AI system in accordance with its intended purpose or under conditions of reasonably foreseeable misuse, which may lead to risks to the health and safety or fundamental rights referred to in Article 9(2)", article: 13, paragraph: 3, point: "f", subpoint: "iii", chapter: 3, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 13(3)(f)(iii)"};
