  SET n += {eid: "art_27__para_1__point_c", citation: "Art. 27(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_27__para_1__point_c", chunk_type: "point", level: "point", text: "the categories of natural persons and groups likely to be affected by its use in the specific context", article: 27, paragraph: 1, point: "c", chapter: 3, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 27(1)(c)"};
