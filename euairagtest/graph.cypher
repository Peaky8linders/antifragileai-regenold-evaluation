MERGE (n:Provision {id: "art_17__para_1__point_j"})
  SET n += {eid: "art_17__para_1__point_j", citation: "Art. 17(1)(j)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_17__para_1__point_j", chunk_type: "point", level: "point", text: "the handling of communication with national competent authorities, other relevant authorities, including those providing or supporting the access to data, notified bodies, other operators, customers or other interested parties", article: 17, paragraph: 1, point: "j", chapter: 3, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 17(1)(j)"};
