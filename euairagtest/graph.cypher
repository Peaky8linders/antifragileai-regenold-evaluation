MERGE (n:Provision {id: "art_79__para_7"})
  SET n += {eid: "art_79__para_7", citation: "Art. 79(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_7", chunk_type: "paragraph", level: "para", text: "The market surveillance authorities other than the market surveillance authority of the Member State initiating the procedure shall, without undue delay, inform the Commission and the other Member States of any measures adopted and of any additional information at their disposal relating to the non-compliance of the AI system concerned, and, in the event of disagreement with the notified national measure, of their objections.", article: 79, paragraph: 7, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(7)"};
MERGE (n:Provision {id: "art_79__para_8"})
  SET n += {eid: "art_79__para_8", citation: "Art. 79(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_8", chunk_type: "paragraph", level: "para", text: "Where, within three months of receipt of the notification referred to in paragraph 5 of this Article, no objection has been raised by either a market surveillance authority of a Member State or by the Commission in respect of a provisional measure taken by a market surveillance authority of another Member State, that measure shall be deemed justified. This shall be without prejudice to the procedural rights of the concerned operator in accordance with Article 18 of Regulation (EU) 2019/1020. The three-month period referred to in this paragraph shall be reduced to 30 days in the event of non-compliance with the prohibition of the AI practices referred to in Article 5 of this Regulation.", article: 79, paragraph: 8, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(8)"};
MERGE (n:Provision {id: "art_79__para_9"})
  SET n += {eid: "art_79__para_9", citation: "Art. 79(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_9", chunk_type: "paragraph", level: "para", text: "The market surveillance authorities shall ensure that appropriate restrictive measures are taken in respect of the product or the AI system concerned, such as withdrawal of the product or the AI system from their market, without undue delay.", article: 79, paragraph: 9, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(9)"};
MERGE (n:Provision {id: "art_80"})
  SET n += {eid: "art_80", citation: "Art. 80", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80", chunk_type: "article_full", level: "art", text: "Article 80 — Procedure for dealing with AI systems classified by the provider as non-high-risk in application of Annex III\n\n1. Where a market surveillance authority has sufficient reason to consider that an AI system classified by the provider as non-high-risk pursuant to Article 6(3) is indeed high-risk, the market surveillance authority shall carry out an evaluation of the AI system concerned in respect of its classification as a high-risk AI system based on the conditions set out in Article 6(3) and the Commission guidelines.\n\n2. Where, in the course of that evaluation, the market surveillance authority finds that the AI system concerned is high-risk, it shall without undue delay require the relevant provider to take all necessary actions to bring the AI system into compliance with the requirements and obligations laid down in this Regulation, as well as take appropriate corrective action within a period the market surveillance authority may prescribe.\n\n3. Where the market surveillance authority considers that the use of the AI system concerned is not restricted to its national territory, it shall inform the Commission and the other Member States without undue delay of the results of the evaluation and of the actions which it has required the provider to take.\n\n4. The provider shall ensure that all necessary action is taken to bring the AI system into compliance with the requirements and obligations laid down in this Regulation. Where the provider of an AI system concerned does not bring the AI system into compliance with those requirements and obligations within the period referred to in paragraph 2 of this Article, the provider shall be subject to fines in accordance with Article 99.\n\n5. The provider shall ensure that all appropriate corrective action is taken in respect of all the AI systems concerned that it has made available on the Union market.\n\n6. Where the provider of the AI system concerned does not take adequate corrective action within the period referred to in paragraph 2 of this Article, Article 79(5) to (9) shall apply.\n\n7. Where, in the course of the evaluation pursuant to paragraph 1 of this Article, the market surveillance authority establishes that the AI system was misclassified by the provider as non-high-risk in order to circumvent the application of requirements in Chapter III, Section 2, the provider shall be subject to fines in accordance with Article 99.\n\n8. In exercising their power to monitor the application of this Article, and in accordance with Article 11 of Regulation (EU) 2019/1020, market surveillance authorities may perform appropriate checks, taking into account in particular information stored in the EU database referred to in Article 71 of this Regulation.", article: 80, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80"};
MERGE (n:Provision {id: "art_80__para_1"})
  SET n += {eid: "art_80__para_1", citation: "Art. 80(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_1", chunk_type: "paragraph", level: "para", text: "Where a market surveillance authority has sufficient reason to consider that an AI system classified by the provider as non-high-risk pursuant to Article 6(3) is indeed high-risk, the market surveillance authority shall carry out an evaluation of the AI system concerned in respect of its classification as a high-risk AI system based on the conditions set out in Article 6(3) and the Commission guidelines.", article: 80, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(1)"};
MERGE (n:Provision {id: "art_80__para_2"})
  SET n += {eid: "art_80__para_2", citation: "Art. 80(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_2", chunk_type: "paragraph", level: "para", text: "Where, in the course of that evaluation, the market surveillance authority finds that the AI system concerned is high-risk, it shall without undue delay require the relevant provider to take all necessary actions to bring the AI system into compliance with the requirements and obligations laid down in this Regulation, as well as take appropriate corrective action within a period the market surveillance authority may prescribe.", article: 80, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(2)"};
MERGE (n:Provision {id: "art_80__para_3"})
  SET n += {eid: "art_80__para_3", citation: "Art. 80(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_3", chunk_type: "paragraph", level: "para", text: "Where the market surveillance authority considers that the use of the AI system concerned is not restricted to its national territory, it shall inform the Commission and the other Member States without undue delay of the results of the evaluation and of the actions which it has required the provider to take.", article: 80, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(3)"};
MERGE (n:Provision {id: "art_80__para_4"})
  SET n += {eid: "art_80__para_4", citation: "Art. 80(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_4", chunk_type: "paragraph", level: "para", text: "The provider shall ensure that all necessary action is taken to bring the AI system into compliance with the requirements and obligations laid down in this Regulation. Where the provider of an AI system concerned does not bring the AI system into compliance with those requirements and obligations within the period referred to in paragraph 2 of this Article, the provider shall be subject to fines in accordance with Article 99.", article: 80, paragraph: 4, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(4)"};
MERGE (n:Provision {id: "art_80__para_5"})
  SET n += {eid: "art_80__para_5", citation: "Art. 80(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_5", chunk_type: "paragraph", level: "para", text: "The provider shall ensure that all appropriate corrective action is taken in respect of all the AI systems concerned that it has made available on the Union market.", article: 80, paragraph: 5, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(5)"};
MERGE (n:Provision {id: "art_80__para_6"})
  SET n += {eid: "art_80__para_6", citation: "Art. 80(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_6", chunk_type: "paragraph", level: "para", text: "Where the provider of the AI system concerned does not take adequate corrective action within the period referred to in paragraph 2 of this Article, Article 79(5) to (9) shall apply.", article: 80, paragraph: 6, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(6)"};
MERGE (n:Provision {id: "art_80__para_7"})
  SET n += {eid: "art_80__para_7", citation: "Art. 80(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_7", chunk_type: "paragraph", level: "para", text: "Where, in the course of the evaluation pursuant to paragraph 1 of this Article, the market surveillance authority establishes that the AI system was misclassified by the provider as non-high-risk in order to circumvent the application of requirements in Chapter III, Section 2, the provider shall be subject to fines in accordance with Article 99.", article: 80, paragraph: 7, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(7)"};
MERGE (n:Provision {id: "art_80__para_8"})
  SET n += {eid: "art_80__para_8", citation: "Art. 80(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_80__para_8", chunk_type: "paragraph", level: "para", text: "In exercising their power to monitor the application of this Article, and in accordance with Article 11 of Regulation (EU) 2019/1020, market surveillance authorities may perform appropriate checks, taking into account in particular information stored in the EU database referred to in Article 71 of this Regulation.", article: 80, paragraph: 8, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 80(8)"};
MERGE (n:Provision {id: "art_81"})
  SET n += {eid: "art_81", citation: "Art. 81", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_81", chunk_type: "article_full", level: "art", text: "Article 81 — Union safeguard procedure\n\n1. Where, within three months of receipt of the notification referred to in Article 79(5), or within 30 days in the case of non-compliance with the prohibition of the AI practices referred to in Article 5, objections are raised by the market surveillance authority of a Member State to a measure taken by another market surveillance authority, or where the Commission considers the measure to be contrary to Union law, the Commission shall without undue delay enter into consultation with the market surveillance authority of the relevant Member State and the operator or operators, and shall evaluate the national measure. On the basis of the results of that evaluation, the Commission shall, within six months, or within 60 days in the case of non-compliance with the prohibition of the AI practices referred to in Article 5, starting from the notification referred to in Article 79(5), decide whether the national measure is justified and shall notify its decision to the market surveillance authority of the Member State concerned. The Commission shall also inform all other market surveillance authorities of its decision.\n\n2. Where the Commission considers the measure taken by the relevant Member State to be justified, all Member States shall ensure that they take appropriate restrictive measures in respect of the AI system concerned, such as requiring the withdrawal of the AI system from their market without undue delay, and shall inform the Commission accordingly. Where the Commission considers the national measure to be unjustified, the Member State concerned shall withdraw the measure and shall inform the Commission accordingly.\n\n3. Where the national measure is considered justified and the non-compliance of the AI system is attributed to shortcomings in the harmonised standards or common specifications referred to in Articles 40 and 41 of this Regulation, the Commission shall apply the procedure provided for in Article 11 of Regulation (EU) No 1025/2012.", article: 81, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 81"};
MERGE (n:Provision {id: "art_81__para_1"})
  SET n += {eid: "art_81__para_1", citation: "Art. 81(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_81__para_1", chunk_type: "paragraph", level: "para", text: "Where, within three months of receipt of the notification referred to in Article 79(5), or within 30 days in the case of non-compliance with the prohibition of the AI practices referred to in Article 5, objections are raised by the market surveillance authority of a Member State to a measure taken by another market surveillance authority, or where the Commission considers the measure to be contrary to Union law, the Commission shall without undue delay enter into consultation with the market surveillance authority of the relevant Member State and the operator or operators, and shall evaluate the national measure. On the basis of the results of that evaluation, the Commission shall, within six months, or within 60 days in the case of non-compliance with the prohibition of the AI practices referred to in Article 5, starting from the notification referred to in Article 79(5), decide whether the national measure is justified and shall notify its decision to the market surveillance authority of the Member State concerned. The Commission shall also inform all other market surveillance authorities of its decision.", article: 81, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 81(1)"};
MERGE (n:Provision {id: "art_81__para_2"})
  SET n += {eid: "art_81__para_2", citation: "Art. 81(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_81__para_2", chunk_type: "paragraph", level: "para", text: "Where the Commission considers the measure taken by the relevant Member State to be justified, all Member States shall ensure that they take appropriate restrictive measures in respect of the AI system concerned, such as requiring the withdrawal of the AI system from their market without undue delay, and shall inform the Commission accordingly. Where the Commission considers the national measure to be unjustified, the Member State concerned shall withdraw the measure and shall inform the Commission accordingly.", article: 81, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 81(2)"};
MERGE (n:Provision {id: "art_81__para_3"})
  SET n += {eid: "art_81__para_3", citation: "Art. 81(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_81__para_3", chunk_type: "paragraph", level: "para", text: "Where the national measure is considered justified and the non-compliance of the AI system is attributed to shortcomings in the harmonised standards or common specifications referred to in Articles 40 and 41 of this Regulation, the Commission shall apply the procedure provided for in Article 11 of Regulation (EU) No 1025/2012.", article: 81, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 81(3)"};
MERGE (n:Provision {id: "art_82"})
  SET n += {eid: "art_82", citation: "Art. 82", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_82", chunk_type: "article_full", level: "art", text: "Article 82 — Compliant AI systems which present a risk\n\n1. Where, having performed an evaluation under Article 79, after consulting the relevant national public authority referred to in Article 77(1), the market surveillance authority of a Member State finds that although a high-risk AI system complies with this Regulation, it nevertheless presents a risk to the health or safety of persons, to fundamental rights, or to other aspects of public interest protection, it shall require the relevant operator to take all appropriate measures to ensure that the AI system concerned, when placed on the market or put into service, no longer presents that risk without undue delay, within a period it may prescribe.\n\n2. The provider or other relevant operator shall ensure that corrective action is taken in respect of all the AI systems concerned that it has made available on the Union market within the timeline prescribed by the market surveillance authority of the Member State referred to in paragraph 1.\n\n3. The Member States shall immediately inform the Commission and the other Member States of a finding under paragraph 1. That information shall include all available details, in particular the data necessary for the identification of the AI system concerned, the origin and the supply chain of the AI system, the nature of the risk involved and the nature and duration of the national measures taken.\n\n4. The Commission shall without undue delay enter into consultation with the Member States concerned and the relevant operators, and shall evaluate the national measures taken. On the basis of the results of that evaluation, the Commission shall decide whether the measure is justified and, where necessary, propose other appropriate measures.\n\n5. The Commission shall immediately communicate its decision to the Member States concerned and to the relevant operators. It shall also inform the other Member States.", article: 82, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 82"};
MERGE (n:Provision {id: "art_82__para_1"})
  SET n += {eid: "art_82__para_1", citation: "Art. 82(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_82__para_1", chunk_type: "paragraph", level: "para", text: "Where, having performed an evaluation under Article 79, after consulting the relevant national public authority referred to in Article 77(1), the market surveillance authority of a Member State finds that although a high-risk AI system complies with this Regulation, it nevertheless presents a risk to the health or safety of persons, to fundamental rights, or to other aspects of public interest protection, it shall require the relevant operator to take all appropriate measures to ensure that the AI system concerned, when placed on the market or put into service, no longer presents that risk without undue delay, within a period it may prescribe.", article: 82, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 82(1)"};
MERGE (n:Provision {id: "art_82__para_2"})
  SET n += {eid: "art_82__para_2", citation: "Art. 82(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_82__para_2", chunk_type: "paragraph", level: "para", text: "The provider or other relevant operator shall ensure that corrective action is taken in respect of all the AI systems concerned that it has made available on the Union market within the timeline prescribed by the market surveillance authority of the Member State referred to in paragraph 1.", article: 82, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 82(2)"};
MERGE (n:Provision {id: "art_82__para_3"})
  SET n += {eid: "art_82__para_3", citation: "Art. 82(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_82__para_3", chunk_type: "paragraph", level: "para", text: "The Member States shall immediately inform the Commission and the other Member States of a finding under paragraph 1. That information shall include all available details, in particular the data necessary for the identification of the AI system concerned, the origin and the supply chain of the AI system, the nature of the risk involved and the nature and duration of the national measures taken.", article: 82, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 82(3)"};
MERGE (n:Provision {id: "art_82__para_4"})
  SET n += {eid: "art_82__para_4", citation: "Art. 82(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_82__para_4", chunk_type: "paragraph", level: "para", text: "The Commission shall without undue delay enter into consultation with the Member States concerned and the relevant operators, and shall evaluate the national measures taken. On the basis of the results of that evaluation, the Commission shall decide whether the measure is justified and, where necessary, propose other appropriate measures.", article: 82, paragraph: 4, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 82(4)"};
MERGE (n:Provision {id: "art_82__para_5"})
  SET n += {eid: "art_82__para_5", citation: "Art. 82(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_82__para_5", chunk_type: "paragraph", level: "para", text: "The Commission shall immediately communicate its decision to the Member States concerned and to the relevant operators. It shall also inform the other Member States.", article: 82, paragraph: 5, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 82(5)"};
MERGE (n:Provision {id: "art_83"})
  SET n += {eid: "art_83", citation: "Art. 83", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83", chunk_type: "article_full", level: "art", text: "Article 83 — Formal non-compliance\n\n1. Where the market surveillance authority of a Member State makes one of the following findings, it shall require the relevant provider to put an end to the non-compliance concerned, within a period it may prescribe:\n(a) the CE marking has been affixed in violation of Article 48;\n(b) the CE marking has not been affixed;\n(c) the EU declaration of conformity referred to in Article 47 has not been drawn up;\n(d) the EU declaration of conformity referred to in Article 47 has not been drawn up correctly;\n(e) the registration in the EU database referred to in Article 71 has not been carried out;\n(f) where applicable, no authorised representative has been appointed;\n(g) technical documentation is not available.\n\n2. Where the non-compliance referred to in paragraph 1 persists, the market surveillance authority of the Member State concerned shall take appropriate and proportionate measures to restrict or prohibit the high-risk AI system being made available on the market or to ensure that it is recalled or withdrawn from the market without delay.", article: 83, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83"};
MERGE (n:Provision {id: "art_83__para_1"})
  SET n += {eid: "art_83__para_1", citation: "Art. 83(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1", chunk_type: "paragraph", level: "para", text: "Where the market surveillance authority of a Member State makes one of the following findings, it shall require the relevant provider to put an end to the non-compliance concerned, within a period it may prescribe:\n(a) the CE marking has been affixed in violation of Article 48;\n(b) the CE marking has not been affixed;\n(c) the EU declaration of conformity referred to in Article 47 has not been drawn up;\n(d) the EU declaration of conformity referred to in Article 47 has not been drawn up correctly;\n(e) the registration in the EU database referred to in Article 71 has not been carried out;\n(f) where applicable, no authorised representative has been appointed;\n(g) technical documentation is not available.", article: 83, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)"};
MERGE (n:Provision {id: "art_83__para_1__point_a"})
  SET n += {eid: "art_83__para_1__point_a", citation: "Art. 83(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1__point_a", chunk_type: "point", level: "point", text: "the CE marking has been affixed in violation of Article 48", article: 83, paragraph: 1, point: "a", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)(a)"};
MERGE (n:Provision {id: "art_83__para_1__point_b"})
  SET n += {eid: "art_83__para_1__point_b", citation: "Art. 83(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1__point_b", chunk_type: "point", level: "point", text: "the CE marking has not been affixed", article: 83, paragraph: 1, point: "b", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)(b)"};
MERGE (n:Provision {id: "art_83__para_1__point_c"})
  SET n += {eid: "art_83__para_1__point_c", citation: "Art. 83(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1__point_c", chunk_type: "point", level: "point", text: "the EU declaration of conformity referred to in Article 47 has not been drawn up", article: 83, paragraph: 1, point: "c", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)(c)"};
MERGE (n:Provision {id: "art_83__para_1__point_d"})
  SET n += {eid: "art_83__para_1__point_d", citation: "Art. 83(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1__point_d", chunk_type: "point", level: "point", text: "the EU declaration of conformity referred to in Article 47 has not been drawn up correctly", article: 83, paragraph: 1, point: "d", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)(d)"};
MERGE (n:Provision {id: "art_83__para_1__point_e"})
  SET n += {eid: "art_83__para_1__point_e", citation: "Art. 83(1)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1__point_e", chunk_type: "point", level: "point", text: "the registration in the EU database referred to in Article 71 has not been carried out", article: 83, paragraph: 1, point: "e", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)(e)"};
MERGE (n:Provision {id: "art_83__para_1__point_f"})
  SET n += {eid: "art_83__para_1__point_f", citation: "Art. 83(1)(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1__point_f", chunk_type: "point", level: "point", text: "where applicable, no authorised representative has been appointed", article: 83, paragraph: 1, point: "f", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)(f)"};
MERGE (n:Provision {id: "art_83__para_1__point_g"})
  SET n += {eid: "art_83__para_1__point_g", citation: "Art. 83(1)(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_1__point_g", chunk_type: "point", level: "point", text: "technical documentation is not available", article: 83, paragraph: 1, point: "g", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(1)(g)"};
MERGE (n:Provision {id: "art_83__para_2"})
  SET n += {eid: "art_83__para_2", citation: "Art. 83(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_83__para_2", chunk_type: "paragraph", level: "para", text: "Where the non-compliance referred to in paragraph 1 persists, the market surveillance authority of the Member State concerned shall take appropriate and proportionate measures to restrict or prohibit the high-risk AI system being made available on the market or to ensure that it is recalled or withdrawn from the market without delay.", article: 83, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 83(2)"};
MERGE (n:Provision {id: "art_84"})
  SET n += {eid: "art_84", citation: "Art. 84", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_84", chunk_type: "article_full", level: "art", text: "Article 84 — Union AI testing support structures\n\n1. The Commission shall designate one or more Union AI testing support structures to perform the tasks listed under Article 21(6) of Regulation (EU) 2019/1020 in the area of AI.\n\n2. Without prejudice to the tasks referred to in paragraph 1, Union AI testing support structures shall also provide independent technical or scientific advice at the request of the Board, the Commission, or of market surveillance authorities.", article: 84, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 84"};
MERGE (n:Provision {id: "art_84__para_1"})
  SET n += {eid: "art_84__para_1", citation: "Art. 84(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_84__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall designate one or more Union AI testing support structures to perform the tasks listed under Article 21(6) of Regulation (EU) 2019/1020 in the area of AI.", article: 84, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 84(1)"};
MERGE (n:Provision {id: "art_84__para_2"})
  SET n += {eid: "art_84__para_2", citation: "Art. 84(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_84__para_2", chunk_type: "paragraph", level: "para", text: "Without prejudice to the tasks referred to in paragraph 1, Union AI testing support structures shall also provide independent technical or scientific advice at the request of the Board, the Commission, or of market surveillance authorities.", article: 84, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 84(2)"};
MERGE (n:Provision {id: "art_85"})
  SET n += {eid: "art_85", citation: "Art. 85", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_85", chunk_type: "article_full", level: "art", text: "Article 85 — Right to lodge a complaint with a market surveillance authority\n\nWithout prejudice to other administrative or judicial remedies, any natural or legal person having grounds to consider that there has been an infringement of the provisions of this Regulation may submit complaints to the relevant market surveillance authority.\n\nIn accordance with Regulation (EU) 2019/1020, such complaints shall be taken into account for the purpose of conducting market surveillance activities, and shall be handled in line with the dedicated procedures established therefor by the market surveillance authorities.", article: 85, chapter: 9, section: "4", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 85"};
MERGE (n:Provision {id: "art_86"})
  SET n += {eid: "art_86", citation: "Art. 86", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_86", chunk_type: "article_full", level: "art", text: "Article 86 — Right to explanation of individual decision-making\n\n1. Any affected person subject to a decision which is taken by the deployer on the basis of the output from a high-risk AI system listed in Annex III, with the exception of systems listed under point 2 thereof, and which produces legal effects or similarly significantly affects that person in a way that they consider to have an adverse impact on their health, safety or fundamental rights shall have the right to obtain from the deployer clear and meaningful explanations of the role of the AI system in the decision-making procedure and the main elements of the decision taken.\n\n2. Paragraph 1 shall not apply to the use of AI systems for which exceptions from, or restrictions to, the obligation under that paragraph follow from Union or national law in compliance with Union law.\n\n3. This Article shall apply only to the extent that the right referred to in paragraph 1 is not otherwise provided for under Union law.", article: 86, chapter: 9, section: "4", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 86"};
MERGE (n:Provision {id: "art_86__para_1"})
  SET n += {eid: "art_86__para_1", citation: "Art. 86(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_86__para_1", chunk_type: "paragraph", level: "para", text: "Any affected person subject to a decision which is taken by the deployer on the basis of the output from a high-risk AI system listed in Annex III, with the exception of systems listed under point 2 thereof, and which produces legal effects or similarly significantly affects that person in a way that they consider to have an adverse impact on their health, safety or fundamental rights shall have the right to obtain from the deployer clear and meaningful explanations of the role of the AI system in the decision-making procedure and the main elements of the decision taken.", article: 86, paragraph: 1, chapter: 9, section: "4", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 86(1)"};
MERGE (n:Provision {id: "art_86__para_2"})
  SET n += {eid: "art_86__para_2", citation: "Art. 86(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_86__para_2", chunk_type: "paragraph", level: "para", text: "Paragraph 1 shall not apply to the use of AI systems for which exceptions from, or restrictions to, the obligation under that paragraph follow from Union or national law in compliance with Union law.", article: 86, paragraph: 2, chapter: 9, section: "4", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 86(2)"};
MERGE (n:Provision {id: "art_86__para_3"})
  SET n += {eid: "art_86__para_3", citation: "Art. 86(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_86__para_3", chunk_type: "paragraph", level: "para", text: "This Article shall apply only to the extent that the right referred to in paragraph 1 is not otherwise provided for under Union law.", article: 86, paragraph: 3, chapter: 9, section: "4", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 86(3)"};
MERGE (n:Provision {id: "art_87"})
  SET n += {eid: "art_87", citation: "Art. 87", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_87", chunk_type: "article_full", level: "art", text: "Article 87 — Reporting of infringements and protection of reporting persons\n\nDirective (EU) 2019/1937 shall apply to the reporting of infringements of this Regulation and the protection of persons reporting such infringements.", article: 87, chapter: 9, section: "4", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 87"};
MERGE (n:Provision {id: "art_88"})
  SET n += {eid: "art_88", citation: "Art. 88", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_88", chunk_type: "article_full", level: "art", text: "Article 88 — Enforcement of the obligations of providers of general-purpose AI models\n\n1. The Commission shall have exclusive powers to supervise and enforce Chapter V, taking into account the procedural guarantees under Article 94. The Commission shall entrust the implementation of these tasks to the AI Office, without prejudice to the powers of organisation of the Commission and the division of competences between Member States and the Union based on the Treaties.\n\n2. Without prejudice to Article 75(3), market surveillance authorities may request the Commission to exercise the powers laid down in this Section, where that is necessary and proportionate to assist with the fulfilment of their tasks under this Regulation.", article: 88, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 88"};
MERGE (n:Provision {id: "art_88__para_1"})
  SET n += {eid: "art_88__para_1", citation: "Art. 88(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_88__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall have exclusive powers to supervise and enforce Chapter V, taking into account the procedural guarantees under Article 94. The Commission shall entrust the implementation of these tasks to the AI Office, without prejudice to the powers of organisation of the Commission and the division of competences between Member States and the Union based on the Treaties.", article: 88, paragraph: 1, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 88(1)"};
MERGE (n:Provision {id: "art_88__para_2"})
  SET n += {eid: "art_88__para_2", citation: "Art. 88(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_88__para_2", chunk_type: "paragraph", level: "para", text: "Without prejudice to Article 75(3), market surveillance authorities may request the Commission to exercise the powers laid down in this Section, where that is necessary and proportionate to assist with the fulfilment of their tasks under this Regulation.", article: 88, paragraph: 2, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 88(2)"};
MERGE (n:Provision {id: "art_89"})
  SET n += {eid: "art_89", citation: "Art. 89", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_89", chunk_type: "article_full", level: "art", text: "Article 89 — Monitoring actions\n\n1. For the purpose of carrying out the tasks assigned to it under this Section, the AI Office may take the necessary actions to monitor the effective implementation and compliance with this Regulation by providers of general-purpose AI models, including their adherence to approved codes of practice.\n\n2. Downstream providers shall have the right to lodge a complaint alleging an infringement of this Regulation. A complaint shall be duly reasoned and indicate at least:\n(a) the point of contact of the provider of the general-purpose AI model concerned;\n(b) a description of the relevant facts, the provisions of this Regulation concerned, and the reason why the downstream provider considers that the provider of the general-purpose AI model concerned infringed this Regulation;\n(c) any other information that the downstream provider that sent the request considers relevant, including, where appropriate, information gathered on its own initiative.", article: 89, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 89"};
MERGE (n:Provision {id: "art_89__para_1"})
  SET n += {eid: "art_89__para_1", citation: "Art. 89(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_89__para_1", chunk_type: "paragraph", level: "para", text: "For the purpose of carrying out the tasks assigned to it under this Section, the AI Office may take the necessary actions to monitor the effective implementation and compliance with this Regulation by providers of general-purpose AI models, including their adherence to approved codes of practice.", article: 89, paragraph: 1, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 89(1)"};
MERGE (n:Provision {id: "art_89__para_2"})
  SET n += {eid: "art_89__para_2", citation: "Art. 89(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_89__para_2", chunk_type: "paragraph", level: "para", text: "Downstream providers shall have the right to lodge a complaint alleging an infringement of this Regulation. A complaint shall be duly reasoned and indicate at least:\n(a) the point of contact of the provider of the general-purpose AI model concerned;\n(b) a description of the relevant facts, the provisions of this Regulation concerned, and the reason why the downstream provider considers that the provider of the general-purpose AI model concerned infringed this Regulation;\n(c) any other information that the downstream provider that sent the request considers relevant, including, where appropriate, information gathered on its own initiative.", article: 89, paragraph: 2, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 89(2)"};
MERGE (n:Provision {id: "art_89__para_2__point_a"})
  SET n += {eid: "art_89__para_2__point_a", citation: "Art. 89(2)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_89__para_2__point_a", chunk_type: "point", level: "point", text: "the point of contact of the provider of the general-purpose AI model concerned", article: 89, paragraph: 2, point: "a", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 89(2)(a)"};
MERGE (n:Provision {id: "art_89__para_2__point_b"})
  SET n += {eid: "art_89__para_2__point_b", citation: "Art. 89(2)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_89__para_2__point_b", chunk_type: "point", level: "point", text: "a description of the relevant facts, the provisions of this Regulation concerned, and the reason why the downstream provider considers that the provider of the general-purpose AI model concerned infringed this Regulation", article: 89, paragraph: 2, point: "b", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 89(2)(b)"};
MERGE (n:Provision {id: "art_89__para_2__point_c"})
  SET n += {eid: "art_89__para_2__point_c", citation: "Art. 89(2)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_89__para_2__point_c", chunk_type: "point", level: "point", text: "any other information that the downstream provider that sent the request considers relevant, including, where appropriate, information gathered on its own initiative", article: 89, paragraph: 2, point: "c", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 89(2)(c)"};
MERGE (n:Provision {id: "art_90"})
  SET n += {eid: "art_90", citation: "Art. 90", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90", chunk_type: "article_full", level: "art", text: "Article 90 — Alerts of systemic risks by the scientific panel\n\n1. The scientific panel may provide a qualified alert to the AI Office where it has reason to suspect that:\n(a) a general-purpose AI model poses concrete identifiable risk at Union level; or\n(b) a general-purpose AI model meets the conditions referred to in Article 51.\n\n2. Upon such qualified alert, the Commission, through the AI Office and after having informed the Board, may exercise the powers laid down in this Section for the purpose of assessing the matter. The AI Office shall inform the Board of any measure according to Articles 91 to 94.\n\n3. A qualified alert shall be duly reasoned and indicate at least:\n(a) the point of contact of the provider of the general-purpose AI model with systemic risk concerned;\n(b) a description of the relevant facts and the reasons for the alert by the scientific panel;\n(c) any other information that the scientific panel considers to be relevant, including, where appropriate, information gathered on its own initiative.", article: 90, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90"};
MERGE (n:Provision {id: "art_90__para_1"})
  SET n += {eid: "art_90__para_1", citation: "Art. 90(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_1", chunk_type: "paragraph", level: "para", text: "The scientific panel may provide a qualified alert to the AI Office where it has reason to suspect that:\n(a) a general-purpose AI model poses concrete identifiable risk at Union level; or\n(b) a general-purpose AI model meets the conditions referred to in Article 51.", article: 90, paragraph: 1, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(1)"};
MERGE (n:Provision {id: "art_90__para_1__point_a"})
  SET n += {eid: "art_90__para_1__point_a", citation: "Art. 90(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_1__point_a", chunk_type: "point", level: "point", text: "a general-purpose AI model poses concrete identifiable risk at Union level; or", article: 90, paragraph: 1, point: "a", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(1)(a)"};
MERGE (n:Provision {id: "art_90__para_1__point_b"})
  SET n += {eid: "art_90__para_1__point_b", citation: "Art. 90(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_1__point_b", chunk_type: "point", level: "point", text: "a general-purpose AI model meets the conditions referred to in Article 51", article: 90, paragraph: 1, point: "b", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(1)(b)"};
MERGE (n:Provision {id: "art_90__para_2"})
  SET n += {eid: "art_90__para_2", citation: "Art. 90(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_2", chunk_type: "paragraph", level: "para", text: "Upon such qualified alert, the Commission, through the AI Office and after having informed the Board, may exercise the powers laid down in this Section for the purpose of assessing the matter. The AI Office shall inform the Board of any measure according to Articles 91 to 94.", article: 90, paragraph: 2, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(2)"};
MERGE (n:Provision {id: "art_90__para_3"})
  SET n += {eid: "art_90__para_3", citation: "Art. 90(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_3", chunk_type: "paragraph", level: "para", text: "A qualified alert shall be duly reasoned and indicate at least:\n(a) the point of contact of the provider of the general-purpose AI model with systemic risk concerned;\n(b) a description of the relevant facts and the reasons for the alert by the scientific panel;\n(c) any other information that the scientific panel considers to be relevant, including, where appropriate, information gathered on its own initiative.", article: 90, paragraph: 3, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(3)"};
MERGE (n:Provision {id: "art_90__para_3__point_a"})
  SET n += {eid: "art_90__para_3__point_a", citation: "Art. 90(3)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_3__point_a", chunk_type: "point", level: "point", text: "the point of contact of the provider of the general-purpose AI model with systemic risk concerned", article: 90, paragraph: 3, point: "a", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(3)(a)"};
MERGE (n:Provision {id: "art_90__para_3__point_b"})
  SET n += {eid: "art_90__para_3__point_b", citation: "Art. 90(3)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_3__point_b", chunk_type: "point", level: "point", text: "a description of the relevant facts and the reasons for the alert by the scientific panel", article: 90, paragraph: 3, point: "b", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(3)(b)"};
MERGE (n:Provision {id: "art_90__para_3__point_c"})
  SET n += {eid: "art_90__para_3__point_c", citation: "Art. 90(3)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_90__para_3__point_c", chunk_type: "point", level: "point", text: "any other information that the scientific panel considers to be relevant, including, where appropriate, information gathered on its own initiative", article: 90, paragraph: 3, point: "c", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 90(3)(c)"};
MERGE (n:Provision {id: "art_91"})
  SET n += {eid: "art_91", citation: "Art. 91", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_91", chunk_type: "article_full", level: "art", text: "Article 91 — Power to request documentation and information\n\n1. The Commission may request the provider of the general-purpose AI model concerned to provide the documentation drawn up by the provider in accordance with Articles 53 and 55, or any additional information that is necessary for the purpose of assessing compliance of the provider with this Regulation.\n\n2. Before sending the request for information, the AI Office may initiate a structured dialogue with the provider of the general-purpose AI model.\n\n3. Upon a duly substantiated request from the scientific panel, the Commission may issue a request for information to a provider of a general-purpose AI model, where the access to information is necessary and proportionate for the fulfilment of the tasks of the scientific panel under Article 68(2).\n\n4. The request for information shall state the legal basis and the purpose of the request, specify what information is required, set a period within which the information is to be provided, and indicate the fines provided for in Article 101 for supplying incorrect, incomplete or misleading information.\n\n5. The provider of the general-purpose AI model concerned, or its representative shall supply the information requested. In the case of legal persons, companies or firms, or where the provider has no legal personality, the persons authorised to represent them by law or by their statutes, shall supply the information requested on behalf of the provider of the general-purpose AI model concerned. Lawyers duly authorised to act may supply information on behalf of their clients. The clients shall nevertheless remain fully responsible if the information supplied is incomplete, incorrect or misleading.", article: 91, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 91"};
MERGE (n:Provision {id: "art_91__para_1"})
  SET n += {eid: "art_91__para_1", citation: "Art. 91(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_91__para_1", chunk_type: "paragraph", level: "para", text: "The Commission may request the provider of the general-purpose AI model concerned to provide the documentation drawn up by the provider in accordance with Articles 53 and 55, or any additional information that is necessary for the purpose of assessing compliance of the provider with this Regulation.", article: 91, paragraph: 1, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 91(1)"};
MERGE (n:Provision {id: "art_91__para_2"})
  SET n += {eid: "art_91__para_2", citation: "Art. 91(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_91__para_2", chunk_type: "paragraph", level: "para", text: "Before sending the request for information, the AI Office may initiate a structured dialogue with the provider of the general-purpose AI model.", article: 91, paragraph: 2, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 91(2)"};
MERGE (n:Provision {id: "art_91__para_3"})
  SET n += {eid: "art_91__para_3", citation: "Art. 91(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_91__para_3", chunk_type: "paragraph", level: "para", text: "Upon a duly substantiated request from the scientific panel, the Commission may issue a request for information to a provider of a general-purpose AI model, where the access to information is necessary and proportionate for the fulfilment of the tasks of the scientific panel under Article 68(2).", article: 91, paragraph: 3, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 91(3)"};
MERGE (n:Provision {id: "art_91__para_4"})
  SET n += {eid: "art_91__para_4", citation: "Art. 91(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_91__para_4", chunk_type: "paragraph", level: "para", text: "The request for information shall state the legal basis and the purpose of the request, specify what information is required, set a period within which the information is to be provided, and indicate the fines provided for in Article 101 for supplying incorrect, incomplete or misleading information.", article: 91, paragraph: 4, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 91(4)"};
MERGE (n:Provision {id: "art_91__para_5"})
  SET n += {eid: "art_91__para_5", citation: "Art. 91(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_91__para_5", chunk_type: "paragraph", level: "para", text: "The provider of the general-purpose AI model concerned, or its representative shall supply the information requested. In the case of legal persons, companies or firms, or where the provider has no legal personality, the persons authorised to represent them by law or by their statutes, shall supply the information requested on behalf of the provider of the general-purpose AI model concerned. Lawyers duly authorised to act may supply information on behalf of their clients. The clients shall nevertheless remain fully responsible if the information supplied is incomplete, incorrect or misleading.", article: 91, paragraph: 5, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 91(5)"};
MERGE (n:Provision {id: "art_92"})
  SET n += {eid: "art_92", citation: "Art. 92", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92", chunk_type: "article_full", level: "art", text: "Article 92 — Power to conduct evaluations\n\n1. The AI Office, after consulting the Board, may conduct evaluations of the general-purpose AI model concerned:\n(a) to assess compliance of the provider with obligations under this Regulation, where the information gathered pursuant to Article 91 is insufficient; or\n(b) to investigate systemic risks at Union level of general-purpose AI models with systemic risk, in particular following a qualified alert from the scientific panel in accordance with Article 90(1), point (a).\n\n2. The Commission may decide to appoint independent experts to carry out evaluations on its behalf, including from the scientific panel established pursuant to Article 68. Independent experts appointed for this task shall meet the criteria outlined in Article 68(2).\n\n3. For the purposes of paragraph 1, the Commission may request access to the general-purpose AI model concerned through APIs or further appropriate technical means and tools, including source code.\n\n4. The request for access shall state the legal basis, the purpose and reasons of the request and set the period within which the access is to be provided, and the fines provided for in Article 101 for failure to provide access.\n\n5. The providers of the general-purpose AI model concerned or its representative shall supply the information requested. In the case of legal persons, companies or firms, or where the provider has no legal personality, the persons authorised to represent them by law or by their statutes, shall provide the access requested on behalf of the provider of the general-purpose AI model concerned.\n\n6. The Commission shall adopt implementing acts setting out the detailed arrangements and the conditions for the evaluations, including the detailed arrangements for involving independent experts, and the procedure for the selection thereof. Those implementing acts shall be adopted in accordance with the examination procedure referred to in Article 98(2).\n\n7. Prior to requesting access to the general-purpose AI model concerned, the AI Office may initiate a structured dialogue with the provider of the general-purpose AI model to gather more information on the internal testing of the model, internal safeguards for preventing systemic risks, and other internal procedures and measures the provider has taken to mitigate such risks.", article: 92, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92"};
MERGE (n:Provision {id: "art_92__para_1"})
  SET n += {eid: "art_92__para_1", citation: "Art. 92(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_1", chunk_type: "paragraph", level: "para", text: "The AI Office, after consulting the Board, may conduct evaluations of the general-purpose AI model concerned:\n(a) to assess compliance of the provider with obligations under this Regulation, where the information gathered pursuant to Article 91 is insufficient; or\n(b) to investigate systemic risks at Union level of general-purpose AI models with systemic risk, in particular following a qualified alert from the scientific panel in accordance with Article 90(1), point (a).", article: 92, paragraph: 1, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(1)"};
MERGE (n:Provision {id: "art_92__para_1__point_a"})
  SET n += {eid: "art_92__para_1__point_a", citation: "Art. 92(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_1__point_a", chunk_type: "point", level: "point", text: "to assess compliance of the provider with obligations under this Regulation, where the information gathered pursuant to Article 91 is insufficient; or", article: 92, paragraph: 1, point: "a", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(1)(a)"};
MERGE (n:Provision {id: "art_92__para_1__point_b"})
  SET n += {eid: "art_92__para_1__point_b", citation: "Art. 92(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_1__point_b", chunk_type: "point", level: "point", text: "to investigate systemic risks at Union level of general-purpose AI models with systemic risk, in particular following a qualified alert from the scientific panel in accordance with Article 90(1), point (a)", article: 92, paragraph: 1, point: "b", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(1)(b)"};
MERGE (n:Provision {id: "art_92__para_2"})
  SET n += {eid: "art_92__para_2", citation: "Art. 92(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_2", chunk_type: "paragraph", level: "para", text: "The Commission may decide to appoint independent experts to carry out evaluations on its behalf, including from the scientific panel established pursuant to Article 68. Independent experts appointed for this task shall meet the criteria outlined in Article 68(2).", article: 92, paragraph: 2, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(2)"};
MERGE (n:Provision {id: "art_92__para_3"})
  SET n += {eid: "art_92__para_3", citation: "Art. 92(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_3", chunk_type: "paragraph", level: "para", text: "For the purposes of paragraph 1, the Commission may request access to the general-purpose AI model concerned through APIs or further appropriate technical means and tools, including source code.", article: 92, paragraph: 3, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(3)"};
MERGE (n:Provision {id: "art_92__para_4"})
  SET n += {eid: "art_92__para_4", citation: "Art. 92(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_4", chunk_type: "paragraph", level: "para", text: "The request for access shall state the legal basis, the purpose and reasons of the request and set the period within which the access is to be provided, and the fines provided for in Article 101 for failure to provide access.", article: 92, paragraph: 4, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(4)"};
MERGE (n:Provision {id: "art_92__para_5"})
  SET n += {eid: "art_92__para_5", citation: "Art. 92(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_5", chunk_type: "paragraph", level: "para", text: "The providers of the general-purpose AI model concerned or its representative shall supply the information requested. In the case of legal persons, companies or firms, or where the provider has no legal personality, the persons authorised to represent them by law or by their statutes, shall provide the access requested on behalf of the provider of the general-purpose AI model concerned.", article: 92, paragraph: 5, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(5)"};
MERGE (n:Provision {id: "art_92__para_6"})
  SET n += {eid: "art_92__para_6", citation: "Art. 92(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_6", chunk_type: "paragraph", level: "para", text: "The Commission shall adopt implementing acts setting out the detailed arrangements and the conditions for the evaluations, including the detailed arrangements for involving independent experts, and the procedure for the selection thereof. Those implementing acts shall be adopted in accordance with the examination procedure referred to in Article 98(2).", article: 92, paragraph: 6, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(6)"};
MERGE (n:Provision {id: "art_92__para_7"})
  SET n += {eid: "art_92__para_7", citation: "Art. 92(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_92__para_7", chunk_type: "paragraph", level: "para", text: "Prior to requesting access to the general-purpose AI model concerned, the AI Office may initiate a structured dialogue with the provider of the general-purpose AI model to gather more information on the internal testing of the model, internal safeguards for preventing systemic risks, and other internal procedures and measures the provider has taken to mitigate such risks.", article: 92, paragraph: 7, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 92(7)"};
MERGE (n:Provision {id: "art_93"})
  SET n += {eid: "art_93", citation: "Art. 93", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_93", chunk_type: "article_full", level: "art", text: "Article 93 — Power to request measures\n\n1. Where necessary and appropriate, the Commission may request providers to:\n(a) take appropriate measures to comply with the obligations set out in Articles 53 and 54;\n(b) implement mitigation measures, where the evaluation carried out in accordance with Article 92 has given rise to serious and substantiated concern of a systemic risk at Union level;\n(c) restrict the making available on the market, withdraw or recall the model.\n\n2. Before a measure is requested, the AI Office may initiate a structured dialogue with the provider of the general-purpose AI model.\n\n3. If, during the structured dialogue referred to in paragraph 2, the provider of the general-purpose AI model with systemic risk offers commitments to implement mitigation measures to address a systemic risk at Union level, the Commission may, by decision, make those commitments binding and declare that there are no further grounds for action.", article: 93, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 93"};
MERGE (n:Provision {id: "art_93__para_1"})
  SET n += {eid: "art_93__para_1", citation: "Art. 93(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_93__para_1", chunk_type: "paragraph", level: "para", text: "Where necessary and appropriate, the Commission may request providers to:\n(a) take appropriate measures to comply with the obligations set out in Articles 53 and 54;\n(b) implement mitigation measures, where the evaluation carried out in accordance with Article 92 has given rise to serious and substantiated concern of a systemic risk at Union level;\n(c) restrict the making available on the market, withdraw or recall the model.", article: 93, paragraph: 1, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 93(1)"};
MERGE (n:Provision {id: "art_93__para_1__point_a"})
  SET n += {eid: "art_93__para_1__point_a", citation: "Art. 93(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_93__para_1__point_a", chunk_type: "point", level: "point", text: "take appropriate measures to comply with the obligations set out in Articles 53 and 54", article: 93, paragraph: 1, point: "a", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 93(1)(a)"};
MERGE (n:Provision {id: "art_93__para_1__point_b"})
  SET n += {eid: "art_93__para_1__point_b", citation: "Art. 93(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_93__para_1__point_b", chunk_type: "point", level: "point", text: "implement mitigation measures, where the evaluation carried out in accordance with Article 92 has given rise to serious and substantiated concern of a systemic risk at Union level", article: 93, paragraph: 1, point: "b", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 93(1)(b)"};
MERGE (n:Provision {id: "art_93__para_1__point_c"})
  SET n += {eid: "art_93__para_1__point_c", citation: "Art. 93(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_93__para_1__point_c", chunk_type: "point", level: "point", text: "restrict the making available on the market, withdraw or recall the model", article: 93, paragraph: 1, point: "c", chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 93(1)(c)"};
MERGE (n:Provision {id: "art_93__para_2"})
  SET n += {eid: "art_93__para_2", citation: "Art. 93(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_93__para_2", chunk_type: "paragraph", level: "para", text: "Before a measure is requested, the AI Office may initiate a structured dialogue with the provider of the general-purpose AI model.", article: 93, paragraph: 2, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 93(2)"};
MERGE (n:Provision {id: "art_93__para_3"})
  SET n += {eid: "art_93__para_3", citation: "Art. 93(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_93__para_3", chunk_type: "paragraph", level: "para", text: "If, during the structured dialogue referred to in paragraph 2, the provider of the general-purpose AI model with systemic risk offers commitments to implement mitigation measures to address a systemic risk at Union level, the Commission may, by decision, make those commitments binding and declare that there are no further grounds for action.", article: 93, paragraph: 3, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 93(3)"};
MERGE (n:Provision {id: "art_94"})
  SET n += {eid: "art_94", citation: "Art. 94", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_94", chunk_type: "article_full", level: "art", text: "Article 94 — Procedural rights of economic operators of the general-purpose AI model\n\nArticle 18 of Regulation (EU) 2019/1020 shall apply mutatis mutandis to the providers of the general-purpose AI model, without prejudice to more specific procedural rights provided for in this Regulation.", article: 94, chapter: 9, section: "5", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 94"};
MERGE (n:Provision {id: "art_95"})
  SET n += {eid: "art_95", citation: "Art. 95", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95", chunk_type: "article_full", level: "art", text: "Article 95 — Codes of conduct for voluntary application of specific requirements\n\n1. The AI Office and the Member States shall encourage and facilitate the drawing up of codes of conduct, including related governance mechanisms, intended to foster the voluntary application to AI systems, other than high-risk AI systems, of some or all of the requirements set out in Chapter III, Section 2 taking into account the available technical solutions and industry best practices allowing for the application of such requirements.\n\n2. The AI Office and the Member States shall facilitate the drawing up of codes of conduct concerning the voluntary application, including by deployers, of specific requirements to all AI systems, on the basis of clear objectives and key performance indicators to measure the achievement of those objectives, including elements such as, but not limited to:\n(a) applicable elements provided for in Union ethical guidelines for trustworthy AI;\n(b) assessing and minimising the impact of AI systems on environmental sustainability, including as regards energy-efficient programming and techniques for the efficient design, training and use of AI;\n(c) promoting AI literacy, in particular that of persons dealing with the development, operation and use of AI;\n(d) facilitating an inclusive and diverse design of AI systems, including through the establishment of inclusive and diverse development teams and the promotion of stakeholders’ participation in that process;\n(e) assessing and preventing the negative impact of AI systems on vulnerable persons or groups of vulnerable persons, including as regards accessibility for persons with a disability, as well as on gender equality.\n\n3. Codes of conduct may be drawn up by individual providers or deployers of AI systems or by organisations representing them or by both, including with the involvement of any interested stakeholders and their representative organisations, including civil society organisations and academia. Codes of conduct may cover one or more AI systems taking into account the similarity of the intended purpose of the relevant systems.\n\n4. The AI Office and the Member States shall take into account the specific interests and needs of SMEs, including start-ups, when encouraging and facilitating the drawing up of codes of conduct.", article: 95, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95"};
MERGE (n:Provision {id: "art_95__para_1"})
  SET n += {eid: "art_95__para_1", citation: "Art. 95(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_1", chunk_type: "paragraph", level: "para", text: "The AI Office and the Member States shall encourage and facilitate the drawing up of codes of conduct, including related governance mechanisms, intended to foster the voluntary application to AI systems, other than high-risk AI systems, of some or all of the requirements set out in Chapter III, Section 2 taking into account the available technical solutions and industry best practices allowing for the application of such requirements.", article: 95, paragraph: 1, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(1)"};
MERGE (n:Provision {id: "art_95__para_2"})
  SET n += {eid: "art_95__para_2", citation: "Art. 95(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_2", chunk_type: "paragraph", level: "para", text: "The AI Office and the Member States shall facilitate the drawing up of codes of conduct concerning the voluntary application, including by deployers, of specific requirements to all AI systems, on the basis of clear objectives and key performance indicators to measure the achievement of those objectives, including elements such as, but not limited to:\n(a) applicable elements provided for in Union ethical guidelines for trustworthy AI;\n(b) assessing and minimising the impact of AI systems on environmental sustainability, including as regards energy-efficient programming and techniques for the efficient design, training and use of AI;\n(c) promoting AI literacy, in particular that of persons dealing with the development, operation and use of AI;\n(d) facilitating an inclusive and diverse design of AI systems, including through the establishment of inclusive and diverse development teams and the promotion of stakeholders’ participation in that process;\n(e) assessing and preventing the negative impact of AI systems on vulnerable persons or groups of vulnerable persons, including as regards accessibility for persons with a disability, as well as on gender equality.", article: 95, paragraph: 2, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(2)"};
MERGE (n:Provision {id: "art_95__para_2__point_a"})
  SET n += {eid: "art_95__para_2__point_a", citation: "Art. 95(2)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_2__point_a", chunk_type: "point", level: "point", text: "applicable elements provided for in Union ethical guidelines for trustworthy AI", article: 95, paragraph: 2, point: "a", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(2)(a)"};
MERGE (n:Provision {id: "art_95__para_2__point_b"})
  SET n += {eid: "art_95__para_2__point_b", citation: "Art. 95(2)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_2__point_b", chunk_type: "point", level: "point", text: "assessing and minimising the impact of AI systems on environmental sustainability, including as regards energy-efficient programming and techniques for the efficient design, training and use of AI", article: 95, paragraph: 2, point: "b", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(2)(b)"};
MERGE (n:Provision {id: "art_95__para_2__point_c"})
  SET n += {eid: "art_95__para_2__point_c", citation: "Art. 95(2)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_2__point_c", chunk_type: "point", level: "point", text: "promoting AI literacy, in particular that of persons dealing with the development, operation and use of AI", article: 95, paragraph: 2, point: "c", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(2)(c)"};
MERGE (n:Provision {id: "art_95__para_2__point_d"})
  SET n += {eid: "art_95__para_2__point_d", citation: "Art. 95(2)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_2__point_d", chunk_type: "point", level: "point", text: "facilitating an inclusive and diverse design of AI systems, including through the establishment of inclusive and diverse development teams and the promotion of stakeholders’ participation in that process", article: 95, paragraph: 2, point: "d", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(2)(d)"};
MERGE (n:Provision {id: "art_95__para_2__point_e"})
  SET n += {eid: "art_95__para_2__point_e", citation: "Art. 95(2)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_2__point_e", chunk_type: "point", level: "point", text: "assessing and preventing the negative impact of AI systems on vulnerable persons or groups of vulnerable persons, including as regards accessibility for persons with a disability, as well as on gender equality", article: 95, paragraph: 2, point: "e", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(2)(e)"};
MERGE (n:Provision {id: "art_95__para_3"})
  SET n += {eid: "art_95__para_3", citation: "Art. 95(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_3", chunk_type: "paragraph", level: "para", text: "Codes of conduct may be drawn up by individual providers or deployers of AI systems or by organisations representing them or by both, including with the involvement of any interested stakeholders and their representative organisations, including civil society organisations and academia. Codes of conduct may cover one or more AI systems taking into account the similarity of the intended purpose of the relevant systems.", article: 95, paragraph: 3, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(3)"};
MERGE (n:Provision {id: "art_95__para_4"})
  SET n += {eid: "art_95__para_4", citation: "Art. 95(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_95__para_4", chunk_type: "paragraph", level: "para", text: "The AI Office and the Member States shall take into account the specific interests and needs of SMEs, including start-ups, when encouraging and facilitating the drawing up of codes of conduct.", article: 95, paragraph: 4, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 95(4)"};
MERGE (n:Provision {id: "art_96"})
  SET n += {eid: "art_96", citation: "Art. 96", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96", chunk_type: "article_full", level: "art", text: "Article 96 — Guidelines from the Commission on the implementation of this Regulation\n\n1. The Commission shall develop guidelines on the practical implementation of this Regulation, and in particular on:\n(a) the application of the requirements and obligations referred to in Articles 8 to 15 and in Article 25;\n(b) the prohibited practices referred to in Article 5;\n(c) the practical implementation of the provisions related to substantial modification;\n(d) the practical implementation of transparency obligations laid down in Article 50;\n(e) detailed information on the relationship of this Regulation with the Union harmonisation legislation listed in Annex I, as well as with other relevant Union law, including as regards consistency in their enforcement;\n(f) the application of the definition of an AI system as set out in Article 3, point (1).\nWhen issuing such guidelines, the Commission shall pay particular attention to the needs of SMEs including start-ups, of local public authorities and of the sectors most likely to be affected by this Regulation. The guidelines referred to in the first subparagraph of this paragraph shall take due account of the generally acknowledged state of the art on AI, as well as of relevant harmonised standards and common specifications that are referred to in Articles 40 and 41, or of those harmonised standards or technical specifications that are set out pursuant to Union harmonisation law.\n\n2. At the request of the Member States or the AI Office, or on its own initiative, the Commission shall update guidelines previously adopted when deemed necessary.", article: 96, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96"};
MERGE (n:Provision {id: "art_96__para_1"})
  SET n += {eid: "art_96__para_1", citation: "Art. 96(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall develop guidelines on the practical implementation of this Regulation, and in particular on:\n(a) the application of the requirements and obligations referred to in Articles 8 to 15 and in Article 25;\n(b) the prohibited practices referred to in Article 5;\n(c) the practical implementation of the provisions related to substantial modification;\n(d) the practical implementation of transparency obligations laid down in Article 50;\n(e) detailed information on the relationship of this Regulation with the Union harmonisation legislation listed in Annex I, as well as with other relevant Union law, including as regards consistency in their enforcement;\n(f) the application of the definition of an AI system as set out in Article 3, point (1).\nWhen issuing such guidelines, the Commission shall pay particular attention to the needs of SMEs including start-ups, of local public authorities and of the sectors most likely to be affected by this Regulation. The guidelines referred to in the first subparagraph of this paragraph shall take due account of the generally acknowledged state of the art on AI, as well as of relevant harmonised standards and common specifications that are referred to in Articles 40 and 41, or of those harmonised standards or technical specifications that are set out pursuant to Union harmonisation law.", article: 96, paragraph: 1, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(1)"};
MERGE (n:Provision {id: "art_96__para_1__point_a"})
  SET n += {eid: "art_96__para_1__point_a", citation: "Art. 96(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_1__point_a", chunk_type: "point", level: "point", text: "the application of the requirements and obligations referred to in Articles 8 to 15 and in Article 25", article: 96, paragraph: 1, point: "a", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(1)(a)"};
MERGE (n:Provision {id: "art_96__para_1__point_b"})
  SET n += {eid: "art_96__para_1__point_b", citation: "Art. 96(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_1__point_b", chunk_type: "point", level: "point", text: "the prohibited practices referred to in Article 5", article: 96, paragraph: 1, point: "b", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(1)(b)"};
MERGE (n:Provision {id: "art_96__para_1__point_c"})
  SET n += {eid: "art_96__para_1__point_c", citation: "Art. 96(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_1__point_c", chunk_type: "point", level: "point", text: "the practical implementation of the provisions related to substantial modification", article: 96, paragraph: 1, point: "c", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(1)(c)"};
MERGE (n:Provision {id: "art_96__para_1__point_d"})
  SET n += {eid: "art_96__para_1__point_d", citation: "Art. 96(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_1__point_d", chunk_type: "point", level: "point", text: "the practical implementation of transparency obligations laid down in Article 50", article: 96, paragraph: 1, point: "d", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(1)(d)"};
MERGE (n:Provision {id: "art_96__para_1__point_e"})
  SET n += {eid: "art_96__para_1__point_e", citation: "Art. 96(1)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_1__point_e", chunk_type: "point", level: "point", text: "detailed information on the relationship of this Regulation with the Union harmonisation legislation listed in Annex I, as well as with other relevant Union law, including as regards consistency in their enforcement", article: 96, paragraph: 1, point: "e", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(1)(e)"};
MERGE (n:Provision {id: "art_96__para_1__point_f"})
  SET n += {eid: "art_96__para_1__point_f", citation: "Art. 96(1)(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_1__point_f", chunk_type: "point", level: "point", text: "the application of the definition of an AI system as set out in Article 3, point (1).\nWhen issuing such guidelines, the Commission shall pay particular attention to the needs of SMEs including start-ups, of local public authorities and of the sectors most likely to be affected by this Regulation. The guidelines referred to in the first subparagraph of this paragraph shall take due account of the generally acknowledged state of the art on AI, as well as of relevant harmonised standards and common specifications that are referred to in Articles 40 and 41, or of those harmonised standards or technical specifications that are set out pursuant to Union harmonisation law", article: 96, paragraph: 1, point: "f", chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(1)(f)"};
MERGE (n:Provision {id: "art_96__para_2"})
  SET n += {eid: "art_96__para_2", citation: "Art. 96(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_96__para_2", chunk_type: "paragraph", level: "para", text: "At the request of the Member States or the AI Office, or on its own initiative, the Commission shall update guidelines previously adopted when deemed necessary.", article: 96, paragraph: 2, chapter: 10, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 96(2)"};
MERGE (n:Provision {id: "art_97"})
  SET n += {eid: "art_97", citation: "Art. 97", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_97", chunk_type: "article_full", level: "art", text: "Article 97 — Exercise of the delegation\n\n1. The power to adopt delegated acts is conferred on the Commission subject to the conditions laid down in this Article.\n\n2. The power to adopt delegated acts referred to in Article 6(6) and (7), Article 7(1) and (3), Article 11(3), Article 43(5) and (6), Article 47(5), Article 51(3), Article 52(4) and Article 53(5) and (6) shall be conferred on the Commission for a period of five years from 1 August 2024. The Commission shall draw up a report in respect of the delegation of power not later than nine months before the end of the five-year period. The delegation of power shall be tacitly extended for periods of an identical duration, unless the European Parliament or the Council opposes such extension not later than three months before the end of each period.\n\n3. The delegation of power referred to in Article 6(6) and (7), Article 7(1) and (3), Article 11(3), Article 43(5) and (6), Article 47(5), Article 51(3), Article 52(4) and Article 53(5) and (6) may be revoked at any time by the European Parliament or by the Council. A decision of revocation shall put an end to the delegation of power specified in that decision. It shall take effect the day following that of its publication in the Official Journal of the European Union or at a later date specified therein. It shall not affect the validity of any delegated acts already in force.\n\n4. Before adopting a delegated act, the Commission shall consult experts designated by each Member State in accordance with the principles laid down in the Interinstitutional Agreement of 13 April 2016 on Better Law-Making.\n\n5. As soon as it adopts a delegated act, the Commission shall notify it simultaneously to the European Parliament and to the Council.\n\n6. Any delegated act adopted pursuant to Article 6(6) or (7), Article 7(1) or (3), Article 11(3), Article 43(5) or (6), Article 47(5), Article 51(3), Article 52(4) or Article 53(5) or (6) shall enter into force only if no objection has been expressed by either the European Parliament or the Council within a period of three months of notification of that act to the European Parliament and the Council or if, before the expiry of that period, the European Parliament and the Council have both informed the Commission that they will not object. That period shall be extended by three months at the initiative of the European Parliament or of the Council.", article: 97, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 97"};
MERGE (n:Provision {id: "art_97__para_1"})
  SET n += {eid: "art_97__para_1", citation: "Art. 97(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_97__para_1", chunk_type: "paragraph", level: "para", text: "The power to adopt delegated acts is conferred on the Commission subject to the conditions laid down in this Article.", article: 97, paragraph: 1, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 97(1)"};
MERGE (n:Provision {id: "art_97__para_2"})
  SET n += {eid: "art_97__para_2", citation: "Art. 97(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_97__para_2", chunk_type: "paragraph", level: "para", text: "The power to adopt delegated acts referred to in Article 6(6) and (7), Article 7(1) and (3), Article 11(3), Article 43(5) and (6), Article 47(5), Article 51(3), Article 52(4) and Article 53(5) and (6) shall be conferred on the Commission for a period of five years from 1 August 2024. The Commission shall draw up a report in respect of the delegation of power not later than nine months before the end of the five-year period. The delegation of power shall be tacitly extended for periods of an identical duration, unless the European Parliament or the Council opposes such extension not later than three months before the end of each period.", article: 97, paragraph: 2, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 97(2)"};
MERGE (n:Provision {id: "art_97__para_3"})
  SET n += {eid: "art_97__para_3", citation: "Art. 97(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_97__para_3", chunk_type: "paragraph", level: "para", text: "The delegation of power referred to in Article 6(6) and (7), Article 7(1) and (3), Article 11(3), Article 43(5) and (6), Article 47(5), Article 51(3), Article 52(4) and Article 53(5) and (6) may be revoked at any time by the European Parliament or by the Council. A decision of revocation shall put an end to the delegation of power specified in that decision. It shall take effect the day following that of its publication in the Official Journal of the European Union or at a later date specified therein. It shall not affect the validity of any delegated acts already in force.", article: 97, paragraph: 3, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 97(3)"};
MERGE (n:Provision {id: "art_97__para_4"})
  SET n += {eid: "art_97__para_4", citation: "Art. 97(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_97__para_4", chunk_type: "paragraph", level: "para", text: "Before adopting a delegated act, the Commission shall consult experts designated by each Member State in accordance with the principles laid down in the Interinstitutional Agreement of 13 April 2016 on Better Law-Making.", article: 97, paragraph: 4, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 97(4)"};
MERGE (n:Provision {id: "art_97__para_5"})
  SET n += {eid: "art_97__para_5", citation: "Art. 97(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_97__para_5", chunk_type: "paragraph", level: "para", text: "As soon as it adopts a delegated act, the Commission shall notify it simultaneously to the European Parliament and to the Council.", article: 97, paragraph: 5, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 97(5)"};
MERGE (n:Provision {id: "art_97__para_6"})
  SET n += {eid: "art_97__para_6", citation: "Art. 97(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_97__para_6", chunk_type: "paragraph", level: "para", text: "Any delegated act adopted pursuant to Article 6(6) or (7), Article 7(1) or (3), Article 11(3), Article 43(5) or (6), Article 47(5), Article 51(3), Article 52(4) or Article 53(5) or (6) shall enter into force only if no objection has been expressed by either the European Parliament or the Council within a period of three months of notification of that act to the European Parliament and the Council or if, before the expiry of that period, the European Parliament and the Council have both informed the Commission that they will not object. That period shall be extended by three months at the initiative of the European Parliament or of the Council.", article: 97, paragraph: 6, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 97(6)"};
MERGE (n:Provision {id: "art_98"})
  SET n += {eid: "art_98", citation: "Art. 98", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_98", chunk_type: "article_full", level: "art", text: "Article 98 — Committee procedure\n\n1. The Commission shall be assisted by a committee. That committee shall be a committee within the meaning of Regulation (EU) No 182/2011.\n\n2. Where reference is made to this paragraph, Article 5 of Regulation (EU) No 182/2011 shall apply.", article: 98, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 98"};
MERGE (n:Provision {id: "art_98__para_1"})
  SET n += {eid: "art_98__para_1", citation: "Art. 98(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_98__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall be assisted by a committee. That committee shall be a committee within the meaning of Regulation (EU) No 182/2011.", article: 98, paragraph: 1, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 98(1)"};
MERGE (n:Provision {id: "art_98__para_2"})
  SET n += {eid: "art_98__para_2", citation: "Art. 98(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_98__para_2", chunk_type: "paragraph", level: "para", text: "Where reference is made to this paragraph, Article 5 of Regulation (EU) No 182/2011 shall apply.", article: 98, paragraph: 2, chapter: 11, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 98(2)"};
MERGE (n:Provision {id: "art_99"})
  SET n += {eid: "art_99", citation: "Art. 99", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99", chunk_type: "article_full", level: "art", text: "Article 99 — Penalties\n\n1. In accordance with the terms and conditions laid down in this Regulation, Member States shall lay down the rules on penalties and other enforcement measures, which may also include warnings and non-monetary measures, applicable to infringements of this Regulation by operators, and shall take all measures necessary to ensure that they are properly and effectively implemented, thereby taking into account the guidelines issued by the Commission pursuant to Article 96. The penalties provided for shall be effective, proportionate and dissuasive. They shall take into account the interests of SMEs, including start-ups, and their economic viability.\n\n2. The Member States shall, without delay and at the latest by the date of entry into application, notify the Commission of the rules on penalties and of other enforcement measures referred to in paragraph 1, and shall notify it, without delay, of any subsequent amendment to them.\n\n3. Non-compliance with the prohibition of the AI practices referred to in Article 5 shall be subject to administrative fines of up to EUR 35000000 or, if the offender is an undertaking, up to 7 % of its total worldwide annual turnover for the preceding financial year, whichever is higher.\n\n4. Non-compliance with any of the following provisions related to operators or notified bodies, other than those laid down in Articles 5, shall be subject to administrative fines of up to EUR 15000000 or, if the offender is an undertaking, up to 3 % of its total worldwide annual turnover for the preceding financial year, whichever is higher:\n(a) obligations of providers pursuant to Article 16;\n(b) obligations of authorised representatives pursuant to Article 22;\n(c) obligations of importers pursuant to Article 23;\n(d) obligations of distributors pursuant to Article 24;\n(e) obligations of deployers pursuant to Article 26;\n(f) requirements and obligations of notified bodies pursuant to Article 31, Article 33(1), (3) and (4) or Article 34;\n(g) transparency obligations for providers and deployers pursuant to Article 50.\n\n5. The supply of incorrect, incomplete or misleading information to notified bodies or national competent authorities in reply to a request shall be subject to administrative fines of up to EUR 7500000 or, if the offender is an undertaking, up to 1 % of its total worldwide annual turnover for the preceding financial year, whichever is higher.\n\n6. In the case of SMEs, including start-ups, each fine referred to in this Article shall be up to the percentages or amount referred to in paragraphs 3, 4 and 5, whichever thereof is lower.\n\n7. When deciding whether to impose an administrative fine and when deciding on the amount of the administrative fine in each individual case, all relevant circumstances of the specific situation shall be taken into account and, as appropriate, regard shall be given to the following:\n(a) the nature, gravity and duration of the infringement and of its consequences, taking into account the purpose of the AI system, as well as, where appropriate, the number of affected persons and the level of damage suffered by them;\n(b) whether administrative fines have already been applied by other market surveillance authorities to the same operator for the same infringement;\n(c) whether administrative fines have already been applied by other authorities to the same operator for infringements of other Union or national law, when such infringements result from the same activity or omission constituting a relevant infringement of this Regulation;\n(d) the size, the annual turnover and market share of the operator committing the infringement;\n(e) any other aggravating or mitigating factor applicable to the circumstances of the case, such as financial benefits gained, or losses avoided, directly or indirectly, from the infringement;\n(f) the degree of cooperation with the national competent authorities, in order to remedy the infringement and mitigate the possible adverse effects of the infringement;\n(g) the degree of responsibility of the operator taking into account the technical and organisational measures implemented by it;\n(h) the manner in which the infringement became known to the national competent authorities, in particular whether, and if so to what extent, the operator notified the infringement;\n(i) the intentional or negligent character of the infringement;\n(j) any action taken by the operator to mitigate the harm suffered by the affected persons.\n\n8. Each Member State shall lay down rules on to what extent administrative fines may be imposed on public authorities and bodies established in that Member State.\n\n9. Depending on the legal system of the Member States, the rules on administrative fines may be applied in such a manner that the fines are imposed by competent national courts or by other bodies, as applicable in those Member States. The application of such rules in those Member States shall have an equivalent effect.\n\n10. The exercise of powers under this Article shall be subject to appropriate procedural safeguards in accordance with Union and national law, including effective judicial remedies and due process.\n\n11. Member States shall, on an annual basis, report to the Commission about the administrative fines they have issued during that year, in accordance with this Article, and about any related litigation or judicial proceedings.", article: 99, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99"};
MERGE (n:Provision {id: "art_99__para_1"})
  SET n += {eid: "art_99__para_1", citation: "Art. 99(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_1", chunk_type: "paragraph", level: "para", text: "In accordance with the terms and conditions laid down in this Regulation, Member States shall lay down the rules on penalties and other enforcement measures, which may also include warnings and non-monetary measures, applicable to infringements of this Regulation by operators, and shall take all measures necessary to ensure that they are properly and effectively implemented, thereby taking into account the guidelines issued by the Commission pursuant to Article 96. The penalties provided for shall be effective, proportionate and dissuasive. They shall take into account the interests of SMEs, including start-ups, and their economic viability.", article: 99, paragraph: 1, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(1)"};
MERGE (n:Provision {id: "art_99__para_2"})
  SET n += {eid: "art_99__para_2", citation: "Art. 99(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_2", chunk_type: "paragraph", level: "para", text: "The Member States shall, without delay and at the latest by the date of entry into application, notify the Commission of the rules on penalties and of other enforcement measures referred to in paragraph 1, and shall notify it, without delay, of any subsequent amendment to them.", article: 99, paragraph: 2, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(2)"};
MERGE (n:Provision {id: "art_99__para_3"})
  SET n += {eid: "art_99__para_3", citation: "Art. 99(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_3", chunk_type: "paragraph", level: "para", text: "Non-compliance with the prohibition of the AI practices referred to in Article 5 shall be subject to administrative fines of up to EUR 35000000 or, if the offender is an undertaking, up to 7 % of its total worldwide annual turnover for the preceding financial year, whichever is higher.", article: 99, paragraph: 3, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(3)"};
MERGE (n:Provision {id: "art_99__para_4"})
  SET n += {eid: "art_99__para_4", citation: "Art. 99(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4", chunk_type: "paragraph", level: "para", text: "Non-compliance with any of the following provisions related to operators or notified bodies, other than those laid down in Articles 5, shall be subject to administrative fines of up to EUR 15000000 or, if the offender is an undertaking, up to 3 % of its total worldwide annual turnover for the preceding financial year, whichever is higher:\n(a) obligations of providers pursuant to Article 16;\n(b) obligations of authorised representatives pursuant to Article 22;\n(c) obligations of importers pursuant to Article 23;\n(d) obligations of distributors pursuant to Article 24;\n(e) obligations of deployers pursuant to Article 26;\n(f) requirements and obligations of notified bodies pursuant to Article 31, Article 33(1), (3) and (4) or Article 34;\n(g) transparency obligations for providers and deployers pursuant to Article 50.", article: 99, paragraph: 4, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)"};
MERGE (n:Provision {id: "art_99__para_4__point_a"})
  SET n += {eid: "art_99__para_4__point_a", citation: "Art. 99(4)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4__point_a", chunk_type: "point", level: "point", text: "obligations of providers pursuant to Article 16", article: 99, paragraph: 4, point: "a", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)(a)"};
MERGE (n:Provision {id: "art_99__para_4__point_b"})
  SET n += {eid: "art_99__para_4__point_b", citation: "Art. 99(4)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4__point_b", chunk_type: "point", level: "point", text: "obligations of authorised representatives pursuant to Article 22", article: 99, paragraph: 4, point: "b", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)(b)"};
MERGE (n:Provision {id: "art_99__para_4__point_c"})
  SET n += {eid: "art_99__para_4__point_c", citation: "Art. 99(4)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4__point_c", chunk_type: "point", level: "point", text: "obligations of importers pursuant to Article 23", article: 99, paragraph: 4, point: "c", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)(c)"};
MERGE (n:Provision {id: "art_99__para_4__point_d"})
  SET n += {eid: "art_99__para_4__point_d", citation: "Art. 99(4)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4__point_d", chunk_type: "point", level: "point", text: "obligations of distributors pursuant to Article 24", article: 99, paragraph: 4, point: "d", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)(d)"};
MERGE (n:Provision {id: "art_99__para_4__point_e"})
  SET n += {eid: "art_99__para_4__point_e", citation: "Art. 99(4)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4__point_e", chunk_type: "point", level: "point", text: "obligations of deployers pursuant to Article 26", article: 99, paragraph: 4, point: "e", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)(e)"};
MERGE (n:Provision {id: "art_99__para_4__point_f"})
  SET n += {eid: "art_99__para_4__point_f", citation: "Art. 99(4)(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4__point_f", chunk_type: "point", level: "point", text: "requirements and obligations of notified bodies pursuant to Article 31, Article 33(1), (3) and (4) or Article 34", article: 99, paragraph: 4, point: "f", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)(f)"};
MERGE (n:Provision {id: "art_99__para_4__point_g"})
  SET n += {eid: "art_99__para_4__point_g", citation: "Art. 99(4)(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_4__point_g", chunk_type: "point", level: "point", text: "transparency obligations for providers and deployers pursuant to Article 50", article: 99, paragraph: 4, point: "g", chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(4)(g)"};
MERGE (n:Provision {id: "art_99__para_5"})
  SET n += {eid: "art_99__para_5", citation: "Art. 99(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_99__para_5", chunk_type: "paragraph", level: "para", text: "The supply of incorrect, incomplete or misleading information to notified bodies or national competent authorities in reply to a request shall be subject to administrative fines of up to EUR 7500000 or, if the offender is an undertaking, up to 1 % of its total worldwide annual turnover for the preceding financial year, whichever is higher.", article: 99, paragraph: 5, chapter: 12, celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 99(5)"};
