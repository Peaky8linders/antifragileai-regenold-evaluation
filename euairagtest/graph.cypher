  SET n += {eid: "art_17__para_1__point_f", citation: "Art. 17(1)(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_17__para_1__point_f", chunk_type: "point", level: "point", text: "systems and procedures for data management, including data acquisition, data collection, data analysis, data labelling, data storage, data filtration, data mining, data aggregation, data retention and any other operation regarding the data that is performed before and for the purpose of the placing on the market or the putting into service of high-risk AI systems", article: 17, paragraph: 1, point: "f", chapter: 3, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 17(1)(f)"};
MERGE (n:Provision {id: "art_17__para_1__point_g"})
  SET n += {eid: "art_17__para_1__point_g", citation: "Art. 17(1)(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_17__para_1__point_g", chunk_type: "point", level: "point", text: "the risk management system referred to in Article 9", article: 17, paragraph: 1, point: "g", chapter: 3, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 17(1)(g)"};
