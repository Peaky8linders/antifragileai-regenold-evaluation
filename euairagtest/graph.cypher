  SET n += {eid: "art_59__para_1__point_c", citation: "Art. 59(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_c", chunk_type: "point", level: "point", text: "there are effective monitoring mechanisms to identify if any high risks to the rights and freedoms of the data subjects, as referred to in Article 35 of Regulation (EU) 2016/679 and in Article 39 of Regulation (EU) 2018/1725, may arise during the sandbox experimentation, as well as response mechanisms to promptly mitigate those risks and, where necessary, stop the processing", article: 59, paragraph: 1, point: "c", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(c)"};
MERGE (n:Provision {id: "art_59__para_1__point_d"})
  SET n += {eid: "art_59__para_1__point_d", citation: "Art. 59(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_d", chunk_type: "point", level: "point", text: "any personal data to be processed in the context of the sandbox are in a functionally separate, isolated and protected data processing environment under the control of the prospective provider and only authorised persons have access to those data", article: 59, paragraph: 1, point: "d", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(d)"};
MERGE (n:Provision {id: "art_59__para_1__point_e"})
  SET n += {eid: "art_59__para_1__point_e", citation: "Art. 59(1)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_e", chunk_type: "point", level: "point", text: "providers can further share the originally collected data only in accordance with Union data protection law; any personal data created in the sandbox cannot be shared outside the sandbox", article: 59, paragraph: 1, point: "e", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(e)"};
MERGE (n:Provision {id: "art_59__para_1__point_f"})
  SET n += {eid: "art_59__para_1__point_f", citation: "Art. 59(1)(f)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_f", chunk_type: "point", level: "point", text: "any processing of personal data in the context of the sandbox neither leads to measures or decisions affecting the data subjects nor does it affect the application of their rights laid down in Union law on the protection of personal data", article: 59, paragraph: 1, point: "f", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(f)"};
MERGE (n:Provision {id: "art_59__para_1__point_g"})
  SET n += {eid: "art_59__para_1__point_g", citation: "Art. 59(1)(g)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_g", chunk_type: "point", level: "point", text: "any personal data processed in the context of the sandbox are protected by means of appropriate technical and organisational measures and deleted once the participation in the sandbox has terminated or the personal data has reached the end of its retention period", article: 59, paragraph: 1, point: "g", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(g)"};
MERGE (n:Provision {id: "art_59__para_1__point_h"})
  SET n += {eid: "art_59__para_1__point_h", citation: "Art. 59(1)(h)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_h", chunk_type: "point", level: "point", text: "the logs of the processing of personal data in the context of the sandbox are kept for the duration of the participation in the sandbox, unless provided otherwise by Union or national law", article: 59, paragraph: 1, point: "h", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(h)"};
MERGE (n:Provision {id: "art_59__para_1__point_i"})
  SET n += {eid: "art_59__para_1__point_i", citation: "Art. 59(1)(i)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_i", chunk_type: "point", level: "point", text: "a complete and detailed description of the process and rationale behind the training, testing and validation of the AI system is kept together with the testing results as part of the technical documentation referred to in Annex IV", article: 59, paragraph: 1, point: "i", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(i)"};
MERGE (n:Provision {id: "art_59__para_1__point_j"})
  SET n += {eid: "art_59__para_1__point_j", citation: "Art. 59(1)(j)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_j", chunk_type: "point", level: "point", text: "a short summary of the AI project developed in the sandbox, its objectives and expected results is published on the website of the competent authorities; this obligation shall not cover sensitive operational data in relation to the activities of law enforcement, border control, immigration or asylum authorities", article: 59, paragraph: 1, point: "j", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(j)"};
MERGE (n:Provision {id: "art_59__para_1__point_j__sub_i"})
  SET n += {eid: "art_59__para_1__point_j__sub_i", citation: "Art. 59(1)(j)(i)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_j__sub_i", chunk_type: "subpoint", level: "sub", text: "public safety and public health, including disease detection, diagnosis prevention, control and treatment and improvement of health care systems", article: 59, paragraph: 1, point: "j", subpoint: "i", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(j)(i)"};
MERGE (n:Provision {id: "art_59__para_1__point_j__sub_ii"})
  SET n += {eid: "art_59__para_1__point_j__sub_ii", citation: "Art. 59(1)(j)(ii)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_j__sub_ii", chunk_type: "subpoint", level: "sub", text: "a high level of protection and improvement of the quality of the environment, protection of biodiversity, protection against pollution, green transition measures, climate change mitigation and adaptation measures", article: 59, paragraph: 1, point: "j", subpoint: "ii", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(j)(ii)"};
MERGE (n:Provision {id: "art_59__para_1__point_j__sub_iii"})
  SET n += {eid: "art_59__para_1__point_j__sub_iii", citation: "Art. 59(1)(j)(iii)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_j__sub_iii", chunk_type: "subpoint", level: "sub", text: "energy sustainability", article: 59, paragraph: 1, point: "j", subpoint: "iii", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(j)(iii)"};
MERGE (n:Provision {id: "art_59__para_1__point_j__sub_iv"})
  SET n += {eid: "art_59__para_1__point_j__sub_iv", citation: "Art. 59(1)(j)(iv)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_j__sub_iv", chunk_type: "subpoint", level: "sub", text: "safety and resilience of transport systems and mobility, critical infrastructure and networks", article: 59, paragraph: 1, point: "j", subpoint: "iv", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(j)(iv)"};
MERGE (n:Provision {id: "art_59__para_1__point_j__sub_v"})
  SET n += {eid: "art_59__para_1__point_j__sub_v", citation: "Art. 59(1)(j)(v)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_1__point_j__sub_v", chunk_type: "subpoint", level: "sub", text: "efficiency and quality of public administration and public services", article: 59, paragraph: 1, point: "j", subpoint: "v", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(1)(j)(v)"};
MERGE (n:Provision {id: "art_59__para_2"})
  SET n += {eid: "art_59__para_2", citation: "Art. 59(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_2", chunk_type: "paragraph", level: "para", text: "For the purposes of the prevention, investigation, detection or prosecution of criminal offences or the execution of criminal penalties, including safeguarding against and preventing threats to public security, under the control and responsibility of law enforcement authorities, the processing of personal data in AI regulatory sandboxes shall be based on a specific Union or national law and subject to the same cumulative conditions as referred to in paragraph 1.", article: 59, paragraph: 2, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(2)"};
MERGE (n:Provision {id: "art_59__para_3"})
  SET n += {eid: "art_59__para_3", citation: "Art. 59(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_59__para_3", chunk_type: "paragraph", level: "para", text: "Paragraph 1 is without prejudice to Union or national law which excludes processing of personal data for other purposes than those explicitly mentioned in that law, as well as to Union or national law laying down the basis for the processing of personal data which is necessary for the purpose of developing, testing or training of innovative AI systems or any other legal basis, in compliance with Union law on the protection of personal data.", article: 59, paragraph: 3, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 59(3)"};
MERGE (n:Provision {id: "art_60"})
  SET n += {eid: "art_60", citation: "Art. 60", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60", chunk_type: "article_full", level: "art", text: "Article 60 — Testing of high-risk AI systems in real world conditions outside AI regulatory sandboxes\n\n1. Testing of high-risk AI systems in real world conditions outside AI regulatory sandboxes may be conducted by providers or prospective providers of high-risk AI systems listed in Annex III, in accordance with this Article and the real-world testing plan referred to in this Article, without prejudice to the prohibitions under Article 5. The Commission shall, by means of implementing acts, specify the detailed elements of the real-world testing plan. Those implementing acts shall be adopted in accordance with the examination procedure referred to in Article 98(2). This paragraph shall be without prejudice to Union or national law on the testing in real world conditions of high-risk AI systems related to products covered by Union harmonisation legislation listed in Annex I.\n\n2. Providers or prospective providers may conduct testing of high-risk AI systems referred to in Annex III in real world conditions at any time before the placing on the market or the putting into service of the AI system on their own or in partnership with one or more deployers or prospective deployers.\n\n3. The testing of high-risk AI systems in real world conditions under this Article shall be without prejudice to any ethical review that is required by Union or national law.\n\n4. Providers or prospective providers may conduct the testing in real world conditions only where all of the following conditions are met:\n(a) the provider or prospective provider has drawn up a real-world testing plan and submitted it to the market surveillance authority in the Member State where the testing in real world conditions is to be conducted;\n(b) the market surveillance authority in the Member State where the testing in real world conditions is to be conducted has approved the testing in real world conditions and the real-world testing plan; where the market surveillance authority has not provided an answer within 30 days, the testing in real world conditions and the real-world testing plan shall be understood to have been approved; where national law does not provide for a tacit approval, the testing in real world conditions shall remain subject to an authorisation;\n(c) the provider or prospective provider, with the exception of providers or prospective providers of high-risk AI systems referred to in points 1, 6 and 7 of Annex III in the areas of law enforcement, migration, asylum and border control management, and high-risk AI systems referred to in point 2 of Annex III has registered the testing in real world conditions in accordance with Article 71(4) with a Union-wide unique single identification number and with the information specified in Annex IX; the provider or prospective provider of high-risk AI systems referred to in points 1, 6 and 7 of Annex III in the areas of law enforcement, migration, asylum and border control management, has registered the testing in real-world conditions in the secure non-public section of the EU database according to Article 49(4), point (d), with a Union-wide unique single identification number and with the information specified therein; the provider or prospective provider of high-risk AI systems referred to in point 2 of Annex III has registered the testing in real-world conditions in accordance with Article 49(5);\n(d) the provider or prospective provider conducting the testing in real world conditions is established in the Union or has appointed a legal representative who is established in the Union;\n(e) data collected and processed for the purpose of the testing in real world conditions shall be transferred to third countries only provided that appropriate and applicable safeguards under Union law are implemented;\n(f) the testing in real world conditions does not last longer than necessary to achieve its objectives and in any case not longer than six months, which may be extended for an additional period of six months, subject to prior notification by the provider or prospective provider to the market surveillance authority, accompanied by an explanation of the need for such an extension;\n(g) the subjects of the testing in real world conditions who are persons belonging to vulnerable groups due to their age or disability, are appropriately protected;\n(h) where a provider or prospective provider organises the testing in real world conditions in cooperation with one or more deployers or prospective deployers, the latter have been informed of all aspects of the testing that are relevant to their decision to participate, and given the relevant instructions for use of the AI system referred to in Article 13; the provider or prospective provider and the deployer or prospective deployer shall conclude an agreement specifying their roles and responsibilities with a view to ensuring compliance with the provisions for testing in real world conditions under this Regulation and under other applicable Union and national law;\n(i) the subjects of the testing in real world conditions have given informed consent in accordance with Article 61, or in the case of law enforcement, where the seeking of informed consent would prevent the AI system from being tested, the testing itself and the outcome of the testing in the real world conditions shall not have any negative effect on the subjects, and their personal data shall be deleted after the test is performed;\n(j) the testing in real world conditions is effectively overseen by the provider or prospective provider, as well as by deployers or prospective deployers through persons who are suitably qualified in the relevant field and have the necessary capacity, training and authority to perform their tasks;\n(k) the predictions, recommendations or decisions of the AI system can be effectively reversed and disregarded.\n\n5. Any subjects of the testing in real world conditions, or their legally designated representative, as appropriate, may, without any resulting detriment and without having to provide any justification, withdraw from the testing at any time by revoking their informed consent and may request the immediate and permanent deletion of their personal data. The withdrawal of the informed consent shall not affect the activities already carried out.\n\n6. In accordance with Article 75, Member States shall confer on their market surveillance authorities the powers of requiring providers and prospective providers to provide information, of carrying out unannounced remote or on-site inspections, and of performing checks on the conduct of the testing in real world conditions and the related high-risk AI systems. Market surveillance authorities shall use those powers to ensure the safe development of testing in real world conditions.\n\n7. Any serious incident identified in the course of the testing in real world conditions shall be reported to the national market surveillance authority in accordance with Article 73. The provider or prospective provider shall adopt immediate mitigation measures or, failing that, shall suspend the testing in real world conditions until such mitigation takes place, or otherwise terminate it. The provider or prospective provider shall establish a procedure for the prompt recall of the AI system upon such termination of the testing in real world conditions.\n\n8. Providers or prospective providers shall notify the national market surveillance authority in the Member State where the testing in real world conditions is to be conducted of the suspension or termination of the testing in real world conditions and of the final outcomes.\n\n9. The provider or prospective provider shall be liable under applicable Union and national liability law for any damage caused in the course of their testing in real world conditions.", article: 60, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60"};
MERGE (n:Provision {id: "art_60__para_1"})
  SET n += {eid: "art_60__para_1", citation: "Art. 60(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_1", chunk_type: "paragraph", level: "para", text: "Testing of high-risk AI systems in real world conditions outside AI regulatory sandboxes may be conducted by providers or prospective providers of high-risk AI systems listed in Annex III, in accordance with this Article and the real-world testing plan referred to in this Article, without prejudice to the prohibitions under Article 5. The Commission shall, by means of implementing acts, specify the detailed elements of the real-world testing plan. Those implementing acts shall be adopted in accordance with the examination procedure referred to in Article 98(2). This paragraph shall be without prejudice to Union or national law on the testing in real world conditions of high-risk AI systems related to products covered by Union harmonisation legislation listed in Annex I.", article: 60, paragraph: 1, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(1)"};
MERGE (n:Provision {id: "art_60__para_2"})
  SET n += {eid: "art_60__para_2", citation: "Art. 60(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_2", chunk_type: "paragraph", level: "para", text: "Providers or prospective providers may conduct testing of high-risk AI systems referred to in Annex III in real world conditions at any time before the placing on the market or the putting into service of the AI system on their own or in partnership with one or more deployers or prospective deployers.", article: 60, paragraph: 2, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(2)"};
MERGE (n:Provision {id: "art_60__para_3"})
  SET n += {eid: "art_60__para_3", citation: "Art. 60(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_3", chunk_type: "paragraph", level: "para", text: "The testing of high-risk AI systems in real world conditions under this Article shall be without prejudice to any ethical review that is required by Union or national law.", article: 60, paragraph: 3, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(3)"};
MERGE (n:Provision {id: "art_60__para_4"})
  SET n += {eid: "art_60__para_4", citation: "Art. 60(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_4", chunk_type: "paragraph", level: "para", text: "Providers or prospective providers may conduct the testing in real world conditions only where all of the following conditions are met:\n(a) the provider or prospective provider has drawn up a real-world testing plan and submitted it to the market surveillance authority in the Member State where the testing in real world conditions is to be conducted;\n(b) the market surveillance authority in the Member State where the testing in real world conditions is to be conducted has approved the testing in real world conditions and the real-world testing plan; where the market surveillance authority has not provided an answer within 30 days, the testing in real world conditions and the real-world testing plan shall be understood to have been approved; where national law does not provide for a tacit approval, the testing in real world conditions shall remain subject to an authorisation;\n(c) the provider or prospective provider, with the exception of providers or prospective providers of high-risk AI systems referred to in points 1, 6 and 7 of Annex III in the areas of law enforcement, migration, asylum and border control management, and high-risk AI systems referred to in point 2 of Annex III has registered the testing in real world conditions in accordance with Article 71(4) with a Union-wide unique single identification number and with the information specified in Annex IX; the provider or prospective provider of high-risk AI systems referred to in points 1, 6 and 7 of Annex III in the areas of law enforcement, migration, asylum and border control management, has registered the testing in real-world conditions in the secure non-public section of the EU database according to Article 49(4), point (d), with a Union-wide unique single identification number and with the information specified therein; the provider or prospective provider of high-risk AI systems referred to in point 2 of Annex III has registered the testing in real-world conditions in accordance with Article 49(5);\n(d) the provider or prospective provider conducting the testing in real world conditions is established in the Union or has appointed a legal representative who is established in the Union;\n(e) data collected and processed for the purpose of the testing in real world conditions shall be transferred to third countries only provided that appropriate and applicable safeguards under Union law are implemented;\n(f) the testing in real world conditions does not last longer than necessary to achieve its objectives and in any case not longer than six months, which may be extended for an additional period of six months, subject to prior notification by the provider or prospective provider to the market surveillance authority, accompanied by an explanation of the need for such an extension;\n(g) the subjects of the testing in real world conditions who are persons belonging to vulnerable groups due to their age or disability, are appropriately protected;\n(h) where a provider or prospective provider organises the testing in real world conditions in cooperation with one or more deployers or prospective deployers, the latter have been informed of all aspects of the testing that are relevant to their decision to participate, and given the relevant instructions for use of the AI system referred to in Article 13; the provider or prospective provider and the deployer or prospective deployer shall conclude an agreement specifying their roles and responsibilities with a view to ensuring compliance with the provisions for testing in real world conditions under this Regulation and under other applicable Union and national law;\n(i) the subjects of the testing in real world conditions have given informed consent in accordance with Article 61, or in the case of law enforcement, where the seeking of informed consent would prevent the AI system from being tested, the testing itself and the outcome of the testing in the real world conditions shall not have any negative effect on the subjects, and their personal data shall be deleted after the test is performed;\n(j) the testing in real world conditions is effectively overseen by the provider or prospective provider, as well as by deployers or prospective deployers through persons who are suitably qualified in the relevant field and have the necessary capacity, training and authority to perform their tasks;\n(k) the predictions, recommendations or decisions of the AI system can be effectively reversed and disregarded.", article: 60, paragraph: 4, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(4)"};
MERGE (n:Provision {id: "art_60__para_4__point_a"})
  SET n += {eid: "art_60__para_4__point_a", citation: "Art. 60(4)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_4__point_a", chunk_type: "point", level: "point", text: "the provider or prospective provider has drawn up a real-world testing plan and submitted it to the market surveillance authority in the Member State where the testing in real world conditions is to be conducted", article: 60, paragraph: 4, point: "a", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(4)(a)"};
