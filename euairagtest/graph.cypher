  SET n += {eid: "art_60__para_4__point_c", citation: "Art. 60(4)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_4__point_c", chunk_type: "point", level: "point", text: "the provider or prospective provider, with the exception of providers or prospective providers of high-risk AI systems referred to in points 1, 6 and 7 of Annex III in the areas of law enforcement, migration, asylum and border control management, and high-risk AI systems referred to in point 2 of Annex III has registered the testing in real world conditions in accordance with Article 71(4) with a Union-wide unique single identification number and with the information specified in Annex IX; the provider or prospective provider of high-risk AI systems referred to in points 1, 6 and 7 of Annex III in the areas of law enforcement, migration, asylum and border control management, has registered the testing in real-world conditions in the secure non-public section of the EU database according to Article 49(4), point", article: 60, paragraph: 4, point: "c", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(4)(c)"};
MERGE (n:Provision {id: "art_60__para_4__point_d"})
  SET n += {eid: "art_60__para_4__point_d", citation: "Art. 60(4)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_4__point_d", chunk_type: "point", level: "point", text: ", with a Union-wide unique single identification number and with the information specified therein; the provider or prospective provider of high-risk AI systems referred to in point 2 of Annex III has registered the testing in real-world conditions in accordance with Article 49(5);\n(d) the provider or prospective provider conducting the testing in real world conditions is established in the Union or has appointed a legal representative who is established in the Union", article: 60, paragraph: 4, point: "d", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(4)(d)"};
