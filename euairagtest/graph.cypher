  SET n += {eid: "art_60__para_4__point_i", citation: "Art. 60(4)(i)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_4__point_i", chunk_type: "point", level: "point", text: "the subjects of the testing in real world conditions have given informed consent in accordance with Article 61, or in the case of law enforcement, where the seeking of informed consent would prevent the AI system from being tested, the testing itself and the outcome of the testing in the real world conditions shall not have any negative effect on the subjects, and their personal data shall be deleted after the test is performed", article: 60, paragraph: 4, point: "i", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(4)(i)"};
MERGE (n:Provision {id: "art_60__para_4__point_j"})
  SET n += {eid: "art_60__para_4__point_j", citation: "Art. 60(4)(j)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_4__point_j", chunk_type: "point", level: "point", text: "the testing in real world conditions is effectively overseen by the provider or prospective provider, as well as by deployers or prospective deployers through persons who are suitably qualified in the relevant field and have the necessary capacity, training and authority to perform their tasks", article: 60, paragraph: 4, point: "j", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(4)(j)"};
MERGE (n:Provision {id: "art_60__para_4__point_k"})
  SET n += {eid: "art_60__para_4__point_k", citation: "Art. 60(4)(k)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_4__point_k", chunk_type: "point", level: "point", text: "the predictions, recommendations or decisions of the AI system can be effectively reversed and disregarded", article: 60, paragraph: 4, point: "k", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(4)(k)"};
MERGE (n:Provision {id: "art_60__para_5"})
  SET n += {eid: "art_60__para_5", citation: "Art. 60(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_5", chunk_type: "paragraph", level: "para", text: "Any subjects of the testing in real world conditions, or their legally designated representative, as appropriate, may, without any resulting detriment and without having to provide any justification, withdraw from the testing at any time by revoking their informed consent and may request the immediate and permanent deletion of their personal data. The withdrawal of the informed consent shall not affect the activities already carried out.", article: 60, paragraph: 5, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(5)"};
MERGE (n:Provision {id: "art_60__para_6"})
  SET n += {eid: "art_60__para_6", citation: "Art. 60(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_6", chunk_type: "paragraph", level: "para", text: "In accordance with Article 75, Member States shall confer on their market surveillance authorities the powers of requiring providers and prospective providers to provide information, of carrying out unannounced remote or on-site inspections, and of performing checks on the conduct of the testing in real world conditions and the related high-risk AI systems. Market surveillance authorities shall use those powers to ensure the safe development of testing in real world conditions.", article: 60, paragraph: 6, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(6)"};
MERGE (n:Provision {id: "art_60__para_7"})
  SET n += {eid: "art_60__para_7", citation: "Art. 60(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_7", chunk_type: "paragraph", level: "para", text: "Any serious incident identified in the course of the testing in real world conditions shall be reported to the national market surveillance authority in accordance with Article 73. The provider or prospective provider shall adopt immediate mitigation measures or, failing that, shall suspend the testing in real world conditions until such mitigation takes place, or otherwise terminate it. The provider or prospective provider shall establish a procedure for the prompt recall of the AI system upon such termination of the testing in real world conditions.", article: 60, paragraph: 7, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(7)"};
MERGE (n:Provision {id: "art_60__para_8"})
  SET n += {eid: "art_60__para_8", citation: "Art. 60(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_8", chunk_type: "paragraph", level: "para", text: "Providers or prospective providers shall notify the national market surveillance authority in the Member State where the testing in real world conditions is to be conducted of the suspension or termination of the testing in real world conditions and of the final outcomes.", article: 60, paragraph: 8, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(8)"};
MERGE (n:Provision {id: "art_60__para_9"})
  SET n += {eid: "art_60__para_9", citation: "Art. 60(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_60__para_9", chunk_type: "paragraph", level: "para", text: "The provider or prospective provider shall be liable under applicable Union and national liability law for any damage caused in the course of their testing in real world conditions.", article: 60, paragraph: 9, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 60(9)"};
MERGE (n:Provision {id: "art_61"})
  SET n += {eid: "art_61", citation: "Art. 61", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61", chunk_type: "article_full", level: "art", text: "Article 61 — Informed consent to participate in testing in real world conditions outside AI regulatory sandboxes\n\n1. For the purpose of testing in real world conditions under Article 60, freely-given informed consent shall be obtained from the subjects of testing prior to their participation in such testing and after their having been duly informed with concise, clear, relevant, and understandable information regarding:\n(a) the nature and objectives of the testing in real world conditions and the possible inconvenience that may be linked to their participation;\n(b) the conditions under which the testing in real world conditions is to be conducted, including the expected duration of the subject or subjects’ participation;\n(c) their rights, and the guarantees regarding their participation, in particular their right to refuse to participate in, and the right to withdraw from, testing in real world conditions at any time without any resulting detriment and without having to provide any justification;\n(d) the arrangements for requesting the reversal or the disregarding of the predictions, recommendations or decisions of the AI system;\n(e) the Union-wide unique single identification number of the testing in real world conditions in accordance with Article 60(4) point (c), and the contact details of the provider or its legal representative from whom further information can be obtained.\n\n2. The informed consent shall be dated and documented and a copy shall be given to the subjects of testing or their legal representative.", article: 61, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61"};
MERGE (n:Provision {id: "art_61__para_1"})
  SET n += {eid: "art_61__para_1", citation: "Art. 61(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61__para_1", chunk_type: "paragraph", level: "para", text: "For the purpose of testing in real world conditions under Article 60, freely-given informed consent shall be obtained from the subjects of testing prior to their participation in such testing and after their having been duly informed with concise, clear, relevant, and understandable information regarding:\n(a) the nature and objectives of the testing in real world conditions and the possible inconvenience that may be linked to their participation;\n(b) the conditions under which the testing in real world conditions is to be conducted, including the expected duration of the subject or subjects’ participation;\n(c) their rights, and the guarantees regarding their participation, in particular their right to refuse to participate in, and the right to withdraw from, testing in real world conditions at any time without any resulting detriment and without having to provide any justification;\n(d) the arrangements for requesting the reversal or the disregarding of the predictions, recommendations or decisions of the AI system;\n(e) the Union-wide unique single identification number of the testing in real world conditions in accordance with Article 60(4) point (c), and the contact details of the provider or its legal representative from whom further information can be obtained.", article: 61, paragraph: 1, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61(1)"};
MERGE (n:Provision {id: "art_61__para_1__point_a"})
  SET n += {eid: "art_61__para_1__point_a", citation: "Art. 61(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61__para_1__point_a", chunk_type: "point", level: "point", text: "the nature and objectives of the testing in real world conditions and the possible inconvenience that may be linked to their participation", article: 61, paragraph: 1, point: "a", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61(1)(a)"};
MERGE (n:Provision {id: "art_61__para_1__point_b"})
  SET n += {eid: "art_61__para_1__point_b", citation: "Art. 61(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61__para_1__point_b", chunk_type: "point", level: "point", text: "the conditions under which the testing in real world conditions is to be conducted, including the expected duration of the subject or subjects’ participation", article: 61, paragraph: 1, point: "b", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61(1)(b)"};
MERGE (n:Provision {id: "art_61__para_1__point_c"})
  SET n += {eid: "art_61__para_1__point_c", citation: "Art. 61(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61__para_1__point_c", chunk_type: "point", level: "point", text: "their rights, and the guarantees regarding their participation, in particular their right to refuse to participate in, and the right to withdraw from, testing in real world conditions at any time without any resulting detriment and without having to provide any justification", article: 61, paragraph: 1, point: "c", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61(1)(c)"};
MERGE (n:Provision {id: "art_61__para_1__point_d"})
  SET n += {eid: "art_61__para_1__point_d", citation: "Art. 61(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61__para_1__point_d", chunk_type: "point", level: "point", text: "the arrangements for requesting the reversal or the disregarding of the predictions, recommendations or decisions of the AI system", article: 61, paragraph: 1, point: "d", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61(1)(d)"};
MERGE (n:Provision {id: "art_61__para_1__point_e"})
  SET n += {eid: "art_61__para_1__point_e", citation: "Art. 61(1)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61__para_1__point_e", chunk_type: "point", level: "point", text: "the Union-wide unique single identification number of the testing in real world conditions in accordance with Article 60(4) point (c), and the contact details of the provider or its legal representative from whom further information can be obtained", article: 61, paragraph: 1, point: "e", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61(1)(e)"};
MERGE (n:Provision {id: "art_61__para_2"})
  SET n += {eid: "art_61__para_2", citation: "Art. 61(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_61__para_2", chunk_type: "paragraph", level: "para", text: "The informed consent shall be dated and documented and a copy shall be given to the subjects of testing or their legal representative.", article: 61, paragraph: 2, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 61(2)"};
MERGE (n:Provision {id: "art_62"})
  SET n += {eid: "art_62", citation: "Art. 62", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62", chunk_type: "article_full", level: "art", text: "Article 62 — Measures for providers and deployers, in particular SMEs, including start-ups\n\n1. Member States shall undertake the following actions:\n(a) provide SMEs, including start-ups, having a registered office or a branch in the Union, with priority access to the AI regulatory sandboxes, to the extent that they fulfil the eligibility conditions and selection criteria; the priority access shall not preclude other SMEs, including start-ups, other than those referred to in this paragraph from access to the AI regulatory sandbox, provided that they also fulfil the eligibility conditions and selection criteria;\n(b) organise specific awareness raising and training activities on the application of this Regulation tailored to the needs of SMEs including start-ups, deployers and, as appropriate, local public authorities;\n(c) utilise existing dedicated channels and where appropriate, establish new ones for communication with SMEs including start-ups, deployers, other innovators and, as appropriate, local public authorities to provide advice and respond to queries about the implementation of this Regulation, including as regards participation in AI regulatory sandboxes;\n(d) facilitate the participation of SMEs and other relevant stakeholders in the standardisation development process.\n\n2. The specific interests and needs of the SME providers, including start-ups, shall be taken into account when setting the fees for conformity assessment under Article 43, reducing those fees proportionately to their size, market size and other relevant indicators.\n\n3. The AI Office shall undertake the following actions:\n(a) provide standardised templates for areas covered by this Regulation, as specified by the Board in its request;\n(b) develop and maintain a single information platform providing easy to use information in relation to this Regulation for all operators across the Union;\n(c) organise appropriate communication campaigns to raise awareness about the obligations arising from this Regulation;\n(d) evaluate and promote the convergence of best practices in public procurement procedures in relation to AI systems.", article: 62, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62"};
MERGE (n:Provision {id: "art_62__para_1"})
  SET n += {eid: "art_62__para_1", citation: "Art. 62(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_1", chunk_type: "paragraph", level: "para", text: "Member States shall undertake the following actions:\n(a) provide SMEs, including start-ups, having a registered office or a branch in the Union, with priority access to the AI regulatory sandboxes, to the extent that they fulfil the eligibility conditions and selection criteria; the priority access shall not preclude other SMEs, including start-ups, other than those referred to in this paragraph from access to the AI regulatory sandbox, provided that they also fulfil the eligibility conditions and selection criteria;\n(b) organise specific awareness raising and training activities on the application of this Regulation tailored to the needs of SMEs including start-ups, deployers and, as appropriate, local public authorities;\n(c) utilise existing dedicated channels and where appropriate, establish new ones for communication with SMEs including start-ups, deployers, other innovators and, as appropriate, local public authorities to provide advice and respond to queries about the implementation of this Regulation, including as regards participation in AI regulatory sandboxes;\n(d) facilitate the participation of SMEs and other relevant stakeholders in the standardisation development process.", article: 62, paragraph: 1, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(1)"};
MERGE (n:Provision {id: "art_62__para_1__point_a"})
  SET n += {eid: "art_62__para_1__point_a", citation: "Art. 62(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_1__point_a", chunk_type: "point", level: "point", text: "provide SMEs, including start-ups, having a registered office or a branch in the Union, with priority access to the AI regulatory sandboxes, to the extent that they fulfil the eligibility conditions and selection criteria; the priority access shall not preclude other SMEs, including start-ups, other than those referred to in this paragraph from access to the AI regulatory sandbox, provided that they also fulfil the eligibility conditions and selection criteria", article: 62, paragraph: 1, point: "a", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(1)(a)"};
MERGE (n:Provision {id: "art_62__para_1__point_b"})
  SET n += {eid: "art_62__para_1__point_b", citation: "Art. 62(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_1__point_b", chunk_type: "point", level: "point", text: "organise specific awareness raising and training activities on the application of this Regulation tailored to the needs of SMEs including start-ups, deployers and, as appropriate, local public authorities", article: 62, paragraph: 1, point: "b", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(1)(b)"};
MERGE (n:Provision {id: "art_62__para_1__point_c"})
  SET n += {eid: "art_62__para_1__point_c", citation: "Art. 62(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_1__point_c", chunk_type: "point", level: "point", text: "utilise existing dedicated channels and where appropriate, establish new ones for communication with SMEs including start-ups, deployers, other innovators and, as appropriate, local public authorities to provide advice and respond to queries about the implementation of this Regulation, including as regards participation in AI regulatory sandboxes", article: 62, paragraph: 1, point: "c", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(1)(c)"};
MERGE (n:Provision {id: "art_62__para_1__point_d"})
  SET n += {eid: "art_62__para_1__point_d", citation: "Art. 62(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_1__point_d", chunk_type: "point", level: "point", text: "facilitate the participation of SMEs and other relevant stakeholders in the standardisation development process", article: 62, paragraph: 1, point: "d", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(1)(d)"};
MERGE (n:Provision {id: "art_62__para_2"})
  SET n += {eid: "art_62__para_2", citation: "Art. 62(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_2", chunk_type: "paragraph", level: "para", text: "The specific interests and needs of the SME providers, including start-ups, shall be taken into account when setting the fees for conformity assessment under Article 43, reducing those fees proportionately to their size, market size and other relevant indicators.", article: 62, paragraph: 2, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(2)"};
MERGE (n:Provision {id: "art_62__para_3"})
  SET n += {eid: "art_62__para_3", citation: "Art. 62(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_3", chunk_type: "paragraph", level: "para", text: "The AI Office shall undertake the following actions:\n(a) provide standardised templates for areas covered by this Regulation, as specified by the Board in its request;\n(b) develop and maintain a single information platform providing easy to use information in relation to this Regulation for all operators across the Union;\n(c) organise appropriate communication campaigns to raise awareness about the obligations arising from this Regulation;\n(d) evaluate and promote the convergence of best practices in public procurement procedures in relation to AI systems.", article: 62, paragraph: 3, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(3)"};
MERGE (n:Provision {id: "art_62__para_3__point_a"})
  SET n += {eid: "art_62__para_3__point_a", citation: "Art. 62(3)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_3__point_a", chunk_type: "point", level: "point", text: "provide standardised templates for areas covered by this Regulation, as specified by the Board in its request", article: 62, paragraph: 3, point: "a", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(3)(a)"};
MERGE (n:Provision {id: "art_62__para_3__point_b"})
  SET n += {eid: "art_62__para_3__point_b", citation: "Art. 62(3)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_3__point_b", chunk_type: "point", level: "point", text: "develop and maintain a single information platform providing easy to use information in relation to this Regulation for all operators across the Union", article: 62, paragraph: 3, point: "b", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(3)(b)"};
MERGE (n:Provision {id: "art_62__para_3__point_c"})
  SET n += {eid: "art_62__para_3__point_c", citation: "Art. 62(3)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_3__point_c", chunk_type: "point", level: "point", text: "organise appropriate communication campaigns to raise awareness about the obligations arising from this Regulation", article: 62, paragraph: 3, point: "c", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(3)(c)"};
MERGE (n:Provision {id: "art_62__para_3__point_d"})
  SET n += {eid: "art_62__para_3__point_d", citation: "Art. 62(3)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_62__para_3__point_d", chunk_type: "point", level: "point", text: "evaluate and promote the convergence of best practices in public procurement procedures in relation to AI systems", article: 62, paragraph: 3, point: "d", chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 62(3)(d)"};
MERGE (n:Provision {id: "art_63"})
  SET n += {eid: "art_63", citation: "Art. 63", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_63", chunk_type: "article_full", level: "art", text: "Article 63 — Derogations for specific operators\n\n1. Microenterprises within the meaning of Recommendation 2003/361/EC may comply with certain elements of the quality management system required by Article 17 of this Regulation in a simplified manner, provided that they do not have partner enterprises or linked enterprises within the meaning of that Recommendation. For that purpose, the Commission shall develop guidelines on the elements of the quality management system which may be complied with in a simplified manner considering the needs of microenterprises, without affecting the level of protection or the need for compliance with the requirements in respect of high-risk AI systems.\n\n2. Paragraph 1 of this Article shall not be interpreted as exempting those operators from fulfilling any other requirements or obligations laid down in this Regulation, including those established in Articles 9, 10, 11, 12, 13, 14, 15, 72 and 73.", article: 63, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 63"};
MERGE (n:Provision {id: "art_63__para_1"})
  SET n += {eid: "art_63__para_1", citation: "Art. 63(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_63__para_1", chunk_type: "paragraph", level: "para", text: "Microenterprises within the meaning of Recommendation 2003/361/EC may comply with certain elements of the quality management system required by Article 17 of this Regulation in a simplified manner, provided that they do not have partner enterprises or linked enterprises within the meaning of that Recommendation. For that purpose, the Commission shall develop guidelines on the elements of the quality management system which may be complied with in a simplified manner considering the needs of microenterprises, without affecting the level of protection or the need for compliance with the requirements in respect of high-risk AI systems.", article: 63, paragraph: 1, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 63(1)"};
MERGE (n:Provision {id: "art_63__para_2"})
  SET n += {eid: "art_63__para_2", citation: "Art. 63(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_63__para_2", chunk_type: "paragraph", level: "para", text: "Paragraph 1 of this Article shall not be interpreted as exempting those operators from fulfilling any other requirements or obligations laid down in this Regulation, including those established in Articles 9, 10, 11, 12, 13, 14, 15, 72 and 73.", article: 63, paragraph: 2, chapter: 6, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 63(2)"};
MERGE (n:Provision {id: "art_64"})
  SET n += {eid: "art_64", citation: "Art. 64", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_64", chunk_type: "article_full", level: "art", text: "Article 64 — AI Office\n\n1. The Commission shall develop Union expertise and capabilities in the field of AI through the AI Office.\n\n2. Member States shall facilitate the tasks entrusted to the AI Office, as reflected in this Regulation.", article: 64, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 64"};
MERGE (n:Provision {id: "art_64__para_1"})
  SET n += {eid: "art_64__para_1", citation: "Art. 64(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_64__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall develop Union expertise and capabilities in the field of AI through the AI Office.", article: 64, paragraph: 1, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 64(1)"};
MERGE (n:Provision {id: "art_64__para_2"})
  SET n += {eid: "art_64__para_2", citation: "Art. 64(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_64__para_2", chunk_type: "paragraph", level: "para", text: "Member States shall facilitate the tasks entrusted to the AI Office, as reflected in this Regulation.", article: 64, paragraph: 2, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 64(2)"};
MERGE (n:Provision {id: "art_65"})
  SET n += {eid: "art_65", citation: "Art. 65", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65", chunk_type: "article_full", level: "art", text: "Article 65 — Establishment and structure of the European Artificial Intelligence Board\n\n1. A European Artificial Intelligence Board (the “Board”) is hereby established.\n\n2. The Board shall be composed of one representative per Member State. The European Data Protection Supervisor shall participate as observer. The AI Office shall also attend the Board’s meetings, without taking part in the votes. Other national and Union authorities, bodies or experts may be invited to the meetings by the Board on a case by case basis, where the issues discussed are of relevance for them.\n\n3. Each representative shall be designated by their Member State for a period of three years, renewable once.\n\n4. Member States shall ensure that their representatives on the Board:\n(a) have the relevant competences and powers in their Member State so as to contribute actively to the achievement of the Board’s tasks referred to in Article 66;\n(b) are designated as a single contact point vis-à-vis the Board and, where appropriate, taking into account Member States’ needs, as a single contact point for stakeholders;\n(c) are empowered to facilitate consistency and coordination between national competent authorities in their Member State as regards the implementation of this Regulation, including through the collection of relevant data and information for the purpose of fulfilling their tasks on the Board.\n\n5. The designated representatives of the Member States shall adopt the Board’s rules of procedure by a two-thirds majority. The rules of procedure shall, in particular, lay down procedures for the selection process, the duration of the mandate of, and specifications of the tasks of, the Chair, detailed arrangements for voting, and the organisation of the Board’s activities and those of its sub-groups.\n\n6. The Board shall establish two standing sub-groups to provide a platform for cooperation and exchange among market surveillance authorities and notifying authorities about issues related to market surveillance and notified bodies respectively. The standing sub-group for market surveillance should act as the administrative cooperation group (ADCO) for this Regulation within the meaning of Article 30 of Regulation (EU) 2019/1020. The Board may establish other standing or temporary sub-groups as appropriate for the purpose of examining specific issues. Where appropriate, representatives of the advisory forum referred to in Article 67 may be invited to such sub-groups or to specific meetings of those subgroups as observers.\n\n7. The Board shall be organised and operated so as to safeguard the objectivity and impartiality of its activities.\n\n8. The Board shall be chaired by one of the representatives of the Member States. The AI Office shall provide the secretariat for the Board, convene the meetings upon request of the Chair, and prepare the agenda in accordance with the tasks of the Board pursuant to this Regulation and its rules of procedure.", article: 65, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65"};
MERGE (n:Provision {id: "art_65__para_1"})
  SET n += {eid: "art_65__para_1", citation: "Art. 65(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_1", chunk_type: "paragraph", level: "para", text: "A European Artificial Intelligence Board (the “Board”) is hereby established.", article: 65, paragraph: 1, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(1)"};
MERGE (n:Provision {id: "art_65__para_2"})
  SET n += {eid: "art_65__para_2", citation: "Art. 65(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_2", chunk_type: "paragraph", level: "para", text: "The Board shall be composed of one representative per Member State. The European Data Protection Supervisor shall participate as observer. The AI Office shall also attend the Board’s meetings, without taking part in the votes. Other national and Union authorities, bodies or experts may be invited to the meetings by the Board on a case by case basis, where the issues discussed are of relevance for them.", article: 65, paragraph: 2, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(2)"};
MERGE (n:Provision {id: "art_65__para_3"})
  SET n += {eid: "art_65__para_3", citation: "Art. 65(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_3", chunk_type: "paragraph", level: "para", text: "Each representative shall be designated by their Member State for a period of three years, renewable once.", article: 65, paragraph: 3, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(3)"};
MERGE (n:Provision {id: "art_65__para_4"})
  SET n += {eid: "art_65__para_4", citation: "Art. 65(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_4", chunk_type: "paragraph", level: "para", text: "Member States shall ensure that their representatives on the Board:\n(a) have the relevant competences and powers in their Member State so as to contribute actively to the achievement of the Board’s tasks referred to in Article 66;\n(b) are designated as a single contact point vis-à-vis the Board and, where appropriate, taking into account Member States’ needs, as a single contact point for stakeholders;\n(c) are empowered to facilitate consistency and coordination between national competent authorities in their Member State as regards the implementation of this Regulation, including through the collection of relevant data and information for the purpose of fulfilling their tasks on the Board.", article: 65, paragraph: 4, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(4)"};
MERGE (n:Provision {id: "art_65__para_4__point_a"})
  SET n += {eid: "art_65__para_4__point_a", citation: "Art. 65(4)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_4__point_a", chunk_type: "point", level: "point", text: "have the relevant competences and powers in their Member State so as to contribute actively to the achievement of the Board’s tasks referred to in Article 66", article: 65, paragraph: 4, point: "a", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(4)(a)"};
MERGE (n:Provision {id: "art_65__para_4__point_b"})
  SET n += {eid: "art_65__para_4__point_b", citation: "Art. 65(4)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_4__point_b", chunk_type: "point", level: "point", text: "are designated as a single contact point vis-à-vis the Board and, where appropriate, taking into account Member States’ needs, as a single contact point for stakeholders", article: 65, paragraph: 4, point: "b", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(4)(b)"};
MERGE (n:Provision {id: "art_65__para_4__point_c"})
  SET n += {eid: "art_65__para_4__point_c", citation: "Art. 65(4)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_4__point_c", chunk_type: "point", level: "point", text: "are empowered to facilitate consistency and coordination between national competent authorities in their Member State as regards the implementation of this Regulation, including through the collection of relevant data and information for the purpose of fulfilling their tasks on the Board", article: 65, paragraph: 4, point: "c", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(4)(c)"};
MERGE (n:Provision {id: "art_65__para_5"})
  SET n += {eid: "art_65__para_5", citation: "Art. 65(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_5", chunk_type: "paragraph", level: "para", text: "The designated representatives of the Member States shall adopt the Board’s rules of procedure by a two-thirds majority. The rules of procedure shall, in particular, lay down procedures for the selection process, the duration of the mandate of, and specifications of the tasks of, the Chair, detailed arrangements for voting, and the organisation of the Board’s activities and those of its sub-groups.", article: 65, paragraph: 5, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(5)"};
MERGE (n:Provision {id: "art_65__para_6"})
  SET n += {eid: "art_65__para_6", citation: "Art. 65(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_6", chunk_type: "paragraph", level: "para", text: "The Board shall establish two standing sub-groups to provide a platform for cooperation and exchange among market surveillance authorities and notifying authorities about issues related to market surveillance and notified bodies respectively. The standing sub-group for market surveillance should act as the administrative cooperation group (ADCO) for this Regulation within the meaning of Article 30 of Regulation (EU) 2019/1020. The Board may establish other standing or temporary sub-groups as appropriate for the purpose of examining specific issues. Where appropriate, representatives of the advisory forum referred to in Article 67 may be invited to such sub-groups or to specific meetings of those subgroups as observers.", article: 65, paragraph: 6, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(6)"};
MERGE (n:Provision {id: "art_65__para_7"})
  SET n += {eid: "art_65__para_7", citation: "Art. 65(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_7", chunk_type: "paragraph", level: "para", text: "The Board shall be organised and operated so as to safeguard the objectivity and impartiality of its activities.", article: 65, paragraph: 7, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(7)"};
MERGE (n:Provision {id: "art_65__para_8"})
  SET n += {eid: "art_65__para_8", citation: "Art. 65(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_65__para_8", chunk_type: "paragraph", level: "para", text: "The Board shall be chaired by one of the representatives of the Member States. The AI Office shall provide the secretariat for the Board, convene the meetings upon request of the Chair, and prepare the agenda in accordance with the tasks of the Board pursuant to this Regulation and its rules of procedure.", article: 65, paragraph: 8, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 65(8)"};
MERGE (n:Provision {id: "art_66"})
  SET n += {eid: "art_66", citation: "Art. 66", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_66", chunk_type: "article_full", level: "art", text: "Article 66 — Tasks of the Board\n\nThe Board shall advise and assist the Commission and the Member States in order to facilitate the consistent and effective application of this Regulation. To that end, the Board may in particular:\n(a) contribute to the coordination among national competent authorities responsible for the application of this Regulation and, in cooperation with and subject to the agreement of the market surveillance authorities concerned, support joint activities of market surveillance authorities referred to in Article 74(11);\n(b) collect and share technical and regulatory expertise and best practices among Member States;\n(c) provide advice on the implementation of this Regulation, in particular as regards the enforcement of rules on general-purpose AI models;\n(d) contribute to the harmonisation of administrative practices in the Member States, including in relation to the derogation from the conformity assessment procedures referred to in Article 46, the functioning of AI regulatory sandboxes, and testing in real world conditions referred to in Articles 57, 59 and 60;\n(e) at the request of the Commission or on its own initiative, issue recommendations and written opinions on any relevant matters related to the implementation of this Regulation and to its consistent and effective application, including:\n(f) support the Commission in promoting AI literacy, public awareness and understanding of the benefits, risks, safeguards and rights and obligations in relation to the use of AI systems;\n(g) facilitate the development of common criteria and a shared understanding among market operators and competent authorities of the relevant concepts provided for in this Regulation, including by contributing to the development of benchmarks;\n(h) cooperate, as appropriate, with other Union institutions, bodies, offices and agencies, as well as relevant Union expert groups and networks, in particular in the fields of product safety, cybersecurity, competition, digital and media services, financial services, consumer protection, data and fundamental rights protection;\n(i) contribute to effective cooperation with the competent authorities of third countries and with international organisations;\n(j) assist national competent authorities and the Commission in developing the organisational and technical expertise required for the implementation of this Regulation, including by contributing to the assessment of training needs for staff of Member States involved in implementing this Regulation;\n(k) assist the AI Office in supporting national competent authorities in the establishment and development of AI regulatory sandboxes, and facilitate cooperation and information-sharing among AI regulatory sandboxes;\n(l) contribute to, and provide relevant advice on, the development of guidance documents;\n(m) advise the Commission in relation to international matters on AI;\n(n) provide opinions to the Commission on the qualified alerts regarding general-purpose AI models;\n(o) receive opinions by the Member States on qualified alerts regarding general-purpose AI models, and on national experiences and practices on the monitoring and enforcement of AI systems, in particular systems integrating the general-purpose AI models.\n(i) on the development and application of codes of conduct and codes of practice pursuant to this Regulation, as well as of the Commission’s guidelines;\n(ii) the evaluation and review of this Regulation pursuant to Article 112, including as regards the serious incident reports referred to in Article 73, and the functioning of the EU database referred to in Article 71, the preparation of the delegated or implementing acts, and as regards possible alignments of this Regulation with the Union harmonisation legislation listed in Annex I;\n(iii) on technical specifications or existing standards regarding the requirements set out in Chapter III, Section 2;\n(iv) on the use of harmonised standards or common specifications referred to in Articles 40 and 41;\n(v) trends, such as European global competitiveness in AI, the uptake of AI in the Union, and the development of digital skills;\n(vi) trends on the evolving typology of AI value chains, in particular on the resulting implications in terms of accountability;\n(vii) on the potential need for amendment to Annex III in accordance with Article 7, and on the potential need for possible revision of Article 5 pursuant to Article 112, taking into account relevant available evidence and the latest developments in technology;", article: 66, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 66"};
MERGE (n:Provision {id: "art_67"})
  SET n += {eid: "art_67", citation: "Art. 67", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67", chunk_type: "article_full", level: "art", text: "Article 67 — Advisory forum\n\n1. An advisory forum shall be established to provide technical expertise and advise the Board and the Commission, and to contribute to their tasks under this Regulation.\n\n2. The membership of the advisory forum shall represent a balanced selection of stakeholders, including industry, start-ups, SMEs, civil society and academia. The membership of the advisory forum shall be balanced with regard to commercial and non-commercial interests and, within the category of commercial interests, with regard to SMEs and other undertakings.\n\n3. The Commission shall appoint the members of the advisory forum, in accordance with the criteria set out in paragraph 2, from amongst stakeholders with recognised expertise in the field of AI.\n\n4. The term of office of the members of the advisory forum shall be two years, which may be extended by up to no more than four years.\n\n5. The Fundamental Rights Agency, ENISA, the European Committee for Standardization (CEN), the European Committee for Electrotechnical Standardization (CENELEC), and the European Telecommunications Standards Institute (ETSI) shall be permanent members of the advisory forum.\n\n6. The advisory forum shall draw up its rules of procedure. It shall elect two co-chairs from among its members, in accordance with criteria set out in paragraph 2. The term of office of the co-chairs shall be two years, renewable once.\n\n7. The advisory forum shall hold meetings at least twice a year. The advisory forum may invite experts and other stakeholders to its meetings.\n\n8. The advisory forum may prepare opinions, recommendations and written contributions at the request of the Board or the Commission.\n\n9. The advisory forum may establish standing or temporary sub-groups as appropriate for the purpose of examining specific questions related to the objectives of this Regulation.\n\n10. The advisory forum shall prepare an annual report on its activities. That report shall be made publicly available.", article: 67, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67"};
MERGE (n:Provision {id: "art_67__para_1"})
  SET n += {eid: "art_67__para_1", citation: "Art. 67(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_1", chunk_type: "paragraph", level: "para", text: "An advisory forum shall be established to provide technical expertise and advise the Board and the Commission, and to contribute to their tasks under this Regulation.", article: 67, paragraph: 1, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(1)"};
MERGE (n:Provision {id: "art_67__para_2"})
  SET n += {eid: "art_67__para_2", citation: "Art. 67(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_2", chunk_type: "paragraph", level: "para", text: "The membership of the advisory forum shall represent a balanced selection of stakeholders, including industry, start-ups, SMEs, civil society and academia. The membership of the advisory forum shall be balanced with regard to commercial and non-commercial interests and, within the category of commercial interests, with regard to SMEs and other undertakings.", article: 67, paragraph: 2, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(2)"};
MERGE (n:Provision {id: "art_67__para_3"})
  SET n += {eid: "art_67__para_3", citation: "Art. 67(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_3", chunk_type: "paragraph", level: "para", text: "The Commission shall appoint the members of the advisory forum, in accordance with the criteria set out in paragraph 2, from amongst stakeholders with recognised expertise in the field of AI.", article: 67, paragraph: 3, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(3)"};
MERGE (n:Provision {id: "art_67__para_4"})
  SET n += {eid: "art_67__para_4", citation: "Art. 67(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_4", chunk_type: "paragraph", level: "para", text: "The term of office of the members of the advisory forum shall be two years, which may be extended by up to no more than four years.", article: 67, paragraph: 4, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(4)"};
MERGE (n:Provision {id: "art_67__para_5"})
  SET n += {eid: "art_67__para_5", citation: "Art. 67(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_5", chunk_type: "paragraph", level: "para", text: "The Fundamental Rights Agency, ENISA, the European Committee for Standardization (CEN), the European Committee for Electrotechnical Standardization (CENELEC), and the European Telecommunications Standards Institute (ETSI) shall be permanent members of the advisory forum.", article: 67, paragraph: 5, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(5)"};
MERGE (n:Provision {id: "art_67__para_6"})
  SET n += {eid: "art_67__para_6", citation: "Art. 67(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_6", chunk_type: "paragraph", level: "para", text: "The advisory forum shall draw up its rules of procedure. It shall elect two co-chairs from among its members, in accordance with criteria set out in paragraph 2. The term of office of the co-chairs shall be two years, renewable once.", article: 67, paragraph: 6, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(6)"};
MERGE (n:Provision {id: "art_67__para_7"})
  SET n += {eid: "art_67__para_7", citation: "Art. 67(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_7", chunk_type: "paragraph", level: "para", text: "The advisory forum shall hold meetings at least twice a year. The advisory forum may invite experts and other stakeholders to its meetings.", article: 67, paragraph: 7, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(7)"};
MERGE (n:Provision {id: "art_67__para_8"})
  SET n += {eid: "art_67__para_8", citation: "Art. 67(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_8", chunk_type: "paragraph", level: "para", text: "The advisory forum may prepare opinions, recommendations and written contributions at the request of the Board or the Commission.", article: 67, paragraph: 8, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(8)"};
MERGE (n:Provision {id: "art_67__para_9"})
  SET n += {eid: "art_67__para_9", citation: "Art. 67(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_9", chunk_type: "paragraph", level: "para", text: "The advisory forum may establish standing or temporary sub-groups as appropriate for the purpose of examining specific questions related to the objectives of this Regulation.", article: 67, paragraph: 9, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(9)"};
MERGE (n:Provision {id: "art_67__para_10"})
  SET n += {eid: "art_67__para_10", citation: "Art. 67(10)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_67__para_10", chunk_type: "paragraph", level: "para", text: "The advisory forum shall prepare an annual report on its activities. That report shall be made publicly available.", article: 67, paragraph: 10, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 67(10)"};
MERGE (n:Provision {id: "art_68"})
  SET n += {eid: "art_68", citation: "Art. 68", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68", chunk_type: "article_full", level: "art", text: "Article 68 — Scientific panel of independent experts\n\n1. The Commission shall, by means of an implementing act, make provisions on the establishment of a scientific panel of independent experts (the “scientific panel”) intended to support the enforcement activities under this Regulation. That implementing act shall be adopted in accordance with the examination procedure referred to in Article 98(2).\n\n2. The scientific panel shall consist of experts selected by the Commission on the basis of up-to-date scientific or technical expertise in the field of AI necessary for the tasks set out in paragraph 3, and shall be able to demonstrate meeting all of the following conditions:\n(a) having particular expertise and competence and scientific or technical expertise in the field of AI;\n(b) independence from any provider of AI systems or general-purpose AI models;\n(c) an ability to carry out activities diligently, accurately and objectively.\nThe Commission, in consultation with the Board, shall determine the number of experts on the panel in accordance with the required needs and shall ensure fair gender and geographical representation.\n\n3. The scientific panel shall advise and support the AI Office, in particular with regard to the following tasks:\n(a) supporting the implementation and enforcement of this Regulation as regards general-purpose AI models and systems, in particular by:\n(b) supporting the work of market surveillance authorities, at their request;\n(c) supporting cross-border market surveillance activities as referred to in Article 74(11), without prejudice to the powers of market surveillance authorities;\n(d) supporting the AI Office in carrying out its duties in the context of the Union safeguard procedure pursuant to Article 81.\n(i) alerting the AI Office of possible systemic risks at Union level of general-purpose AI models, in accordance with Article 90;\n(ii) contributing to the development of tools and methodologies for evaluating capabilities of general-purpose AI models and systems, including through benchmarks;\n(iii) providing advice on the classification of general-purpose AI models with systemic risk;\n(iv) providing advice on the classification of various general-purpose AI models and systems;\n(v) contributing to the development of tools and templates;\n\n4. The experts on the scientific panel shall perform their tasks with impartiality and objectivity, and shall ensure the confidentiality of information and data obtained in carrying out their tasks and activities. They shall neither seek nor take instructions from anyone when exercising their tasks under paragraph 3. Each expert shall draw up a declaration of interests, which shall be made publicly available. The AI Office shall establish systems and procedures to actively manage and prevent potential conflicts of interest.\n\n5. The implementing act referred to in paragraph 1 shall include provisions on the conditions, procedures and detailed arrangements for the scientific panel and its members to issue alerts, and to request the assistance of the AI Office for the performance of the tasks of the scientific panel.", article: 68, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68"};
MERGE (n:Provision {id: "art_68__para_1"})
  SET n += {eid: "art_68__para_1", citation: "Art. 68(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall, by means of an implementing act, make provisions on the establishment of a scientific panel of independent experts (the “scientific panel”) intended to support the enforcement activities under this Regulation. That implementing act shall be adopted in accordance with the examination procedure referred to in Article 98(2).", article: 68, paragraph: 1, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(1)"};
MERGE (n:Provision {id: "art_68__para_2"})
  SET n += {eid: "art_68__para_2", citation: "Art. 68(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_2", chunk_type: "paragraph", level: "para", text: "The scientific panel shall consist of experts selected by the Commission on the basis of up-to-date scientific or technical expertise in the field of AI necessary for the tasks set out in paragraph 3, and shall be able to demonstrate meeting all of the following conditions:\n(a) having particular expertise and competence and scientific or technical expertise in the field of AI;\n(b) independence from any provider of AI systems or general-purpose AI models;\n(c) an ability to carry out activities diligently, accurately and objectively.\nThe Commission, in consultation with the Board, shall determine the number of experts on the panel in accordance with the required needs and shall ensure fair gender and geographical representation.", article: 68, paragraph: 2, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(2)"};
MERGE (n:Provision {id: "art_68__para_2__point_a"})
  SET n += {eid: "art_68__para_2__point_a", citation: "Art. 68(2)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_2__point_a", chunk_type: "point", level: "point", text: "having particular expertise and competence and scientific or technical expertise in the field of AI", article: 68, paragraph: 2, point: "a", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(2)(a)"};
MERGE (n:Provision {id: "art_68__para_2__point_b"})
  SET n += {eid: "art_68__para_2__point_b", citation: "Art. 68(2)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_2__point_b", chunk_type: "point", level: "point", text: "independence from any provider of AI systems or general-purpose AI models", article: 68, paragraph: 2, point: "b", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(2)(b)"};
MERGE (n:Provision {id: "art_68__para_2__point_c"})
  SET n += {eid: "art_68__para_2__point_c", citation: "Art. 68(2)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_2__point_c", chunk_type: "point", level: "point", text: "an ability to carry out activities diligently, accurately and objectively.\nThe Commission, in consultation with the Board, shall determine the number of experts on the panel in accordance with the required needs and shall ensure fair gender and geographical representation", article: 68, paragraph: 2, point: "c", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(2)(c)"};
MERGE (n:Provision {id: "art_68__para_3"})
  SET n += {eid: "art_68__para_3", citation: "Art. 68(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3", chunk_type: "paragraph", level: "para", text: "The scientific panel shall advise and support the AI Office, in particular with regard to the following tasks:\n(a) supporting the implementation and enforcement of this Regulation as regards general-purpose AI models and systems, in particular by:\n(b) supporting the work of market surveillance authorities, at their request;\n(c) supporting cross-border market surveillance activities as referred to in Article 74(11), without prejudice to the powers of market surveillance authorities;\n(d) supporting the AI Office in carrying out its duties in the context of the Union safeguard procedure pursuant to Article 81.\n(i) alerting the AI Office of possible systemic risks at Union level of general-purpose AI models, in accordance with Article 90;\n(ii) contributing to the development of tools and methodologies for evaluating capabilities of general-purpose AI models and systems, including through benchmarks;\n(iii) providing advice on the classification of general-purpose AI models with systemic risk;\n(iv) providing advice on the classification of various general-purpose AI models and systems;\n(v) contributing to the development of tools and templates;", article: 68, paragraph: 3, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)"};
MERGE (n:Provision {id: "art_68__para_3__point_a"})
  SET n += {eid: "art_68__para_3__point_a", citation: "Art. 68(3)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_a", chunk_type: "point", level: "point", text: "supporting the implementation and enforcement of this Regulation as regards general-purpose AI models and systems, in particular by:", article: 68, paragraph: 3, point: "a", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(a)"};
MERGE (n:Provision {id: "art_68__para_3__point_b"})
  SET n += {eid: "art_68__para_3__point_b", citation: "Art. 68(3)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_b", chunk_type: "point", level: "point", text: "supporting the work of market surveillance authorities, at their request", article: 68, paragraph: 3, point: "b", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(b)"};
MERGE (n:Provision {id: "art_68__para_3__point_c"})
  SET n += {eid: "art_68__para_3__point_c", citation: "Art. 68(3)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_c", chunk_type: "point", level: "point", text: "supporting cross-border market surveillance activities as referred to in Article 74(11), without prejudice to the powers of market surveillance authorities", article: 68, paragraph: 3, point: "c", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(c)"};
MERGE (n:Provision {id: "art_68__para_3__point_d"})
  SET n += {eid: "art_68__para_3__point_d", citation: "Art. 68(3)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_d", chunk_type: "point", level: "point", text: "supporting the AI Office in carrying out its duties in the context of the Union safeguard procedure pursuant to Article 81", article: 68, paragraph: 3, point: "d", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(d)"};
MERGE (n:Provision {id: "art_68__para_3__point_d__sub_i"})
  SET n += {eid: "art_68__para_3__point_d__sub_i", citation: "Art. 68(3)(d)(i)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_d__sub_i", chunk_type: "subpoint", level: "sub", text: "alerting the AI Office of possible systemic risks at Union level of general-purpose AI models, in accordance with Article 90", article: 68, paragraph: 3, point: "d", subpoint: "i", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(d)(i)"};
MERGE (n:Provision {id: "art_68__para_3__point_d__sub_ii"})
  SET n += {eid: "art_68__para_3__point_d__sub_ii", citation: "Art. 68(3)(d)(ii)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_d__sub_ii", chunk_type: "subpoint", level: "sub", text: "contributing to the development of tools and methodologies for evaluating capabilities of general-purpose AI models and systems, including through benchmarks", article: 68, paragraph: 3, point: "d", subpoint: "ii", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(d)(ii)"};
MERGE (n:Provision {id: "art_68__para_3__point_d__sub_iii"})
  SET n += {eid: "art_68__para_3__point_d__sub_iii", citation: "Art. 68(3)(d)(iii)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_d__sub_iii", chunk_type: "subpoint", level: "sub", text: "providing advice on the classification of general-purpose AI models with systemic risk", article: 68, paragraph: 3, point: "d", subpoint: "iii", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(d)(iii)"};
MERGE (n:Provision {id: "art_68__para_3__point_d__sub_iv"})
  SET n += {eid: "art_68__para_3__point_d__sub_iv", citation: "Art. 68(3)(d)(iv)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_d__sub_iv", chunk_type: "subpoint", level: "sub", text: "providing advice on the classification of various general-purpose AI models and systems", article: 68, paragraph: 3, point: "d", subpoint: "iv", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(d)(iv)"};
MERGE (n:Provision {id: "art_68__para_3__point_d__sub_v"})
  SET n += {eid: "art_68__para_3__point_d__sub_v", citation: "Art. 68(3)(d)(v)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_3__point_d__sub_v", chunk_type: "subpoint", level: "sub", text: "contributing to the development of tools and templates", article: 68, paragraph: 3, point: "d", subpoint: "v", chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(3)(d)(v)"};
MERGE (n:Provision {id: "art_68__para_4"})
  SET n += {eid: "art_68__para_4", citation: "Art. 68(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_4", chunk_type: "paragraph", level: "para", text: "The experts on the scientific panel shall perform their tasks with impartiality and objectivity, and shall ensure the confidentiality of information and data obtained in carrying out their tasks and activities. They shall neither seek nor take instructions from anyone when exercising their tasks under paragraph 3. Each expert shall draw up a declaration of interests, which shall be made publicly available. The AI Office shall establish systems and procedures to actively manage and prevent potential conflicts of interest.", article: 68, paragraph: 4, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(4)"};
MERGE (n:Provision {id: "art_68__para_5"})
  SET n += {eid: "art_68__para_5", citation: "Art. 68(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_68__para_5", chunk_type: "paragraph", level: "para", text: "The implementing act referred to in paragraph 1 shall include provisions on the conditions, procedures and detailed arrangements for the scientific panel and its members to issue alerts, and to request the assistance of the AI Office for the performance of the tasks of the scientific panel.", article: 68, paragraph: 5, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 68(5)"};
MERGE (n:Provision {id: "art_69"})
  SET n += {eid: "art_69", citation: "Art. 69", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_69", chunk_type: "article_full", level: "art", text: "Article 69 — Access to the pool of experts by the Member States\n\n1. Member States may call upon experts of the scientific panel to support their enforcement activities under this Regulation.\n\n2. The Member States may be required to pay fees for the advice and support provided by the experts. The structure and the level of fees as well as the scale and structure of recoverable costs shall be set out in the implementing act referred to in Article 68(1), taking into account the objectives of the adequate implementation of this Regulation, cost-effectiveness and the necessity of ensuring effective access to experts for all Member States.\n\n3. The Commission shall facilitate timely access to the experts by the Member States, as needed, and ensure that the combination of support activities carried out by Union AI testing support pursuant to Article 84 and experts pursuant to this Article is efficiently organised and provides the best possible added value.", article: 69, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 69"};
MERGE (n:Provision {id: "art_69__para_1"})
  SET n += {eid: "art_69__para_1", citation: "Art. 69(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_69__para_1", chunk_type: "paragraph", level: "para", text: "Member States may call upon experts of the scientific panel to support their enforcement activities under this Regulation.", article: 69, paragraph: 1, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 69(1)"};
MERGE (n:Provision {id: "art_69__para_2"})
  SET n += {eid: "art_69__para_2", citation: "Art. 69(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_69__para_2", chunk_type: "paragraph", level: "para", text: "The Member States may be required to pay fees for the advice and support provided by the experts. The structure and the level of fees as well as the scale and structure of recoverable costs shall be set out in the implementing act referred to in Article 68(1), taking into account the objectives of the adequate implementation of this Regulation, cost-effectiveness and the necessity of ensuring effective access to experts for all Member States.", article: 69, paragraph: 2, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 69(2)"};
MERGE (n:Provision {id: "art_69__para_3"})
  SET n += {eid: "art_69__para_3", citation: "Art. 69(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_69__para_3", chunk_type: "paragraph", level: "para", text: "The Commission shall facilitate timely access to the experts by the Member States, as needed, and ensure that the combination of support activities carried out by Union AI testing support pursuant to Article 84 and experts pursuant to this Article is efficiently organised and provides the best possible added value.", article: 69, paragraph: 3, chapter: 7, section: "1", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 69(3)"};
MERGE (n:Provision {id: "art_70"})
  SET n += {eid: "art_70", citation: "Art. 70", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70", chunk_type: "article_full", level: "art", text: "Article 70 — Designation of national competent authorities and single points of contact\n\n1. Each Member State shall establish or designate as national competent authorities at least one notifying authority and at least one market surveillance authority for the purposes of this Regulation. Those national competent authorities shall exercise their powers independently, impartially and without bias so as to safeguard the objectivity of their activities and tasks, and to ensure the application and implementation of this Regulation. The members of those authorities shall refrain from any action incompatible with their duties. Provided that those principles are observed, such activities and tasks may be performed by one or more designated authorities, in accordance with the organisational needs of the Member State.\n\n2. Member States shall communicate to the Commission the identity of the notifying authorities and the market surveillance authorities and the tasks of those authorities, as well as any subsequent changes thereto. Member States shall make publicly available information on how competent authorities and single points of contact can be contacted, through electronic communication means by 2 August 2025. Member States shall designate a market surveillance authority to act as the single point of contact for this Regulation, and shall notify the Commission of the identity of the single point of contact. The Commission shall make a list of the single points of contact publicly available.\n\n3. Member States shall ensure that their national competent authorities are provided with adequate technical, financial and human resources, and with infrastructure to fulfil their tasks effectively under this Regulation. In particular, the national competent authorities shall have a sufficient number of personnel permanently available whose competences and expertise shall include an in-depth understanding of AI technologies, data and data computing, personal data protection, cybersecurity, fundamental rights, health and safety risks and knowledge of existing standards and legal requirements. Member States shall assess and, if necessary, update competence and resource requirements referred to in this paragraph on an annual basis.\n\n4. National competent authorities shall take appropriate measures to ensure an adequate level of cybersecurity.\n\n5. When performing their tasks, the national competent authorities shall act in accordance with the confidentiality obligations set out in Article 78.\n\n6. By 2 August 2025, and once every two years thereafter, Member States shall report to the Commission on the status of the financial and human resources of the national competent authorities, with an assessment of their adequacy. The Commission shall transmit that information to the Board for discussion and possible recommendations.\n\n7. The Commission shall facilitate the exchange of experience between national competent authorities.\n\n8. National competent authorities may provide guidance and advice on the implementation of this Regulation, in particular to SMEs including start-ups, taking into account the guidance and advice of the Board and the Commission, as appropriate. Whenever national competent authorities intend to provide guidance and advice with regard to an AI system in areas covered by other Union law, the national competent authorities under that Union law shall be consulted, as appropriate.\n\n9. Where Union institutions, bodies, offices or agencies fall within the scope of this Regulation, the European Data Protection Supervisor shall act as the competent authority for their supervision.", article: 70, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70"};
MERGE (n:Provision {id: "art_70__para_1"})
  SET n += {eid: "art_70__para_1", citation: "Art. 70(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_1", chunk_type: "paragraph", level: "para", text: "Each Member State shall establish or designate as national competent authorities at least one notifying authority and at least one market surveillance authority for the purposes of this Regulation. Those national competent authorities shall exercise their powers independently, impartially and without bias so as to safeguard the objectivity of their activities and tasks, and to ensure the application and implementation of this Regulation. The members of those authorities shall refrain from any action incompatible with their duties. Provided that those principles are observed, such activities and tasks may be performed by one or more designated authorities, in accordance with the organisational needs of the Member State.", article: 70, paragraph: 1, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(1)"};
MERGE (n:Provision {id: "art_70__para_2"})
  SET n += {eid: "art_70__para_2", citation: "Art. 70(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_2", chunk_type: "paragraph", level: "para", text: "Member States shall communicate to the Commission the identity of the notifying authorities and the market surveillance authorities and the tasks of those authorities, as well as any subsequent changes thereto. Member States shall make publicly available information on how competent authorities and single points of contact can be contacted, through electronic communication means by 2 August 2025. Member States shall designate a market surveillance authority to act as the single point of contact for this Regulation, and shall notify the Commission of the identity of the single point of contact. The Commission shall make a list of the single points of contact publicly available.", article: 70, paragraph: 2, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(2)"};
MERGE (n:Provision {id: "art_70__para_3"})
  SET n += {eid: "art_70__para_3", citation: "Art. 70(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_3", chunk_type: "paragraph", level: "para", text: "Member States shall ensure that their national competent authorities are provided with adequate technical, financial and human resources, and with infrastructure to fulfil their tasks effectively under this Regulation. In particular, the national competent authorities shall have a sufficient number of personnel permanently available whose competences and expertise shall include an in-depth understanding of AI technologies, data and data computing, personal data protection, cybersecurity, fundamental rights, health and safety risks and knowledge of existing standards and legal requirements. Member States shall assess and, if necessary, update competence and resource requirements referred to in this paragraph on an annual basis.", article: 70, paragraph: 3, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(3)"};
MERGE (n:Provision {id: "art_70__para_4"})
  SET n += {eid: "art_70__para_4", citation: "Art. 70(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_4", chunk_type: "paragraph", level: "para", text: "National competent authorities shall take appropriate measures to ensure an adequate level of cybersecurity.", article: 70, paragraph: 4, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(4)"};
MERGE (n:Provision {id: "art_70__para_5"})
  SET n += {eid: "art_70__para_5", citation: "Art. 70(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_5", chunk_type: "paragraph", level: "para", text: "When performing their tasks, the national competent authorities shall act in accordance with the confidentiality obligations set out in Article 78.", article: 70, paragraph: 5, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(5)"};
MERGE (n:Provision {id: "art_70__para_6"})
  SET n += {eid: "art_70__para_6", citation: "Art. 70(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_6", chunk_type: "paragraph", level: "para", text: "By 2 August 2025, and once every two years thereafter, Member States shall report to the Commission on the status of the financial and human resources of the national competent authorities, with an assessment of their adequacy. The Commission shall transmit that information to the Board for discussion and possible recommendations.", article: 70, paragraph: 6, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(6)"};
MERGE (n:Provision {id: "art_70__para_7"})
  SET n += {eid: "art_70__para_7", citation: "Art. 70(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_7", chunk_type: "paragraph", level: "para", text: "The Commission shall facilitate the exchange of experience between national competent authorities.", article: 70, paragraph: 7, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(7)"};
MERGE (n:Provision {id: "art_70__para_8"})
  SET n += {eid: "art_70__para_8", citation: "Art. 70(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_8", chunk_type: "paragraph", level: "para", text: "National competent authorities may provide guidance and advice on the implementation of this Regulation, in particular to SMEs including start-ups, taking into account the guidance and advice of the Board and the Commission, as appropriate. Whenever national competent authorities intend to provide guidance and advice with regard to an AI system in areas covered by other Union law, the national competent authorities under that Union law shall be consulted, as appropriate.", article: 70, paragraph: 8, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(8)"};
MERGE (n:Provision {id: "art_70__para_9"})
  SET n += {eid: "art_70__para_9", citation: "Art. 70(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_70__para_9", chunk_type: "paragraph", level: "para", text: "Where Union institutions, bodies, offices or agencies fall within the scope of this Regulation, the European Data Protection Supervisor shall act as the competent authority for their supervision.", article: 70, paragraph: 9, chapter: 7, section: "2", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 70(9)"};
MERGE (n:Provision {id: "art_71"})
  SET n += {eid: "art_71", citation: "Art. 71", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_71", chunk_type: "article_full", level: "art", text: "Article 71 — EU database for high-risk AI systems listed in Annex III\n\n1. The Commission shall, in collaboration with the Member States, set up and maintain an EU database containing information referred to in paragraphs 2 and 3 of this Article concerning high-risk AI systems referred to in Article 6(2) which are registered in accordance with Articles 49 and 60 and AI systems that are not considered as high-risk pursuant to Article 6(3) and which are registered in accordance with Article 6(4) and Article 49. When setting the functional specifications of such database, the Commission shall consult the relevant experts, and when updating the functional specifications of such database, the Commission shall consult the Board.\n\n2. The data listed in Sections A and B of Annex VIII shall be entered into the EU database by the provider or, where applicable, by the authorised representative.\n\n3. The data listed in Section C of Annex VIII shall be entered into the EU database by the deployer who is, or who acts on behalf of, a public authority, agency or body, in accordance with Article 49(3) and (4).\n\n4. With the exception of the section referred to in Article 49(4) and Article 60(4), point (c), the information contained in the EU database registered in accordance with Article 49 shall be accessible and publicly available in a user-friendly manner. The information should be easily navigable and machine-readable. The information registered in accordance with Article 60 shall be accessible only to market surveillance authorities and the Commission, unless the prospective provider or provider has given consent for also making the information accessible the public.\n\n5. The EU database shall contain personal data only in so far as necessary for collecting and processing information in accordance with this Regulation. That information shall include the names and contact details of natural persons who are responsible for registering the system and have the legal authority to represent the provider or the deployer, as applicable.\n\n6. The Commission shall be the controller of the EU database. It shall make available to providers, prospective providers and deployers adequate technical and administrative support. The EU database shall comply with the applicable accessibility requirements.", article: 71, chapter: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 71"};
MERGE (n:Provision {id: "art_71__para_1"})
  SET n += {eid: "art_71__para_1", citation: "Art. 71(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_71__para_1", chunk_type: "paragraph", level: "para", text: "The Commission shall, in collaboration with the Member States, set up and maintain an EU database containing information referred to in paragraphs 2 and 3 of this Article concerning high-risk AI systems referred to in Article 6(2) which are registered in accordance with Articles 49 and 60 and AI systems that are not considered as high-risk pursuant to Article 6(3) and which are registered in accordance with Article 6(4) and Article 49. When setting the functional specifications of such database, the Commission shall consult the relevant experts, and when updating the functional specifications of such database, the Commission shall consult the Board.", article: 71, paragraph: 1, chapter: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 71(1)"};
MERGE (n:Provision {id: "art_71__para_2"})
  SET n += {eid: "art_71__para_2", citation: "Art. 71(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_71__para_2", chunk_type: "paragraph", level: "para", text: "The data listed in Sections A and B of Annex VIII shall be entered into the EU database by the provider or, where applicable, by the authorised representative.", article: 71, paragraph: 2, chapter: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 71(2)"};
MERGE (n:Provision {id: "art_71__para_3"})
  SET n += {eid: "art_71__para_3", citation: "Art. 71(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_71__para_3", chunk_type: "paragraph", level: "para", text: "The data listed in Section C of Annex VIII shall be entered into the EU database by the deployer who is, or who acts on behalf of, a public authority, agency or body, in accordance with Article 49(3) and (4).", article: 71, paragraph: 3, chapter: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 71(3)"};
MERGE (n:Provision {id: "art_71__para_4"})
  SET n += {eid: "art_71__para_4", citation: "Art. 71(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_71__para_4", chunk_type: "paragraph", level: "para", text: "With the exception of the section referred to in Article 49(4) and Article 60(4), point (c), the information contained in the EU database registered in accordance with Article 49 shall be accessible and publicly available in a user-friendly manner. The information should be easily navigable and machine-readable. The information registered in accordance with Article 60 shall be accessible only to market surveillance authorities and the Commission, unless the prospective provider or provider has given consent for also making the information accessible the public.", article: 71, paragraph: 4, chapter: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 71(4)"};
MERGE (n:Provision {id: "art_71__para_5"})
  SET n += {eid: "art_71__para_5", citation: "Art. 71(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_71__para_5", chunk_type: "paragraph", level: "para", text: "The EU database shall contain personal data only in so far as necessary for collecting and processing information in accordance with this Regulation. That information shall include the names and contact details of natural persons who are responsible for registering the system and have the legal authority to represent the provider or the deployer, as applicable.", article: 71, paragraph: 5, chapter: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 71(5)"};
MERGE (n:Provision {id: "art_71__para_6"})
  SET n += {eid: "art_71__para_6", citation: "Art. 71(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_71__para_6", chunk_type: "paragraph", level: "para", text: "The Commission shall be the controller of the EU database. It shall make available to providers, prospective providers and deployers adequate technical and administrative support. The EU database shall comply with the applicable accessibility requirements.", article: 71, paragraph: 6, chapter: 8, celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 71(6)"};
MERGE (n:Provision {id: "art_72"})
  SET n += {eid: "art_72", citation: "Art. 72", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_72", chunk_type: "article_full", level: "art", text: "Article 72 — Post-market monitoring by providers and post-market monitoring plan for high-risk AI systems\n\n1. Providers shall establish and document a post-market monitoring system in a manner that is proportionate to the nature of the AI technologies and the risks of the high-risk AI system.\n\n2. The post-market monitoring system shall actively and systematically collect, document and analyse relevant data which may be provided by deployers or which may be collected through other sources on the performance of high-risk AI systems throughout their lifetime, and which allow the provider to evaluate the continuous compliance of AI systems with the requirements set out in Chapter III, Section 2. Where relevant, post-market monitoring shall include an analysis of the interaction with other AI systems. This obligation shall not cover sensitive operational data of deployers which are law-enforcement authorities.\n\n3. The post-market monitoring system shall be based on a post-market monitoring plan. The post-market monitoring plan shall be part of the technical documentation referred to in Annex IV. The Commission shall adopt an implementing act laying down detailed provisions establishing a template for the post-market monitoring plan and the list of elements to be included in the plan by 2 February 2026. That implementing act shall be adopted in accordance with the examination procedure referred to in Article 98(2).\n\n4. For high-risk AI systems covered by the Union harmonisation legislation listed in Section A of Annex I, where a post-market monitoring system and plan are already established under that legislation, in order to ensure consistency, avoid duplications and minimise additional burdens, providers shall have a choice of integrating, as appropriate, the necessary elements described in paragraphs 1, 2 and 3 using the template referred in paragraph 3 into systems and plans already existing under that legislation, provided that it achieves an equivalent level of protection. The first subparagraph of this paragraph shall also apply to high-risk AI systems referred to in point 5 of Annex III placed on the market or put into service by financial institutions that are subject to requirements under Union financial services law regarding their internal governance, arrangements or processes.", article: 72, chapter: 9, section: "1", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 72"};
MERGE (n:Provision {id: "art_72__para_1"})
  SET n += {eid: "art_72__para_1", citation: "Art. 72(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_72__para_1", chunk_type: "paragraph", level: "para", text: "Providers shall establish and document a post-market monitoring system in a manner that is proportionate to the nature of the AI technologies and the risks of the high-risk AI system.", article: 72, paragraph: 1, chapter: 9, section: "1", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 72(1)"};
MERGE (n:Provision {id: "art_72__para_2"})
  SET n += {eid: "art_72__para_2", citation: "Art. 72(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_72__para_2", chunk_type: "paragraph", level: "para", text: "The post-market monitoring system shall actively and systematically collect, document and analyse relevant data which may be provided by deployers or which may be collected through other sources on the performance of high-risk AI systems throughout their lifetime, and which allow the provider to evaluate the continuous compliance of AI systems with the requirements set out in Chapter III, Section 2. Where relevant, post-market monitoring shall include an analysis of the interaction with other AI systems. This obligation shall not cover sensitive operational data of deployers which are law-enforcement authorities.", article: 72, paragraph: 2, chapter: 9, section: "1", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 72(2)"};
MERGE (n:Provision {id: "art_72__para_3"})
  SET n += {eid: "art_72__para_3", citation: "Art. 72(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_72__para_3", chunk_type: "paragraph", level: "para", text: "The post-market monitoring system shall be based on a post-market monitoring plan. The post-market monitoring plan shall be part of the technical documentation referred to in Annex IV. The Commission shall adopt an implementing act laying down detailed provisions establishing a template for the post-market monitoring plan and the list of elements to be included in the plan by 2 February 2026. That implementing act shall be adopted in accordance with the examination procedure referred to in Article 98(2).", article: 72, paragraph: 3, chapter: 9, section: "1", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 72(3)"};
MERGE (n:Provision {id: "art_72__para_4"})
  SET n += {eid: "art_72__para_4", citation: "Art. 72(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_72__para_4", chunk_type: "paragraph", level: "para", text: "For high-risk AI systems covered by the Union harmonisation legislation listed in Section A of Annex I, where a post-market monitoring system and plan are already established under that legislation, in order to ensure consistency, avoid duplications and minimise additional burdens, providers shall have a choice of integrating, as appropriate, the necessary elements described in paragraphs 1, 2 and 3 using the template referred in paragraph 3 into systems and plans already existing under that legislation, provided that it achieves an equivalent level of protection. The first subparagraph of this paragraph shall also apply to high-risk AI systems referred to in point 5 of Annex III placed on the market or put into service by financial institutions that are subject to requirements under Union financial services law regarding their internal governance, arrangements or processes.", article: 72, paragraph: 4, chapter: 9, section: "1", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 72(4)"};
MERGE (n:Provision {id: "art_73"})
  SET n += {eid: "art_73", citation: "Art. 73", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73", chunk_type: "article_full", level: "art", text: "Article 73 — Reporting of serious incidents\n\n1. Providers of high-risk AI systems placed on the Union market shall report any serious incident to the market surveillance authorities of the Member States where that incident occurred.\n\n2. The report referred to in paragraph 1 shall be made immediately after the provider has established a causal link between the AI system and the serious incident or the reasonable likelihood of such a link, and, in any event, not later than 15 days after the provider or, where applicable, the deployer, becomes aware of the serious incident. The period for the reporting referred to in the first subparagraph shall take account of the severity of the serious incident.\n\n3. Notwithstanding paragraph 2 of this Article, in the event of a widespread infringement or a serious incident as defined in Article 3, point (49)(b), the report referred to in paragraph 1 of this Article shall be provided immediately, and not later than two days after the provider or, where applicable, the deployer becomes aware of that incident.\n\n4. Notwithstanding paragraph 2, in the event of the death of a person, the report shall be provided immediately after the provider or the deployer has established, or as soon as it suspects, a causal relationship between the high-risk AI system and the serious incident, but not later than 10 days after the date on which the provider or, where applicable, the deployer becomes aware of the serious incident.\n\n5. Where necessary to ensure timely reporting, the provider or, where applicable, the deployer, may submit an initial report that is incomplete, followed by a complete report.\n\n6. Following the reporting of a serious incident pursuant to paragraph 1, the provider shall, without delay, perform the necessary investigations in relation to the serious incident and the AI system concerned. This shall include a risk assessment of the incident, and corrective action. The provider shall cooperate with the competent authorities, and where relevant with the notified body concerned, during the investigations referred to in the first subparagraph, and shall not perform any investigation which involves altering the AI system concerned in a way which may affect any subsequent evaluation of the causes of the incident, prior to informing the competent authorities of such action.\n\n7. Upon receiving a notification related to a serious incident referred to in Article 3, point (49)(c), the relevant market surveillance authority shall inform the national public authorities or bodies referred to in Article 77(1). The Commission shall develop dedicated guidance to facilitate compliance with the obligations set out in paragraph 1 of this Article. That guidance shall be issued by 2 August 2025, and shall be assessed regularly.\n\n8. The market surveillance authority shall take appropriate measures, as provided for in Article 19 of Regulation (EU) 2019/1020, within seven days from the date it received the notification referred to in paragraph 1 of this Article, and shall follow the notification procedures as provided in that Regulation.\n\n9. For high-risk AI systems referred to in Annex III that are placed on the market or put into service by providers that are subject to Union legislative instruments laying down reporting obligations equivalent to those set out in this Regulation, the notification of serious incidents shall be limited to those referred to in Article 3, point (49)(c).\n\n10. For high-risk AI systems which are safety components of devices, or are themselves devices, covered by Regulations (EU) 2017/745 and (EU) 2017/746, the notification of serious incidents shall be limited to those referred to in Article 3, point (49)(c) of this Regulation, and shall be made to the national competent authority chosen for that purpose by the Member States where the incident occurred.\n\n11. National competent authorities shall immediately notify the Commission of any serious incident, whether or not they have taken action on it, in accordance with Article 20 of Regulation (EU) 2019/1020.", article: 73, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73"};
MERGE (n:Provision {id: "art_73__para_1"})
  SET n += {eid: "art_73__para_1", citation: "Art. 73(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_1", chunk_type: "paragraph", level: "para", text: "Providers of high-risk AI systems placed on the Union market shall report any serious incident to the market surveillance authorities of the Member States where that incident occurred.", article: 73, paragraph: 1, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(1)"};
MERGE (n:Provision {id: "art_73__para_2"})
  SET n += {eid: "art_73__para_2", citation: "Art. 73(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_2", chunk_type: "paragraph", level: "para", text: "The report referred to in paragraph 1 shall be made immediately after the provider has established a causal link between the AI system and the serious incident or the reasonable likelihood of such a link, and, in any event, not later than 15 days after the provider or, where applicable, the deployer, becomes aware of the serious incident. The period for the reporting referred to in the first subparagraph shall take account of the severity of the serious incident.", article: 73, paragraph: 2, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(2)"};
MERGE (n:Provision {id: "art_73__para_3"})
  SET n += {eid: "art_73__para_3", citation: "Art. 73(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_3", chunk_type: "paragraph", level: "para", text: "Notwithstanding paragraph 2 of this Article, in the event of a widespread infringement or a serious incident as defined in Article 3, point (49)(b), the report referred to in paragraph 1 of this Article shall be provided immediately, and not later than two days after the provider or, where applicable, the deployer becomes aware of that incident.", article: 73, paragraph: 3, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(3)"};
MERGE (n:Provision {id: "art_73__para_4"})
  SET n += {eid: "art_73__para_4", citation: "Art. 73(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_4", chunk_type: "paragraph", level: "para", text: "Notwithstanding paragraph 2, in the event of the death of a person, the report shall be provided immediately after the provider or the deployer has established, or as soon as it suspects, a causal relationship between the high-risk AI system and the serious incident, but not later than 10 days after the date on which the provider or, where applicable, the deployer becomes aware of the serious incident.", article: 73, paragraph: 4, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(4)"};
MERGE (n:Provision {id: "art_73__para_5"})
  SET n += {eid: "art_73__para_5", citation: "Art. 73(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_5", chunk_type: "paragraph", level: "para", text: "Where necessary to ensure timely reporting, the provider or, where applicable, the deployer, may submit an initial report that is incomplete, followed by a complete report.", article: 73, paragraph: 5, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(5)"};
MERGE (n:Provision {id: "art_73__para_6"})
  SET n += {eid: "art_73__para_6", citation: "Art. 73(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_6", chunk_type: "paragraph", level: "para", text: "Following the reporting of a serious incident pursuant to paragraph 1, the provider shall, without delay, perform the necessary investigations in relation to the serious incident and the AI system concerned. This shall include a risk assessment of the incident, and corrective action. The provider shall cooperate with the competent authorities, and where relevant with the notified body concerned, during the investigations referred to in the first subparagraph, and shall not perform any investigation which involves altering the AI system concerned in a way which may affect any subsequent evaluation of the causes of the incident, prior to informing the competent authorities of such action.", article: 73, paragraph: 6, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(6)"};
MERGE (n:Provision {id: "art_73__para_7"})
  SET n += {eid: "art_73__para_7", citation: "Art. 73(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_7", chunk_type: "paragraph", level: "para", text: "Upon receiving a notification related to a serious incident referred to in Article 3, point (49)(c), the relevant market surveillance authority shall inform the national public authorities or bodies referred to in Article 77(1). The Commission shall develop dedicated guidance to facilitate compliance with the obligations set out in paragraph 1 of this Article. That guidance shall be issued by 2 August 2025, and shall be assessed regularly.", article: 73, paragraph: 7, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(7)"};
MERGE (n:Provision {id: "art_73__para_8"})
  SET n += {eid: "art_73__para_8", citation: "Art. 73(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_8", chunk_type: "paragraph", level: "para", text: "The market surveillance authority shall take appropriate measures, as provided for in Article 19 of Regulation (EU) 2019/1020, within seven days from the date it received the notification referred to in paragraph 1 of this Article, and shall follow the notification procedures as provided in that Regulation.", article: 73, paragraph: 8, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(8)"};
MERGE (n:Provision {id: "art_73__para_9"})
  SET n += {eid: "art_73__para_9", citation: "Art. 73(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_9", chunk_type: "paragraph", level: "para", text: "For high-risk AI systems referred to in Annex III that are placed on the market or put into service by providers that are subject to Union legislative instruments laying down reporting obligations equivalent to those set out in this Regulation, the notification of serious incidents shall be limited to those referred to in Article 3, point (49)(c).", article: 73, paragraph: 9, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(9)"};
MERGE (n:Provision {id: "art_73__para_10"})
  SET n += {eid: "art_73__para_10", citation: "Art. 73(10)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_10", chunk_type: "paragraph", level: "para", text: "For high-risk AI systems which are safety components of devices, or are themselves devices, covered by Regulations (EU) 2017/745 and (EU) 2017/746, the notification of serious incidents shall be limited to those referred to in Article 3, point (49)(c) of this Regulation, and shall be made to the national competent authority chosen for that purpose by the Member States where the incident occurred.", article: 73, paragraph: 10, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(10)"};
MERGE (n:Provision {id: "art_73__para_11"})
  SET n += {eid: "art_73__para_11", citation: "Art. 73(11)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_73__para_11", chunk_type: "paragraph", level: "para", text: "National competent authorities shall immediately notify the Commission of any serious incident, whether or not they have taken action on it, in accordance with Article 20 of Regulation (EU) 2019/1020.", article: 73, paragraph: 11, chapter: 9, section: "2", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 73(11)"};
MERGE (n:Provision {id: "art_74"})
  SET n += {eid: "art_74", citation: "Art. 74", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74", chunk_type: "article_full", level: "art", text: "Article 74 — Market surveillance and control of AI systems in the Union market\n\n1. Regulation (EU) 2019/1020 shall apply to AI systems covered by this Regulation. For the purposes of the effective enforcement of this Regulation:\n(a) any reference to an economic operator under Regulation (EU) 2019/1020 shall be understood as including all operators identified in Article 2(1) of this Regulation;\n(b) any reference to a product under Regulation (EU) 2019/1020 shall be understood as including all AI systems falling within the scope of this Regulation.\n\n2. As part of their reporting obligations under Article 34(4) of Regulation (EU) 2019/1020, the market surveillance authorities shall report annually to the Commission and relevant national competition authorities any information identified in the course of market surveillance activities that may be of potential interest for the application of Union law on competition rules. They shall also annually report to the Commission about the use of prohibited practices that occurred during that year and about the measures taken.\n\n3. For high-risk AI systems related to products covered by the Union harmonisation legislation listed in Section A of Annex I, the market surveillance authority for the purposes of this Regulation shall be the authority responsible for market surveillance activities designated under those legal acts. By derogation from the first subparagraph, and in appropriate circumstances, Member States may designate another relevant authority to act as a market surveillance authority, provided they ensure coordination with the relevant sectoral market surveillance authorities responsible for the enforcement of the Union harmonisation legislation listed in Annex I.\n\n4. The procedures referred to in Articles 79 to 83 of this Regulation shall not apply to AI systems related to products covered by the Union harmonisation legislation listed in section A of Annex I, where such legal acts already provide for procedures ensuring an equivalent level of protection and having the same objective. In such cases, the relevant sectoral procedures shall apply instead.\n\n5. Without prejudice to the powers of market surveillance authorities under Article 14 of Regulation (EU) 2019/1020, for the purpose of ensuring the effective enforcement of this Regulation, market surveillance authorities may exercise the powers referred to in Article 14(4), points (d) and (j), of that Regulation remotely, as appropriate.\n\n6. For high-risk AI systems placed on the market, put into service, or used by financial institutions regulated by Union financial services law, the market surveillance authority for the purposes of this Regulation shall be the relevant national authority responsible for the financial supervision of those institutions under that legislation in so far as the placing on the market, putting into service, or the use of the AI system is in direct connection with the provision of those financial services.\n\n7. By way of derogation from paragraph 6, in appropriate circumstances, and provided that coordination is ensured, another relevant authority may be identified by the Member State as market surveillance authority for the purposes of this Regulation. National market surveillance authorities supervising regulated credit institutions regulated under Directive 2013/36/EU, which are participating in the Single Supervisory Mechanism established by Regulation (EU) No 1024/2013, should report, without delay, to the European Central Bank any information identified in the course of their market surveillance activities that may be of potential interest for the prudential supervisory tasks of the European Central Bank specified in that Regulation.\n\n8. For high-risk AI systems listed in point 1 of Annex III to this Regulation, in so far as the systems are used for law enforcement purposes, border management and justice and democracy, and for high-risk AI systems listed in points 6, 7 and 8 of Annex III to this Regulation, Member States shall designate as market surveillance authorities for the purposes of this Regulation either the competent data protection supervisory authorities under Regulation (EU) 2016/679 or Directive (EU) 2016/680, or any other authority designated pursuant to the same conditions laid down in Articles 41 to 44 of Directive (EU) 2016/680. Market surveillance activities shall in no way affect the independence of judicial authorities, or otherwise interfere with their activities when acting in their judicial capacity.\n\n9. Where Union institutions, bodies, offices or agencies fall within the scope of this Regulation, the European Data Protection Supervisor shall act as their market surveillance authority, except in relation to the Court of Justice of the European Union acting in its judicial capacity.\n\n10. Member States shall facilitate coordination between market surveillance authorities designated under this Regulation and other relevant national authorities or bodies which supervise the application of Union harmonisation legislation listed in Annex I, or in other Union law, that might be relevant for the high-risk AI systems referred to in Annex III.\n\n11. Market surveillance authorities and the Commission shall be able to propose joint activities, including joint investigations, to be conducted by either market surveillance authorities or market surveillance authorities jointly with the Commission, that have the aim of promoting compliance, identifying non-compliance, raising awareness or providing guidance in relation to this Regulation with respect to specific categories of high-risk AI systems that are found to present a serious risk across two or more Member States in accordance with Article 9 of Regulation (EU) 2019/1020. The AI Office shall provide coordination support for joint investigations.\n\n12. Without prejudice to the powers provided for under Regulation (EU) 2019/1020, and where relevant and limited to what is necessary to fulfil their tasks, the market surveillance authorities shall be granted full access by providers to the documentation as well as the training, validation and testing data sets used for the development of high-risk AI systems, including, where appropriate and subject to security safeguards, through application programming interfaces (API) or other relevant technical means and tools enabling remote access.\n\n13. Market surveillance authorities shall be granted access to the source code of the high-risk AI system upon a reasoned request and only when both of the following conditions are fulfilled:\n(a) access to source code is necessary to assess the conformity of a high-risk AI system with the requirements set out in Chapter III, Section 2; and\n(b) testing or auditing procedures and verifications based on the data and documentation provided by the provider have been exhausted or proved insufficient.\n\n14. Any information or documentation obtained by market surveillance authorities shall be treated in accordance with the confidentiality obligations set out in Article 78.", article: 74, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74"};
MERGE (n:Provision {id: "art_74__para_1"})
  SET n += {eid: "art_74__para_1", citation: "Art. 74(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_1", chunk_type: "paragraph", level: "para", text: "Regulation (EU) 2019/1020 shall apply to AI systems covered by this Regulation. For the purposes of the effective enforcement of this Regulation:\n(a) any reference to an economic operator under Regulation (EU) 2019/1020 shall be understood as including all operators identified in Article 2(1) of this Regulation;\n(b) any reference to a product under Regulation (EU) 2019/1020 shall be understood as including all AI systems falling within the scope of this Regulation.", article: 74, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(1)"};
MERGE (n:Provision {id: "art_74__para_1__point_a"})
  SET n += {eid: "art_74__para_1__point_a", citation: "Art. 74(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_1__point_a", chunk_type: "point", level: "point", text: "any reference to an economic operator under Regulation (EU) 2019/1020 shall be understood as including all operators identified in Article 2(1) of this Regulation", article: 74, paragraph: 1, point: "a", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(1)(a)"};
MERGE (n:Provision {id: "art_74__para_1__point_b"})
  SET n += {eid: "art_74__para_1__point_b", citation: "Art. 74(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_1__point_b", chunk_type: "point", level: "point", text: "any reference to a product under Regulation (EU) 2019/1020 shall be understood as including all AI systems falling within the scope of this Regulation", article: 74, paragraph: 1, point: "b", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(1)(b)"};
MERGE (n:Provision {id: "art_74__para_2"})
  SET n += {eid: "art_74__para_2", citation: "Art. 74(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_2", chunk_type: "paragraph", level: "para", text: "As part of their reporting obligations under Article 34(4) of Regulation (EU) 2019/1020, the market surveillance authorities shall report annually to the Commission and relevant national competition authorities any information identified in the course of market surveillance activities that may be of potential interest for the application of Union law on competition rules. They shall also annually report to the Commission about the use of prohibited practices that occurred during that year and about the measures taken.", article: 74, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(2)"};
MERGE (n:Provision {id: "art_74__para_3"})
  SET n += {eid: "art_74__para_3", citation: "Art. 74(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_3", chunk_type: "paragraph", level: "para", text: "For high-risk AI systems related to products covered by the Union harmonisation legislation listed in Section A of Annex I, the market surveillance authority for the purposes of this Regulation shall be the authority responsible for market surveillance activities designated under those legal acts. By derogation from the first subparagraph, and in appropriate circumstances, Member States may designate another relevant authority to act as a market surveillance authority, provided they ensure coordination with the relevant sectoral market surveillance authorities responsible for the enforcement of the Union harmonisation legislation listed in Annex I.", article: 74, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(3)"};
MERGE (n:Provision {id: "art_74__para_4"})
  SET n += {eid: "art_74__para_4", citation: "Art. 74(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_4", chunk_type: "paragraph", level: "para", text: "The procedures referred to in Articles 79 to 83 of this Regulation shall not apply to AI systems related to products covered by the Union harmonisation legislation listed in section A of Annex I, where such legal acts already provide for procedures ensuring an equivalent level of protection and having the same objective. In such cases, the relevant sectoral procedures shall apply instead.", article: 74, paragraph: 4, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(4)"};
MERGE (n:Provision {id: "art_74__para_5"})
  SET n += {eid: "art_74__para_5", citation: "Art. 74(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_5", chunk_type: "paragraph", level: "para", text: "Without prejudice to the powers of market surveillance authorities under Article 14 of Regulation (EU) 2019/1020, for the purpose of ensuring the effective enforcement of this Regulation, market surveillance authorities may exercise the powers referred to in Article 14(4), points (d) and (j), of that Regulation remotely, as appropriate.", article: 74, paragraph: 5, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(5)"};
MERGE (n:Provision {id: "art_74__para_6"})
  SET n += {eid: "art_74__para_6", citation: "Art. 74(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_6", chunk_type: "paragraph", level: "para", text: "For high-risk AI systems placed on the market, put into service, or used by financial institutions regulated by Union financial services law, the market surveillance authority for the purposes of this Regulation shall be the relevant national authority responsible for the financial supervision of those institutions under that legislation in so far as the placing on the market, putting into service, or the use of the AI system is in direct connection with the provision of those financial services.", article: 74, paragraph: 6, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(6)"};
MERGE (n:Provision {id: "art_74__para_7"})
  SET n += {eid: "art_74__para_7", citation: "Art. 74(7)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_7", chunk_type: "paragraph", level: "para", text: "By way of derogation from paragraph 6, in appropriate circumstances, and provided that coordination is ensured, another relevant authority may be identified by the Member State as market surveillance authority for the purposes of this Regulation. National market surveillance authorities supervising regulated credit institutions regulated under Directive 2013/36/EU, which are participating in the Single Supervisory Mechanism established by Regulation (EU) No 1024/2013, should report, without delay, to the European Central Bank any information identified in the course of their market surveillance activities that may be of potential interest for the prudential supervisory tasks of the European Central Bank specified in that Regulation.", article: 74, paragraph: 7, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(7)"};
MERGE (n:Provision {id: "art_74__para_8"})
  SET n += {eid: "art_74__para_8", citation: "Art. 74(8)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_8", chunk_type: "paragraph", level: "para", text: "For high-risk AI systems listed in point 1 of Annex III to this Regulation, in so far as the systems are used for law enforcement purposes, border management and justice and democracy, and for high-risk AI systems listed in points 6, 7 and 8 of Annex III to this Regulation, Member States shall designate as market surveillance authorities for the purposes of this Regulation either the competent data protection supervisory authorities under Regulation (EU) 2016/679 or Directive (EU) 2016/680, or any other authority designated pursuant to the same conditions laid down in Articles 41 to 44 of Directive (EU) 2016/680. Market surveillance activities shall in no way affect the independence of judicial authorities, or otherwise interfere with their activities when acting in their judicial capacity.", article: 74, paragraph: 8, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(8)"};
MERGE (n:Provision {id: "art_74__para_9"})
  SET n += {eid: "art_74__para_9", citation: "Art. 74(9)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_9", chunk_type: "paragraph", level: "para", text: "Where Union institutions, bodies, offices or agencies fall within the scope of this Regulation, the European Data Protection Supervisor shall act as their market surveillance authority, except in relation to the Court of Justice of the European Union acting in its judicial capacity.", article: 74, paragraph: 9, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(9)"};
MERGE (n:Provision {id: "art_74__para_10"})
  SET n += {eid: "art_74__para_10", citation: "Art. 74(10)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_10", chunk_type: "paragraph", level: "para", text: "Member States shall facilitate coordination between market surveillance authorities designated under this Regulation and other relevant national authorities or bodies which supervise the application of Union harmonisation legislation listed in Annex I, or in other Union law, that might be relevant for the high-risk AI systems referred to in Annex III.", article: 74, paragraph: 10, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(10)"};
MERGE (n:Provision {id: "art_74__para_11"})
  SET n += {eid: "art_74__para_11", citation: "Art. 74(11)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_11", chunk_type: "paragraph", level: "para", text: "Market surveillance authorities and the Commission shall be able to propose joint activities, including joint investigations, to be conducted by either market surveillance authorities or market surveillance authorities jointly with the Commission, that have the aim of promoting compliance, identifying non-compliance, raising awareness or providing guidance in relation to this Regulation with respect to specific categories of high-risk AI systems that are found to present a serious risk across two or more Member States in accordance with Article 9 of Regulation (EU) 2019/1020. The AI Office shall provide coordination support for joint investigations.", article: 74, paragraph: 11, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(11)"};
MERGE (n:Provision {id: "art_74__para_12"})
  SET n += {eid: "art_74__para_12", citation: "Art. 74(12)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_12", chunk_type: "paragraph", level: "para", text: "Without prejudice to the powers provided for under Regulation (EU) 2019/1020, and where relevant and limited to what is necessary to fulfil their tasks, the market surveillance authorities shall be granted full access by providers to the documentation as well as the training, validation and testing data sets used for the development of high-risk AI systems, including, where appropriate and subject to security safeguards, through application programming interfaces (API) or other relevant technical means and tools enabling remote access.", article: 74, paragraph: 12, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(12)"};
MERGE (n:Provision {id: "art_74__para_13"})
  SET n += {eid: "art_74__para_13", citation: "Art. 74(13)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_13", chunk_type: "paragraph", level: "para", text: "Market surveillance authorities shall be granted access to the source code of the high-risk AI system upon a reasoned request and only when both of the following conditions are fulfilled:\n(a) access to source code is necessary to assess the conformity of a high-risk AI system with the requirements set out in Chapter III, Section 2; and\n(b) testing or auditing procedures and verifications based on the data and documentation provided by the provider have been exhausted or proved insufficient.", article: 74, paragraph: 13, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(13)"};
MERGE (n:Provision {id: "art_74__para_13__point_a"})
  SET n += {eid: "art_74__para_13__point_a", citation: "Art. 74(13)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_13__point_a", chunk_type: "point", level: "point", text: "access to source code is necessary to assess the conformity of a high-risk AI system with the requirements set out in Chapter III, Section 2; and", article: 74, paragraph: 13, point: "a", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(13)(a)"};
MERGE (n:Provision {id: "art_74__para_13__point_b"})
  SET n += {eid: "art_74__para_13__point_b", citation: "Art. 74(13)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_13__point_b", chunk_type: "point", level: "point", text: "testing or auditing procedures and verifications based on the data and documentation provided by the provider have been exhausted or proved insufficient", article: 74, paragraph: 13, point: "b", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(13)(b)"};
MERGE (n:Provision {id: "art_74__para_14"})
  SET n += {eid: "art_74__para_14", citation: "Art. 74(14)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_74__para_14", chunk_type: "paragraph", level: "para", text: "Any information or documentation obtained by market surveillance authorities shall be treated in accordance with the confidentiality obligations set out in Article 78.", article: 74, paragraph: 14, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 74(14)"};
MERGE (n:Provision {id: "art_75"})
  SET n += {eid: "art_75", citation: "Art. 75", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_75", chunk_type: "article_full", level: "art", text: "Article 75 — Mutual assistance, market surveillance and control of general-purpose AI systems\n\n1. Where an AI system is based on a general-purpose AI model, and the model and the system are developed by the same provider, the AI Office shall have powers to monitor and supervise compliance of that AI system with obligations under this Regulation. To carry out its monitoring and supervision tasks, the AI Office shall have all the powers of a market surveillance authority provided for in this Section and Regulation (EU) 2019/1020.\n\n2. Where the relevant market surveillance authorities have sufficient reason to consider general-purpose AI systems that can be used directly by deployers for at least one purpose that is classified as high-risk pursuant to this Regulation to be non-compliant with the requirements laid down in this Regulation, they shall cooperate with the AI Office to carry out compliance evaluations, and shall inform the Board and other market surveillance authorities accordingly.\n\n3. Where a market surveillance authority is unable to conclude its investigation of the high-risk AI system because of its inability to access certain information related to the general-purpose AI model despite having made all appropriate efforts to obtain that information, it may submit a reasoned request to the AI Office, by which access to that information shall be enforced. In that case, the AI Office shall supply to the applicant authority without delay, and in any event within 30 days, any information that the AI Office considers to be relevant in order to establish whether a high-risk AI system is non-compliant. Market surveillance authorities shall safeguard the confidentiality of the information that they obtain in accordance with Article 78 of this Regulation. The procedure provided for in Chapter VI of Regulation (EU) 2019/1020 shall apply mutatis mutandis.", article: 75, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 75"};
MERGE (n:Provision {id: "art_75__para_1"})
  SET n += {eid: "art_75__para_1", citation: "Art. 75(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_75__para_1", chunk_type: "paragraph", level: "para", text: "Where an AI system is based on a general-purpose AI model, and the model and the system are developed by the same provider, the AI Office shall have powers to monitor and supervise compliance of that AI system with obligations under this Regulation. To carry out its monitoring and supervision tasks, the AI Office shall have all the powers of a market surveillance authority provided for in this Section and Regulation (EU) 2019/1020.", article: 75, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 75(1)"};
MERGE (n:Provision {id: "art_75__para_2"})
  SET n += {eid: "art_75__para_2", citation: "Art. 75(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_75__para_2", chunk_type: "paragraph", level: "para", text: "Where the relevant market surveillance authorities have sufficient reason to consider general-purpose AI systems that can be used directly by deployers for at least one purpose that is classified as high-risk pursuant to this Regulation to be non-compliant with the requirements laid down in this Regulation, they shall cooperate with the AI Office to carry out compliance evaluations, and shall inform the Board and other market surveillance authorities accordingly.", article: 75, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 75(2)"};
MERGE (n:Provision {id: "art_75__para_3"})
  SET n += {eid: "art_75__para_3", citation: "Art. 75(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_75__para_3", chunk_type: "paragraph", level: "para", text: "Where a market surveillance authority is unable to conclude its investigation of the high-risk AI system because of its inability to access certain information related to the general-purpose AI model despite having made all appropriate efforts to obtain that information, it may submit a reasoned request to the AI Office, by which access to that information shall be enforced. In that case, the AI Office shall supply to the applicant authority without delay, and in any event within 30 days, any information that the AI Office considers to be relevant in order to establish whether a high-risk AI system is non-compliant. Market surveillance authorities shall safeguard the confidentiality of the information that they obtain in accordance with Article 78 of this Regulation. The procedure provided for in Chapter VI of Regulation (EU) 2019/1020 shall apply mutatis mutandis.", article: 75, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 75(3)"};
MERGE (n:Provision {id: "art_76"})
  SET n += {eid: "art_76", citation: "Art. 76", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76", chunk_type: "article_full", level: "art", text: "Article 76 — Supervision of testing in real world conditions by market surveillance authorities\n\n1. Market surveillance authorities shall have competences and powers to ensure that testing in real world conditions is in accordance with this Regulation.\n\n2. Where testing in real world conditions is conducted for AI systems that are supervised within an AI regulatory sandbox under Article 58, the market surveillance authorities shall verify the compliance with Article 60 as part of their supervisory role for the AI regulatory sandbox. Those authorities may, as appropriate, allow the testing in real world conditions to be conducted by the provider or prospective provider, in derogation from the conditions set out in Article 60(4), points (f) and (g).\n\n3. Where a market surveillance authority has been informed by the prospective provider, the provider or any third party of a serious incident or has other grounds for considering that the conditions set out in Articles 60 and 61 are not met, it may take either of the following decisions on its territory, as appropriate:\n(a) to suspend or terminate the testing in real world conditions;\n(b) to require the provider or prospective provider and the deployer or prospective deployer to modify any aspect of the testing in real world conditions.\n\n4. Where a market surveillance authority has taken a decision referred to in paragraph 3 of this Article, or has issued an objection within the meaning of Article 60(4), point (b), the decision or the objection shall indicate the grounds therefor and how the provider or prospective provider can challenge the decision or objection.\n\n5. Where applicable, where a market surveillance authority has taken a decision referred to in paragraph 3, it shall communicate the grounds therefor to the market surveillance authorities of other Member States in which the AI system has been tested in accordance with the testing plan.", article: 76, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76"};
MERGE (n:Provision {id: "art_76__para_1"})
  SET n += {eid: "art_76__para_1", citation: "Art. 76(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76__para_1", chunk_type: "paragraph", level: "para", text: "Market surveillance authorities shall have competences and powers to ensure that testing in real world conditions is in accordance with this Regulation.", article: 76, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76(1)"};
MERGE (n:Provision {id: "art_76__para_2"})
  SET n += {eid: "art_76__para_2", citation: "Art. 76(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76__para_2", chunk_type: "paragraph", level: "para", text: "Where testing in real world conditions is conducted for AI systems that are supervised within an AI regulatory sandbox under Article 58, the market surveillance authorities shall verify the compliance with Article 60 as part of their supervisory role for the AI regulatory sandbox. Those authorities may, as appropriate, allow the testing in real world conditions to be conducted by the provider or prospective provider, in derogation from the conditions set out in Article 60(4), points (f) and (g).", article: 76, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76(2)"};
MERGE (n:Provision {id: "art_76__para_3"})
  SET n += {eid: "art_76__para_3", citation: "Art. 76(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76__para_3", chunk_type: "paragraph", level: "para", text: "Where a market surveillance authority has been informed by the prospective provider, the provider or any third party of a serious incident or has other grounds for considering that the conditions set out in Articles 60 and 61 are not met, it may take either of the following decisions on its territory, as appropriate:\n(a) to suspend or terminate the testing in real world conditions;\n(b) to require the provider or prospective provider and the deployer or prospective deployer to modify any aspect of the testing in real world conditions.", article: 76, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76(3)"};
MERGE (n:Provision {id: "art_76__para_3__point_a"})
  SET n += {eid: "art_76__para_3__point_a", citation: "Art. 76(3)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76__para_3__point_a", chunk_type: "point", level: "point", text: "to suspend or terminate the testing in real world conditions", article: 76, paragraph: 3, point: "a", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76(3)(a)"};
MERGE (n:Provision {id: "art_76__para_3__point_b"})
  SET n += {eid: "art_76__para_3__point_b", citation: "Art. 76(3)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76__para_3__point_b", chunk_type: "point", level: "point", text: "to require the provider or prospective provider and the deployer or prospective deployer to modify any aspect of the testing in real world conditions", article: 76, paragraph: 3, point: "b", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76(3)(b)"};
MERGE (n:Provision {id: "art_76__para_4"})
  SET n += {eid: "art_76__para_4", citation: "Art. 76(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76__para_4", chunk_type: "paragraph", level: "para", text: "Where a market surveillance authority has taken a decision referred to in paragraph 3 of this Article, or has issued an objection within the meaning of Article 60(4), point (b), the decision or the objection shall indicate the grounds therefor and how the provider or prospective provider can challenge the decision or objection.", article: 76, paragraph: 4, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76(4)"};
MERGE (n:Provision {id: "art_76__para_5"})
  SET n += {eid: "art_76__para_5", citation: "Art. 76(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_76__para_5", chunk_type: "paragraph", level: "para", text: "Where applicable, where a market surveillance authority has taken a decision referred to in paragraph 3, it shall communicate the grounds therefor to the market surveillance authorities of other Member States in which the AI system has been tested in accordance with the testing plan.", article: 76, paragraph: 5, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 76(5)"};
MERGE (n:Provision {id: "art_77"})
  SET n += {eid: "art_77", citation: "Art. 77", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_77", chunk_type: "article_full", level: "art", text: "Article 77 — Powers of authorities protecting fundamental rights\n\n1. National public authorities or bodies which supervise or enforce the respect of obligations under Union law protecting fundamental rights, including the right to non-discrimination, in relation to the use of high-risk AI systems referred to in Annex III shall have the power to request and access any documentation created or maintained under this Regulation in accessible language and format when access to that documentation is necessary for effectively fulfilling their mandates within the limits of their jurisdiction. The relevant public authority or body shall inform the market surveillance authority of the Member State concerned of any such request.\n\n2. By 2 November 2024, each Member State shall identify the public authorities or bodies referred to in paragraph 1 and make a list of them publicly available. Member States shall notify the list to the Commission and to the other Member States, and shall keep the list up to date.\n\n3. Where the documentation referred to in paragraph 1 is insufficient to ascertain whether an infringement of obligations under Union law protecting fundamental rights has occurred, the public authority or body referred to in paragraph 1 may make a reasoned request to the market surveillance authority, to organise testing of the high-risk AI system through technical means. The market surveillance authority shall organise the testing with the close involvement of the requesting public authority or body within a reasonable time following the request.\n\n4. Any information or documentation obtained by the national public authorities or bodies referred to in paragraph 1 of this Article pursuant to this Article shall be treated in accordance with the confidentiality obligations set out in Article 78.", article: 77, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 77"};
MERGE (n:Provision {id: "art_77__para_1"})
  SET n += {eid: "art_77__para_1", citation: "Art. 77(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_77__para_1", chunk_type: "paragraph", level: "para", text: "National public authorities or bodies which supervise or enforce the respect of obligations under Union law protecting fundamental rights, including the right to non-discrimination, in relation to the use of high-risk AI systems referred to in Annex III shall have the power to request and access any documentation created or maintained under this Regulation in accessible language and format when access to that documentation is necessary for effectively fulfilling their mandates within the limits of their jurisdiction. The relevant public authority or body shall inform the market surveillance authority of the Member State concerned of any such request.", article: 77, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 77(1)"};
MERGE (n:Provision {id: "art_77__para_2"})
  SET n += {eid: "art_77__para_2", citation: "Art. 77(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_77__para_2", chunk_type: "paragraph", level: "para", text: "By 2 November 2024, each Member State shall identify the public authorities or bodies referred to in paragraph 1 and make a list of them publicly available. Member States shall notify the list to the Commission and to the other Member States, and shall keep the list up to date.", article: 77, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 77(2)"};
MERGE (n:Provision {id: "art_77__para_3"})
  SET n += {eid: "art_77__para_3", citation: "Art. 77(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_77__para_3", chunk_type: "paragraph", level: "para", text: "Where the documentation referred to in paragraph 1 is insufficient to ascertain whether an infringement of obligations under Union law protecting fundamental rights has occurred, the public authority or body referred to in paragraph 1 may make a reasoned request to the market surveillance authority, to organise testing of the high-risk AI system through technical means. The market surveillance authority shall organise the testing with the close involvement of the requesting public authority or body within a reasonable time following the request.", article: 77, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 77(3)"};
MERGE (n:Provision {id: "art_77__para_4"})
  SET n += {eid: "art_77__para_4", citation: "Art. 77(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_77__para_4", chunk_type: "paragraph", level: "para", text: "Any information or documentation obtained by the national public authorities or bodies referred to in paragraph 1 of this Article pursuant to this Article shall be treated in accordance with the confidentiality obligations set out in Article 78.", article: 77, paragraph: 4, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 77(4)"};
MERGE (n:Provision {id: "art_78"})
  SET n += {eid: "art_78", citation: "Art. 78", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78", chunk_type: "article_full", level: "art", text: "Article 78 — Confidentiality\n\n1. The Commission, market surveillance authorities and notified bodies and any other natural or legal person involved in the application of this Regulation shall, in accordance with Union or national law, respect the confidentiality of information and data obtained in carrying out their tasks and activities in such a manner as to protect, in particular:\n(a) the intellectual property rights and confidential business information or trade secrets of a natural or legal person, including source code, except in the cases referred to in Article 5 of Directive (EU) 2016/943 of the European Parliament and of the Council;\n(b) the effective implementation of this Regulation, in particular for the purposes of inspections, investigations or audits;\n(c) public and national security interests;\n(d) the conduct of criminal or administrative proceedings;\n(e) information classified pursuant to Union or national law.\n\n2. The authorities involved in the application of this Regulation pursuant to paragraph 1 shall request only data that is strictly necessary for the assessment of the risk posed by AI systems and for the exercise of their powers in accordance with this Regulation and with Regulation (EU) 2019/1020. They shall put in place adequate and effective cybersecurity measures to protect the security and confidentiality of the information and data obtained, and shall delete the data collected as soon as it is no longer needed for the purpose for which it was obtained, in accordance with applicable Union or national law.\n\n3. Without prejudice to paragraphs 1 and 2, information exchanged on a confidential basis between the national competent authorities or between national competent authorities and the Commission shall not be disclosed without prior consultation of the originating national competent authority and the deployer when high-risk AI systems referred to in point 1, 6 or 7 of Annex III are used by law enforcement, border control, immigration or asylum authorities and when such disclosure would jeopardise public and national security interests. This exchange of information shall not cover sensitive operational data in relation to the activities of law enforcement, border control, immigration or asylum authorities. When the law enforcement, immigration or asylum authorities are providers of high-risk AI systems referred to in point 1, 6 or 7 of Annex III, the technical documentation referred to in Annex IV shall remain within the premises of those authorities. Those authorities shall ensure that the market surveillance authorities referred to in Article 74(8) and (9), as applicable, can, upon request, immediately access the documentation or obtain a copy thereof. Only staff of the market surveillance authority holding the appropriate level of security clearance shall be allowed to access that documentation or any copy thereof.\n\n4. Paragraphs 1, 2 and 3 shall not affect the rights or obligations of the Commission, Member States and their relevant authorities, as well as those of notified bodies, with regard to the exchange of information and the dissemination of warnings, including in the context of cross-border cooperation, nor shall they affect the obligations of the parties concerned to provide information under criminal law of the Member States.\n\n5. The Commission and Member States may exchange, where necessary and in accordance with relevant provisions of international and trade agreements, confidential information with regulatory authorities of third countries with which they have concluded bilateral or multilateral confidentiality arrangements guaranteeing an adequate level of confidentiality.", article: 78, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78"};
MERGE (n:Provision {id: "art_78__para_1"})
  SET n += {eid: "art_78__para_1", citation: "Art. 78(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_1", chunk_type: "paragraph", level: "para", text: "The Commission, market surveillance authorities and notified bodies and any other natural or legal person involved in the application of this Regulation shall, in accordance with Union or national law, respect the confidentiality of information and data obtained in carrying out their tasks and activities in such a manner as to protect, in particular:\n(a) the intellectual property rights and confidential business information or trade secrets of a natural or legal person, including source code, except in the cases referred to in Article 5 of Directive (EU) 2016/943 of the European Parliament and of the Council;\n(b) the effective implementation of this Regulation, in particular for the purposes of inspections, investigations or audits;\n(c) public and national security interests;\n(d) the conduct of criminal or administrative proceedings;\n(e) information classified pursuant to Union or national law.", article: 78, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(1)"};
MERGE (n:Provision {id: "art_78__para_1__point_a"})
  SET n += {eid: "art_78__para_1__point_a", citation: "Art. 78(1)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_1__point_a", chunk_type: "point", level: "point", text: "the intellectual property rights and confidential business information or trade secrets of a natural or legal person, including source code, except in the cases referred to in Article 5 of Directive (EU) 2016/943 of the European Parliament and of the Council", article: 78, paragraph: 1, point: "a", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(1)(a)"};
MERGE (n:Provision {id: "art_78__para_1__point_b"})
  SET n += {eid: "art_78__para_1__point_b", citation: "Art. 78(1)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_1__point_b", chunk_type: "point", level: "point", text: "the effective implementation of this Regulation, in particular for the purposes of inspections, investigations or audits", article: 78, paragraph: 1, point: "b", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(1)(b)"};
MERGE (n:Provision {id: "art_78__para_1__point_c"})
  SET n += {eid: "art_78__para_1__point_c", citation: "Art. 78(1)(c)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_1__point_c", chunk_type: "point", level: "point", text: "public and national security interests", article: 78, paragraph: 1, point: "c", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(1)(c)"};
MERGE (n:Provision {id: "art_78__para_1__point_d"})
  SET n += {eid: "art_78__para_1__point_d", citation: "Art. 78(1)(d)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_1__point_d", chunk_type: "point", level: "point", text: "the conduct of criminal or administrative proceedings", article: 78, paragraph: 1, point: "d", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(1)(d)"};
MERGE (n:Provision {id: "art_78__para_1__point_e"})
  SET n += {eid: "art_78__para_1__point_e", citation: "Art. 78(1)(e)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_1__point_e", chunk_type: "point", level: "point", text: "information classified pursuant to Union or national law", article: 78, paragraph: 1, point: "e", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(1)(e)"};
MERGE (n:Provision {id: "art_78__para_2"})
  SET n += {eid: "art_78__para_2", citation: "Art. 78(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_2", chunk_type: "paragraph", level: "para", text: "The authorities involved in the application of this Regulation pursuant to paragraph 1 shall request only data that is strictly necessary for the assessment of the risk posed by AI systems and for the exercise of their powers in accordance with this Regulation and with Regulation (EU) 2019/1020. They shall put in place adequate and effective cybersecurity measures to protect the security and confidentiality of the information and data obtained, and shall delete the data collected as soon as it is no longer needed for the purpose for which it was obtained, in accordance with applicable Union or national law.", article: 78, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(2)"};
MERGE (n:Provision {id: "art_78__para_3"})
  SET n += {eid: "art_78__para_3", citation: "Art. 78(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_3", chunk_type: "paragraph", level: "para", text: "Without prejudice to paragraphs 1 and 2, information exchanged on a confidential basis between the national competent authorities or between national competent authorities and the Commission shall not be disclosed without prior consultation of the originating national competent authority and the deployer when high-risk AI systems referred to in point 1, 6 or 7 of Annex III are used by law enforcement, border control, immigration or asylum authorities and when such disclosure would jeopardise public and national security interests. This exchange of information shall not cover sensitive operational data in relation to the activities of law enforcement, border control, immigration or asylum authorities. When the law enforcement, immigration or asylum authorities are providers of high-risk AI systems referred to in point 1, 6 or 7 of Annex III, the technical documentation referred to in Annex IV shall remain within the premises of those authorities. Those authorities shall ensure that the market surveillance authorities referred to in Article 74(8) and (9), as applicable, can, upon request, immediately access the documentation or obtain a copy thereof. Only staff of the market surveillance authority holding the appropriate level of security clearance shall be allowed to access that documentation or any copy thereof.", article: 78, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(3)"};
MERGE (n:Provision {id: "art_78__para_4"})
  SET n += {eid: "art_78__para_4", citation: "Art. 78(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_4", chunk_type: "paragraph", level: "para", text: "Paragraphs 1, 2 and 3 shall not affect the rights or obligations of the Commission, Member States and their relevant authorities, as well as those of notified bodies, with regard to the exchange of information and the dissemination of warnings, including in the context of cross-border cooperation, nor shall they affect the obligations of the parties concerned to provide information under criminal law of the Member States.", article: 78, paragraph: 4, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(4)"};
MERGE (n:Provision {id: "art_78__para_5"})
  SET n += {eid: "art_78__para_5", citation: "Art. 78(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_78__para_5", chunk_type: "paragraph", level: "para", text: "The Commission and Member States may exchange, where necessary and in accordance with relevant provisions of international and trade agreements, confidential information with regulatory authorities of third countries with which they have concluded bilateral or multilateral confidentiality arrangements guaranteeing an adequate level of confidentiality.", article: 78, paragraph: 5, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2025-08-02", name: "Art. 78(5)"};
MERGE (n:Provision {id: "art_79"})
  SET n += {eid: "art_79", citation: "Art. 79", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79", chunk_type: "article_full", level: "art", text: "Article 79 — Procedure at national level for dealing with AI systems presenting a risk\n\n1. AI systems presenting a risk shall be understood as a “product presenting a risk” as defined in Article 3, point 19 of Regulation (EU) 2019/1020, in so far as they present risks to the health or safety, or to fundamental rights, of persons.\n\n2. Where the market surveillance authority of a Member State has sufficient reason to consider an AI system to present a risk as referred to in paragraph 1 of this Article, it shall carry out an evaluation of the AI system concerned in respect of its compliance with all the requirements and obligations laid down in this Regulation. Particular attention shall be given to AI systems presenting a risk to vulnerable groups. Where risks to fundamental rights are identified, the market surveillance authority shall also inform and fully cooperate with the relevant national public authorities or bodies referred to in Article 77(1). The relevant operators shall cooperate as necessary with the market surveillance authority and with the other national public authorities or bodies referred to in Article 77(1). Where, in the course of that evaluation, the market surveillance authority or, where applicable the market surveillance authority in cooperation with the national public authority referred to in Article 77(1), finds that the AI system does not comply with the requirements and obligations laid down in this Regulation, it shall without undue delay require the relevant operator to take all appropriate corrective actions to bring the AI system into compliance, to withdraw the AI system from the market, or to recall it within a period the market surveillance authority may prescribe, and in any event within the shorter of 15 working days, or as provided for in the relevant Union harmonisation legislation. The market surveillance authority shall inform the relevant notified body accordingly. Article 18 of Regulation (EU) 2019/1020 shall apply to the measures referred to in the second subparagraph of this paragraph.\n\n3. Where the market surveillance authority considers that the non-compliance is not restricted to its national territory, it shall inform the Commission and the other Member States without undue delay of the results of the evaluation and of the actions which it has required the operator to take.\n\n4. The operator shall ensure that all appropriate corrective action is taken in respect of all the AI systems concerned that it has made available on the Union market.\n\n5. Where the operator of an AI system does not take adequate corrective action within the period referred to in paragraph 2, the market surveillance authority shall take all appropriate provisional measures to prohibit or restrict the AI system’s being made available on its national market or put into service, to withdraw the product or the standalone AI system from that market or to recall it. That authority shall without undue delay notify the Commission and the other Member States of those measures.\n\n6. The notification referred to in paragraph 5 shall include all available details, in particular the information necessary for the identification of the non-compliant AI system, the origin of the AI system and the supply chain, the nature of the non-compliance alleged and the risk involved, the nature and duration of the national measures taken and the arguments put forward by the relevant operator. In particular, the market surveillance authorities shall indicate whether the non-compliance is due to one or more of the following:\n(a) non-compliance with the prohibition of the AI practices referred to in Article 5;\n(b) a failure of a high-risk AI system to meet requirements set out in Chapter III, Section 2;\n(c) shortcomings in the harmonised standards or common specifications referred to in Articles 40 and 41 conferring a presumption of conformity;\n(d) non-compliance with Article 50.\n\n7. The market surveillance authorities other than the market surveillance authority of the Member State initiating the procedure shall, without undue delay, inform the Commission and the other Member States of any measures adopted and of any additional information at their disposal relating to the non-compliance of the AI system concerned, and, in the event of disagreement with the notified national measure, of their objections.\n\n8. Where, within three months of receipt of the notification referred to in paragraph 5 of this Article, no objection has been raised by either a market surveillance authority of a Member State or by the Commission in respect of a provisional measure taken by a market surveillance authority of another Member State, that measure shall be deemed justified. This shall be without prejudice to the procedural rights of the concerned operator in accordance with Article 18 of Regulation (EU) 2019/1020. The three-month period referred to in this paragraph shall be reduced to 30 days in the event of non-compliance with the prohibition of the AI practices referred to in Article 5 of this Regulation.\n\n9. The market surveillance authorities shall ensure that appropriate restrictive measures are taken in respect of the product or the AI system concerned, such as withdrawal of the product or the AI system from their market, without undue delay.", article: 79, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79"};
MERGE (n:Provision {id: "art_79__para_1"})
  SET n += {eid: "art_79__para_1", citation: "Art. 79(1)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_1", chunk_type: "paragraph", level: "para", text: "AI systems presenting a risk shall be understood as a “product presenting a risk” as defined in Article 3, point 19 of Regulation (EU) 2019/1020, in so far as they present risks to the health or safety, or to fundamental rights, of persons.", article: 79, paragraph: 1, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(1)"};
MERGE (n:Provision {id: "art_79__para_2"})
  SET n += {eid: "art_79__para_2", citation: "Art. 79(2)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_2", chunk_type: "paragraph", level: "para", text: "Where the market surveillance authority of a Member State has sufficient reason to consider an AI system to present a risk as referred to in paragraph 1 of this Article, it shall carry out an evaluation of the AI system concerned in respect of its compliance with all the requirements and obligations laid down in this Regulation. Particular attention shall be given to AI systems presenting a risk to vulnerable groups. Where risks to fundamental rights are identified, the market surveillance authority shall also inform and fully cooperate with the relevant national public authorities or bodies referred to in Article 77(1). The relevant operators shall cooperate as necessary with the market surveillance authority and with the other national public authorities or bodies referred to in Article 77(1). Where, in the course of that evaluation, the market surveillance authority or, where applicable the market surveillance authority in cooperation with the national public authority referred to in Article 77(1), finds that the AI system does not comply with the requirements and obligations laid down in this Regulation, it shall without undue delay require the relevant operator to take all appropriate corrective actions to bring the AI system into compliance, to withdraw the AI system from the market, or to recall it within a period the market surveillance authority may prescribe, and in any event within the shorter of 15 working days, or as provided for in the relevant Union harmonisation legislation. The market surveillance authority shall inform the relevant notified body accordingly. Article 18 of Regulation (EU) 2019/1020 shall apply to the measures referred to in the second subparagraph of this paragraph.", article: 79, paragraph: 2, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(2)"};
MERGE (n:Provision {id: "art_79__para_3"})
  SET n += {eid: "art_79__para_3", citation: "Art. 79(3)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_3", chunk_type: "paragraph", level: "para", text: "Where the market surveillance authority considers that the non-compliance is not restricted to its national territory, it shall inform the Commission and the other Member States without undue delay of the results of the evaluation and of the actions which it has required the operator to take.", article: 79, paragraph: 3, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(3)"};
MERGE (n:Provision {id: "art_79__para_4"})
  SET n += {eid: "art_79__para_4", citation: "Art. 79(4)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_4", chunk_type: "paragraph", level: "para", text: "The operator shall ensure that all appropriate corrective action is taken in respect of all the AI systems concerned that it has made available on the Union market.", article: 79, paragraph: 4, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(4)"};
MERGE (n:Provision {id: "art_79__para_5"})
  SET n += {eid: "art_79__para_5", citation: "Art. 79(5)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_5", chunk_type: "paragraph", level: "para", text: "Where the operator of an AI system does not take adequate corrective action within the period referred to in paragraph 2, the market surveillance authority shall take all appropriate provisional measures to prohibit or restrict the AI system’s being made available on its national market or put into service, to withdraw the product or the standalone AI system from that market or to recall it. That authority shall without undue delay notify the Commission and the other Member States of those measures.", article: 79, paragraph: 5, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(5)"};
MERGE (n:Provision {id: "art_79__para_6"})
  SET n += {eid: "art_79__para_6", citation: "Art. 79(6)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_6", chunk_type: "paragraph", level: "para", text: "The notification referred to in paragraph 5 shall include all available details, in particular the information necessary for the identification of the non-compliant AI system, the origin of the AI system and the supply chain, the nature of the non-compliance alleged and the risk involved, the nature and duration of the national measures taken and the arguments put forward by the relevant operator. In particular, the market surveillance authorities shall indicate whether the non-compliance is due to one or more of the following:\n(a) non-compliance with the prohibition of the AI practices referred to in Article 5;\n(b) a failure of a high-risk AI system to meet requirements set out in Chapter III, Section 2;\n(c) shortcomings in the harmonised standards or common specifications referred to in Articles 40 and 41 conferring a presumption of conformity;\n(d) non-compliance with Article 50.", article: 79, paragraph: 6, chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(6)"};
MERGE (n:Provision {id: "art_79__para_6__point_a"})
  SET n += {eid: "art_79__para_6__point_a", citation: "Art. 79(6)(a)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_6__point_a", chunk_type: "point", level: "point", text: "non-compliance with the prohibition of the AI practices referred to in Article 5", article: 79, paragraph: 6, point: "a", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(6)(a)"};
MERGE (n:Provision {id: "art_79__para_6__point_b"})
  SET n += {eid: "art_79__para_6__point_b", citation: "Art. 79(6)(b)", eli_uri: "https://eur-lex.europa.eu/eli/reg/2024/1689/oj#art_79__para_6__point_b", chunk_type: "point", level: "point", text: "a failure of a high-risk AI system to meet requirements set out in Chapter III, Section 2", article: 79, paragraph: 6, point: "b", chapter: 9, section: "3", celex: "32024R1689", lang: "en", effective_from: "2026-08-02", name: "Art. 79(6)(b)"};
