{
  "tools": [
    {
      "name": "codexai_regenold_eu_ai_act_ask",
      "description": "Ask a grounded EU AI Act question (CodexAI partner endpoint for Regenold). Returns answer + chapter/article/annex citations.",
      "input_schema": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant", "system"] },
                "content": { "type": "string" }
              },
              "required": ["role", "content"]
            }
          }
        },
        "required": ["messages"]
      }
    }
  ]
}

