# Partner API key (optional — anonymous tier works without one).
# When set, callers sending matching X-Regenold-Api-Key header get the
# privileged 60/min rate-limit bucket instead of the anonymous 30/min bucket.
P2P_REGENOLD_API_KEY=

# LLM provider for the graph-RAG engine.
# Auto-default: falls back to Anthropic when unset.
# Explicit values: anthropic / cli / openai_wrapper / bedrock / auto
P2P_GRAPH_RAG_PROVIDER=openai_wrapper

# ── AWS Bedrock (P2P_GRAPH_RAG_PROVIDER=bedrock) ────────────────────────────
# EU cross-region inference, for EU data residency. Everything below is also a
# CODE default (app/llm/bedrock_client.py, app/engines/_graph_rag_impl.py), so
# a Railway deploy needs only the credential — railway.toml [deploy.envs] has
# never applied, and config that must survive a deploy lives in code.
#
# ⚠ Region and model geography are ONE decision. An `eu.` inference profile is
# unresolvable outside the EU geography: calling it from us-east-1 returns
# `ValidationException: The provided model identifier is invalid`, which reads
# like a bad model name and is really a bad Region.
BEDROCK_REGION=eu-central-1

# Credential — a Bedrock API key (bearer), OR standard AWS_ACCESS_KEY_ID +
# AWS_SECRET_ACCESS_KEY, OR the default chain (IAM role / instance profile).
AWS_BEARER_TOKEN_BEDROCK=

# Model targets. Verified ACTIVE in eu-central-1 on 2026-08-11 via
# list_inference_profiles(typeEquals='SYSTEM_DEFINED').
# ⚠ Listed-and-ACTIVE is NOT invocable: per-model ACCOUNT entitlement is
# separate and shows up only at invoke time as
# `AccessDeniedException: <model> is not available for this account`.
REGENOLD_BEDROCK_MODEL=eu.anthropic.claude-opus-4-8
REGENOLD_BEDROCK_COMPLEX_MODEL=eu.anthropic.claude-opus-5
REGENOLD_BEDROCK_JUDGE_MODEL=eu.anthropic.claude-sonnet-5

# Judge output budget. NOT the wrapper path's 400: Bedrock honours the system
# prompt (the Claude Max wrapper drops it), so the judge reasons in prose
# before its JSON — at 400 tokens it truncates and the axis comes back
# `no_json`, i.e. SILENTLY UNSCORED rather than visibly failed.
REGENOLD_BEDROCK_JUDGE_MAX_TOKENS=1600

# (Optional) If you have a direct Anthropic API key and set P2P_GRAPH_RAG_PROVIDER=anthropic
# Anthropic path (https://console.anthropic.com/)
P2P_GRAPH_RAG_API_KEY=

# OpenAI-compatible endpoint provider — wraps any OpenAI Chat Completions
# facade (OpenAI, OpenRouter, the local claude-code-openai-wrapper).
# Activate with P2P_GRAPH_RAG_PROVIDER=openai_wrapper. See
# docs/partners/regenold/SONNET_WRAPPER.md for the Sonnet-via-Claude-Max flow.
OPENAI_API_BASE=
OPENAI_API_KEY=
# OPENAI_TIMEOUT_SECONDS=8
# Cap on Retry-After we'll honour after a 429 — anything above the cap
# falls straight through to deterministic. Default 8 seconds.
# OPENAI_MAX_RETRY_AFTER=8

# Stage-0 intent classifier model (runs via the openai_wrapper).
# Defaults to Claude Haiku 4.5 — fast/cheap. Flip to claude-sonnet-4-6
# for higher-quality intent narrowing at higher latency.
# REGENOLD_INTENT_MODEL=claude-haiku-4-5-20251001

# Stage-1 parse / Stage-2 polish model. Defaults to Claude Sonnet 4.6.
# Reads through the openai_wrapper when P2P_GRAPH_RAG_PROVIDER=openai_wrapper.
# P2P_GRAPH_RAG_MODEL=claude-sonnet-4-6

# Reverse-proxy trust — set to "true" ONLY when the bundle is deployed
# behind a proxy that overwrites (not appends) X-Forwarded-For. When false
# (default), the anonymous tier rate-limits on the direct socket address.
# Trusting XFF without a proxy that overwrites = trivial rate-limit bypass.
REGENOLD_TRUST_PROXY=false

# In-memory audit-chain cap (this bundle ships a stub store — see
# app/evidence/store.py). The default 10000-row deque caps memory in a
# long-running uvicorn process; oldest entries fall off the back when full.
REGENOLD_AUDIT_CAP=10000

# Verbose engine logging
LOG_LEVEL=INFO

# ─── Neo4j graph (optional Layer-1 path) ──────────────────────────────
# When NEO4J_URI is set the engine queries the graph for multi-hop
# reasoning. The deterministic KB-fallback path still serves requests
# when the graph is unreachable — Neo4j is strictly additive.
# NEO4J_URI=neo4j+s://<aura-id>.databases.neo4j.io
# NEO4J_USER=neo4j          # NEO4J_USERNAME is also accepted
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ⚠⚠ SEED SAFETY — READ BEFORE POINTING THIS REPO AT A SHARED AURA ⚠⚠
#
# THIS REPO MUST NEVER WRITE TO THE SHARED AURA INSTANCE. Set:
#
#     NEO4J_AUTO_SEED=0
#
# Why (measured 2026-08-09, R325). The boot hook compares the live
# KBMetadata.seed_version against the in-process SEED_VERSION and re-seeds
# on ANY mismatch — it does not check which is newer. This repo ships
#
#     scripts/seed_neo4j_kb.py  SEED_VERSION = 2026-07-24-r291-fullseed
#
# while the shared Aura instance (0644b854) is seeded
#
#     2026-08-08-r323-annex-sections   1758 nodes / 1979 edges
#
# by the sibling `regenold-eu-ai-act-rag` repo, which production uses. So
# booting this repo with auto-seed ON would silently DOWNGRADE that graph to
# an older payload — losing the section-aware annex items and the SubPoint
# layer — and the failure is invisible: the seeder succeeds, /healthz/graph
# still reports ok, and answers just quietly get worse.
#
# The eval harnesses read the graph and never need to write it. Leave this at
# 0 unless you have deliberately re-seeded and bumped SEED_VERSION yourself.
NEO4J_AUTO_SEED=0

# Multi-worker leader election. When uvicorn runs with --workers N>1
# only worker index 0 should fire the auto-seed. The default is to
# coordinate via a Postgres advisory lock (when DATABASE_URL is set);
# operators who run a custom worker model can set this per-worker.
# REGENOLD_AUTO_SEED_LEADER_ONLY=1
# REGENOLD_WORKER_INDEX=

# Enable the Round-31.1 GraphRAG 2-hop expand path. Default ON in
# production (set in railway.toml). Flip off with
# REGENOLD_GRAPH_2HOP=0 if a future regression points at it.
# REGENOLD_GRAPH_2HOP=1
