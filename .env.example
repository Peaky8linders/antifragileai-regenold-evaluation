# Partner API key (optional — anonymous tier works without one).
# When set, callers sending matching X-Regenold-Api-Key header get the
# privileged 60/min rate-limit bucket instead of the anonymous 30/min bucket.
P2P_REGENOLD_API_KEY=

# LLM provider for the graph-RAG engine.
# Auto-default: picks Mistral when MISTRAL_API_KEY is set, else falls back to Anthropic.
# Explicit values: mistral / anthropic / cli
P2P_GRAPH_RAG_PROVIDER=

# Mistral path (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Anthropic path (https://console.anthropic.com/)
# OR proxied through the claude-code-openai-wrapper for Claude Max subscription
P2P_GRAPH_RAG_API_KEY=

# Claude Code OpenAI Wrapper (when using Claude Max subscription via the local proxy)
# OPENAI_API_BASE=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=dummy

# Verbose engine logging
LOG_LEVEL=INFO
